HOTARU = {
    "id": "translations",
    "version": "1.1.0",
    "commands": ["lang", "language"],
    "capabilities": []
}

from typing import Any


NATIVE_LABELS = {
    "ru": "Русский",
    "en": "English",
    "kz": "Қазақша",
    "uk": "Українська",
    "ja": "日本語"
}


def _escape(value: Any) -> Any:
    import html
    return html.escape(str(value), quote=False)


def _screen(ctx: Any) -> Any:
    runtime = ctx.runtime
    current = runtime.language()

    async def select(callback: Any, payload: Any) -> Any:
        selected = payload.get("language") if isinstance(payload, dict) else None
        runtime.set_language(selected)
        screen = _screen(ctx)
        await ctx.respond(
            screen["text"],
            buttons=screen["buttons"],
            callback=callback,
            parse_mode="HTML",
        )

    buttons = []
    for language in ("ru", "en", "kz", "uk", "ja"):
        marker = "✓ " if language == current else ""
        buttons.append(
            ctx.ui.button(
                f"{marker}{NATIVE_LABELS[language]}",
                select,
                {"language": language},
            )
        )
    rows = ctx.ui.grid(*buttons, columns=2)
    rows.append([ctx.ui.close(ctx.t("common.close", "Close"))])
    return {
        "text": f"<b>{ctx.t('commands.lang.description', 'Language')}</b>\n<i>Current: {_escape(current)}</i>",
        "buttons": rows,
    }


async def _show(ctx: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("Runtime unavailable")
        return
    if not runtime.lexicon:
        await ctx.respond("Translation lexicon unavailable")
        return
    if not runtime.lexicon.available_languages():
        await ctx.respond("Translation languages unavailable")
        return
    if not runtime.lexicon._validate_language(runtime.language()):
        runtime.set_language("en")
    screen = _screen(ctx)
    await ctx.respond(
        screen["text"],
        buttons=screen["buttons"],
        inline=True,
        parse_mode="HTML",
    )


async def command_lang(ctx: Any, invocation: Any) -> Any:
    if len(invocation.args) > 1:
        await ctx.respond(ctx.t("commands.lang.usage", "Usage: {prefix}lang [language]", prefix=ctx.runtime.config.prefix))
        return
    if len(invocation.args) == 1:
        try:
            ctx.runtime.set_language(invocation.args[0])
        except Exception:
            await ctx.respond(ctx.t("commands.lang.invalid", "Unsupported language: {language}", language=invocation.args[0]))
            return
    await _show(ctx)


async def command_language(ctx: Any, invocation: Any) -> Any:
    await command_lang(ctx, invocation)
