HOTARU = {
    "id": "translations",
    "version": "2.1.0",
    "commands": ["language", "translate", "loadlex"],
    "capabilities": ["mt", "net", "files", "state"],
}

import html
import json
import logging
import re
import tempfile
import urllib.request
from pathlib import Path
from typing import Any, Callable, List

log = logging.getLogger(__name__)

LANGUAGES = ("ru", "en", "kz", "uk", "ja", "zh")

NATIVE_NAMES = {
    "ru": "Русский",
    "en": "English",
    "kz": "Қазақша",
    "kk": "Қазақша",
    "uk": "Українська",
    "ja": "日本語",
    "zh": "中文",
}


def _escape(value: Any) -> Any:
    return html.escape(str(value), quote=False)


def home(ctx: Any, nav: Any = None) -> Any:
    k = ctx.screens
    current = ctx.runtime.language()
    langs = ctx.runtime.lexicon.available_languages() if getattr(ctx.runtime, "lexicon", None) is not None else LANGUAGES
    options = [
        k.button(k.radio(NATIVE_NAMES.get(language, language.upper()), language == current), select, style="success" if language == current else None, language=language)
        for language in langs
    ]
    rows = k.grid(options, 2)
    rows.append(k.footer())
    current_label = NATIVE_NAMES.get(current, current.upper())
    text = (
        f'{k.wordmark()}  <b>// Language</b>\n'
        f'<tg-emoji emoji-id="5260512129240276089">📚</tg-emoji> <b>{_escape(current_label)}</b> · <code>{_escape(current)}</code>'
    )
    return k.screen(text, rows, banner=k.banner("translations"), rich=True)


def select(ctx: Any, nav: Any) -> Any:
    language = str(nav.arg("language"))
    if language != ctx.runtime.language():
        ctx.runtime.set_language(language)
    screen = home(ctx)
    name = NATIVE_NAMES.get(language, language.upper())
    screen.toast = f"✅ {name}"
    return screen


async def _show(ctx: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('commands.lang.unavailable'))
        return
    if not runtime.lexicon:
        await ctx.respond(ctx.t('commands.lang.lexicon_unavailable'))
        return
    if not runtime.lexicon.available_languages():
        await ctx.respond(ctx.t('commands.lang.languages_unavailable'))
        return
    if not runtime.lexicon._validate_language(runtime.language()):
        runtime.set_language("en")
    await ctx.screens.show(home(ctx))


async def command_language(ctx: Any, invocation: Any) -> Any:
    if len(invocation.args) > 1:
        await ctx.respond(ctx.t('commands.lang.usage', prefix=ctx.runtime.config.prefix))
        return
    if len(invocation.args) == 1:
        code_input = invocation.args[0].lower().strip()
        try:
            ctx.runtime.set_language(code_input)
            native = NATIVE_NAMES.get(code_input, code_input.upper())
            await ctx.respond(
                f'<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji> <b>{_escape(native)}</b> (<code>{_escape(code_input)}</code>)',
                parse_mode="HTML",
            )
            return
        except Exception:
            language_key: Callable[[str], List[str]] = lambda code: [code, ctx.t('kernel.translations.native.' + code, code)]
            langs = list(ctx.runtime.lexicon.available_languages()) if getattr(ctx.runtime, "lexicon", None) is not None else list(LANGUAGES)
            matches = await ctx.tools.search(langs, code_input, key=language_key, limit=5)
            text = _escape(ctx.t('commands.lang.invalid', language=code_input))
            for hit in matches:
                code = hit['value']
                text += f"\n<code>{_escape(ctx.runtime.config.prefix)}language {code}</code> · {_escape(ctx.t('kernel.translations.native.' + code, code))}"
            await ctx.respond(text, parse_mode="HTML")
            return
    await _show(ctx)


async def _extract_reply_source(ctx: Any, invocation: Any) -> Any:
    reply = getattr(invocation, "reply_message", None)
    if reply is None and hasattr(invocation, "reply") and callable(invocation.reply):
        try:
            reply = await invocation.reply()
        except Exception:
            reply = None
    if reply is None and getattr(invocation, "message", None) is not None:
        msg = invocation.message
        reply = getattr(msg, "reply_to_message", None) or (msg.get("reply_to_message") if isinstance(msg, dict) else None)
    from hotaru.response import reply_message_id
    rid = reply_message_id(getattr(invocation, "message", None))
    if reply is None and rid is not None and getattr(invocation, "chat_id", None) and callable(getattr(ctx, "msg", None)):
        try:
            reply = await ctx.msg(invocation.chat_id, rid)
        except Exception:
            reply = None
    if callable(reply):
        reply = None
    return reply


async def command_translate(ctx: Any, invocation: Any) -> Any:
    args = list(invocation.args or [])
    to_lang = None
    target_text = None

    if args and re.fullmatch(r"[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8})*", args[0]):
        if len(args) > 1:
            to_lang = args[0].lower()
            target_text = " ".join(args[1:])
        else:
            to_lang = args[0].lower()
    elif args:
        target_text = " ".join(args)

    if to_lang is None:
        to_lang = ctx.runtime.language() if getattr(ctx, "runtime", None) is not None else "en"

    reply = await _extract_reply_source(ctx, invocation)
    source_msg = reply if reply is not None else getattr(invocation, "message", None)
    if callable(source_msg):
        source_msg = None
    if callable(source_msg):
        source_msg = None

    if not target_text and source_msg is not None:
        doc = getattr(source_msg, "document", None) or (source_msg.get("document") if isinstance(source_msg, dict) else None)
        if doc is None and getattr(source_msg, "media", None):
            media = getattr(source_msg, "media")
            doc = getattr(media, "document", None) or (media.get("document") if isinstance(media, dict) else None)
        if doc is not None and getattr(ctx.runtime, "_download_module_message", None) is not None:
            with tempfile.NamedTemporaryFile(suffix=".txt", delete=False) as handle:
                tmp_path = Path(handle.name)
            try:
                await ctx.runtime._download_module_message(source_msg, tmp_path)
                target_text = tmp_path.read_text(encoding="utf-8", errors="replace")
            except Exception as exc:
                log.error("translate file fetch failed: %s", exc)
            finally:
                tmp_path.unlink(missing_ok=True)

    if not target_text and reply is not None:
        target_text = ctx.tools.message_text(reply) if hasattr(ctx, "tools") else None
        if not target_text:
            for attr in ("text", "caption", "message", "raw_text"):
                val = getattr(reply, attr, None) or (reply.get(attr) if isinstance(reply, dict) else None)
                if isinstance(val, dict):
                    val = val.get("text") or val.get("message")
                if isinstance(val, str) and val.strip():
                    target_text = val
                    break

    if not target_text and getattr(invocation, "message", None) is not None and not callable(invocation.message):
        target_text = getattr(invocation.message, "caption", None)
        if isinstance(target_text, dict):
            target_text = target_text.get("text", "")

    if not target_text:
        await ctx.respond(f'<tg-emoji emoji-id="5778527486270770928">❌</tg-emoji> <b>{_escape(ctx.t("kernel.translations.no_text", "Текст для перевода не указан"))}</b>', parse_mode="HTML")
        return

    try:
        translated = await ctx.translate(target_text, to_lang=to_lang)
    except Exception as exc:
        log.error("translation error: %s", exc, exc_info=True)
        raw_err = str(exc)
        if "requires non-empty text" in raw_err:
            msg = "Текст для перевода пуст"
        elif "exceeds" in raw_err:
            msg = "Текст слишком большой для одного запроса"
        else:
            msg = f"Не удалось перевести текст ({raw_err})"
        await ctx.respond(f'<tg-emoji emoji-id="5778527486270770928">❌</tg-emoji> <b>Ошибка перевода:</b>\n<blockquote>{html.escape(msg, quote=False)}</blockquote>', parse_mode="HTML")
        return

    from relay.toolkit import escape_smart
    formatted = escape_smart(translated)
    expandable = " expandable" if (len(formatted) > 200 or "\n" in formatted) else ""
    res = f'<tg-emoji emoji-id="5260512129240276089">📚</tg-emoji> <b>{to_lang.upper()}</b>:\n<blockquote{expandable}>{formatted}</blockquote>'
    await ctx.paginate(res)


async def command_loadlex(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.kernel.runtime_unavailable'))
        return

    reply = await _extract_reply_source(ctx, invocation)
    source_msg = reply if reply is not None else getattr(invocation, "message", None)
    if callable(source_msg):
        source_msg = None
    doc = None
    if source_msg is not None:
        doc = getattr(source_msg, "document", None) or getattr(source_msg, "media", None)
    msg_text = str(getattr(source_msg, "text", "") or "").strip()
    if not invocation.args and doc is None and not (msg_text.startswith("{") and msg_text.endswith("}")):
        await ctx.respond(f'<tg-emoji emoji-id="5778527486270770928">❌</tg-emoji> <b>Укажите ссылку, путь или сделайте реплай на файл (.json)</b>', parse_mode="HTML")
        return

    temporary = None
    log_lines = ["-----> Fetching lexicon pack..."]
    await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML")

    try:
        source = None
        code_override = None
        if invocation.args:
            arg = str(invocation.args[0]).strip()
            if arg.startswith("https://") or arg.startswith("http://"):
                req = urllib.request.Request(arg, headers={"User-Agent": "Hotaru/1.0"})
                with urllib.request.urlopen(req, timeout=10) as resp:
                    source = resp.read().decode("utf-8")
                code_override = Path(arg.split("?")[0]).stem.lower()
            elif Path(arg).is_file():
                source = Path(arg).read_text(encoding="utf-8")
                code_override = Path(arg).stem.lower()
            elif arg.startswith("{") and arg.endswith("}"):
                source = arg

        if source is None:
            if source_msg is None:
                await ctx.respond("<pre> !     Error: reply to a JSON file or provide a url</pre>", parse_mode="HTML", output="edit")
                return

            reply_text = str(getattr(source_msg, "text", "") or "").strip()
            if reply_text.startswith("{") and reply_text.endswith("}"):
                source = reply_text
            else:
                with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as handle:
                    temporary = Path(handle.name)
                await runtime._download_module_message(source_msg, temporary)
                source = temporary.read_text(encoding="utf-8")
                doc_obj = getattr(source_msg, "document", None) or (source_msg.get("document") if isinstance(source_msg, dict) else None)
                if doc_obj:
                    file_name = getattr(doc_obj, "file_name", None) or (doc_obj.get("file_name") if isinstance(doc_obj, dict) else None)
                    if file_name and str(file_name).endswith(".json"):
                        code_override = Path(str(file_name)).stem.lower()

        log_lines[-1] += " done"
        log_lines.append("-----> Validating lexicon format...")
        await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML", output="edit")

        data = json.loads(source)
        if not isinstance(data, dict):
            raise ValueError("Lexicon root must be a JSON object")

        meta = data.get("meta") if isinstance(data.get("meta"), dict) else {}
        code = str(meta.get("code") or meta.get("language") or code_override or "custom").strip().lower()
        name = str(meta.get("name") or code.upper())
        if not re.fullmatch(r"[a-z]{2,8}(?:-[a-z0-9]{2,8})*", code):
            code = "custom"

        data["meta"] = {**meta, "language": code, "name": name}
        lex_dir = getattr(runtime, "lexicon_dir", Path("lexicon"))
        lex_dir.mkdir(parents=True, exist_ok=True)
        target = lex_dir / f"{code}.json"
        target.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")

        if runtime.lexicon is not None:
            runtime.lexicon._cache.clear()

        runtime.set_language(code)
        log_lines[-1] += " done"
        log_lines.append(f"-----> Loaded language pack: {name} [{code}]")
        await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML", output="edit")
    except Exception as exc:
        if runtime.observatory is not None:
            runtime.observatory.emit("lexicon", "load_error", error=exc)
        log.error("lexicon load error: %s", exc, exc_info=True)
        err_raw = str(exc)
        if "file_missing" in err_raw or "not found" in err_raw.lower() or "не найден" in err_raw:
            err_msg = "Файл словаря не найден: прикрепите .json или сделайте реплай"
        elif "file_document" in err_raw or "должно содержать" in err_raw:
            err_msg = "Сообщение должно содержать JSON-файл (.json)"
        elif isinstance(exc, json.JSONDecodeError):
            err_msg = f"Некорректный синтаксис JSON: {exc.msg} (строка {exc.lineno})"
        elif isinstance(exc, (ValueError, TypeError)):
            err_msg = f"Ошибка структуры словаря: {err_raw}"
        else:
            err_msg = f"Не удалось загрузить словарь: {err_raw}"
        log_lines.append(f" !     {html.escape(err_msg, quote=False)}")
        await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML", output="edit")
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


command_lang = command_language
command_tr = command_translate
command_ldlex = command_loadlex
command_lexicon = command_loadlex
