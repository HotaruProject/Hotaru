HOTARU = {
    "id": "singularity",
    "version": "2.0.1",
    "commands": ["dash"],
    "capabilities": ["mt"],
}

from typing import Any

from singularity.relay import get_sanctuary_app_state, resolve_inline_banner_url


def _tr(ctx: Any, key: str, fallback: str, **kwargs: Any) -> str:
    try:
        val = ctx.t(key, **kwargs)
        if isinstance(val, str) and val and val != key:
            return val
    except Exception:
        pass
    return fallback.format(**kwargs) if kwargs else fallback


async def command_dash(ctx: Any, invocation: Any) -> None:
    runtime = ctx.runtime
    ready_info: dict[str, Any] = {}
    if hasattr(runtime, "sync_web_app"):
        ready_info = await runtime.sync_web_app() or {}
    else:
        svc = getattr(runtime, "singularity", None)
        if svc is None and hasattr(runtime, "_start_singularity"):
            await runtime._start_singularity()
            svc = getattr(runtime, "singularity", None)
        if svc is not None and hasattr(svc, "ensure_ready"):
            ready_info = await svc.ensure_ready()
    svc = getattr(runtime, "singularity", None)

    state = getattr(runtime, "state", None)
    db_state = get_sanctuary_app_state(state)

    bot_user = (
        str(ready_info.get("bot_username") or "")
        or db_state.bot_username
        or (str(state.get_setting("inline-bot-username") or "") if state is not None and hasattr(state, "get_setting") else "")
    ).lstrip("@").strip()

    short_slug = (
        str(ready_info.get("short_name") or "")
        or db_state.short_name
        or (svc.config.short_name if svc is not None else "dashboard")
    ).strip()

    app_link = (
        str(ready_info.get("app_link") or "")
        or db_state.app_link
        or (svc.webapp_link if svc is not None and svc.webapp_link else "")
        or (f"https://t.me/{bot_user}/{short_slug}" if bot_user else "")
    ).strip()

    tunnel_url = (
        str(ready_info.get("tunnel_url") or "")
        or (svc.tunnel_url if svc is not None and svc.tunnel_url else "")
        or db_state.last_tunnel_url
    ).strip()

    probe_online = bool(ready_info.get("running") if ready_info else (svc is not None and svc.is_running))
    registered = bool(ready_info.get("registered") if ready_info else (db_state.registered or (svc is not None and svc.webapp_registered)))

    status_tag = "ONLINE" if probe_online else "STANDBY"
    sync_tag = "SYNCED" if registered else "PENDING"
    status_emoji = '<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji>' if probe_online else '<tg-emoji emoji-id="5778527486270770928">❌</tg-emoji>'
    sync_emoji = '<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji>' if registered else '<tg-emoji emoji-id="5778527486270770928">❌</tg-emoji>'

    header = _tr(ctx, "kernel.singularity.card_title", '<tg-emoji emoji-id="5985527717183888277">⚡</tg-emoji><tg-emoji emoji-id="5985515480822061758">⚡</tg-emoji><tg-emoji emoji-id="5985558606588681366">⚡</tg-emoji><tg-emoji emoji-id="5985757321840565902">⚡</tg-emoji> <b>// Singularity</b>')
    probe_label = _tr(ctx, "kernel.singularity.probe", "Probe")
    relay_label = _tr(ctx, "kernel.singularity.relay", "Relay")
    lines = [
        header,
        "<blockquote>"
        f'<tg-emoji emoji-id="5258152182150077732">⚡️</tg-emoji> <b>{probe_label}:</b> {status_emoji} <code>{status_tag}</code><br>'
        f'<tg-emoji emoji-id="5260730055880876557">⛓</tg-emoji> <b>{relay_label}:</b> {sync_emoji} <code>{sync_tag}</code>'
        "</blockquote>",
    ]
    text = "\n".join(lines)

    open_label = _tr(ctx, "kernel.singularity.open_button", "Open Singularity")
    close_label = _tr(ctx, "common.close", "Close")

    launch_url = app_link or tunnel_url
    buttons: list[list[dict[str, Any]]] = []
    if launch_url:
        buttons.append([{"text": f"⚡ {open_label}", "url": launch_url, "style": "primary"}])

    if hasattr(ctx, "ui") and hasattr(ctx.ui, "close"):
        buttons.append([ctx.ui.close(close_label)])

    banner_url = ready_info.get("banner_url")
    if not banner_url:
        banner_url = await resolve_inline_banner_url(tunnel_url or None)
    if not banner_url:
        banner_url = "https://raw.githubusercontent.com/HotaruProject/Hotaru/develop/singularity/assets/WebApp.jpg"

    if buttons and hasattr(ctx, "form"):
        if isinstance(banner_url, str) and banner_url.startswith("https://"):
            try:
                await ctx.form(text, buttons, module_id="singularity", photo=banner_url, rich=True)
                return
            except Exception:
                pass
        try:
            await ctx.form(text, buttons, module_id="singularity", rich=True)
            return
        except Exception:
            pass

    if buttons and hasattr(ctx, "answer"):
        await ctx.answer(text, rows=buttons, parse_mode="HTML", rich=True)
    else:
        await ctx.respond(text, photo=banner_url, parse_mode="HTML", rich=True)
