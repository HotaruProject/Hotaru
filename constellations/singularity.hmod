HOTARU = {
    "id": "singularity",
    "version": "2.0.1",
    "commands": ["dash"],
    "capabilities": ["mt"],
    "banner": "https://raw.githubusercontent.com/HotaruProject/Hotaru/develop/hotaru/assets/singularity.mp4",
}

from typing import Any

from singularity.relay import resolve_inline_banner_url


def _tr(ctx: Any, key: str, fallback: str, **kwargs: Any) -> str:
    try:
        val = ctx.t(key, **kwargs)
        if isinstance(val, str) and val and val != key:
            return val
    except Exception:
        pass
    return fallback.format(**kwargs) if kwargs else fallback


async def command_dash(ctx: Any, invocation: Any) -> None:
    runtime = ctx.runtime
    ready_info: dict[str, Any] = {}
    if hasattr(runtime, "sync_web_app"):
        ready_info = await runtime.sync_web_app() or {}
    else:
        svc = getattr(runtime, "singularity", None)
        if svc is None and hasattr(runtime, "_start_singularity"):
            await runtime._start_singularity()
            svc = getattr(runtime, "singularity", None)
        if svc is not None and hasattr(svc, "ensure_ready"):
            ready_info = await svc.ensure_ready()
    svc = getattr(runtime, "singularity", None)

    app_link = str(ready_info.get("app_link") or "").strip()
    tunnel_url = str(ready_info.get("tunnel_url") or "").strip()

    probe_online = bool(ready_info.get("running") if ready_info else (svc is not None and svc.is_running))
    registered = bool(ready_info.get("registered") if ready_info else (svc is not None and svc.webapp_registered))

    status_tag = "ONLINE" if probe_online else "STANDBY"
    sync_tag = "SYNCED" if registered else "PENDING"
    status_emoji = '<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji>' if probe_online else '<tg-emoji emoji-id="5260342697075416641">❌</tg-emoji>'
    sync_emoji = '<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji>' if registered else '<tg-emoji emoji-id="5260342697075416641">❌</tg-emoji>'

    header = _tr(ctx, "kernel.singularity.card_title", "{wordmark} <b>// Singularity</b>", wordmark=ctx.screens.wordmark())
    probe_label = _tr(ctx, "kernel.singularity.probe", "Probe")
    relay_label = _tr(ctx, "kernel.singularity.relay", "Relay")
    lines = [
        header,
        "<blockquote>"
        f'<tg-emoji emoji-id="5258152182150077732">⚡️</tg-emoji> <b>{probe_label}:</b> {status_emoji} <code>{status_tag}</code><br>'
        f'<tg-emoji emoji-id="5260730055880876557">⛓</tg-emoji> <b>{relay_label}:</b> {sync_emoji} <code>{sync_tag}</code>'
        "</blockquote>",
    ]
    text = "\n".join(lines)

    open_label = _tr(ctx, "kernel.singularity.open_button", "Open Singularity")

    launch_url = app_link
    k = ctx.screens
    buttons: list[list[dict[str, Any]]] = []
    if launch_url and probe_online:
        buttons.append([k.url(open_label, launch_url, style="primary")])
    buttons.append([k.close()])

    banner_url = ready_info.get("banner_url")
    if not banner_url:
        banner_url = await resolve_inline_banner_url(tunnel_url or None)
    if not banner_url:
        banner_url = "https://raw.githubusercontent.com/HotaruProject/Hotaru/develop/singularity/assets/WebApp.jpg"

    await k.show(k.screen(text, buttons, banner=k.banner(banner_url)))
