_ACTIVE_SH: dict[int, Any] = {}
_ACTIVE_PY: dict[int, Any] = {}

_TG_REPLACEMENTS: list[tuple[str, str]] = [
    ("\u00a0", " "),
    ("\u202f", " "),
    ("\u2009", " "),
    ("\u2019", "'"),
    ("\u2018", "'"),
    ("\u201c", '"'),
    ("\u201d", '"'),
    ("\u2013", "-"),
    ("\u2014", "--"),
    ("\u2026", "..."),
    ("\u00b7", "."),
    ("\u2022", "-"),
    ("\ufeff", ""),
    ("\u200b", ""),
    ("\u200c", ""),
    ("\u200d", ""),
]

_TG_MARKDOWN_PATTERNS: list[tuple[re.Pattern, str]] = [
    (re.compile(r"\*([A-Za-z_][A-Za-z0-9_]*)\*"), r"__\1__"),
]


def _unescape_tg_code(code: str) -> str:
    for bad, good in _TG_REPLACEMENTS:
        code = code.replace(bad, good)
    for pattern, replacement in _TG_MARKDOWN_PATTERNS:
        code = pattern.sub(replacement, code)
    return code


_BLOCK_STARTERS = re.compile(
    r"^(if |elif |else:|for |while |def |async def |class |try:|except|finally:|with )"
)


def _fix_indentation(code: str) -> str:
    code = textwrap.dedent(code)
    lines = code.splitlines()
    result: list[str] = []
    indent_next = False
    current_indent = 0

    for line in lines:
        stripped = line.lstrip()
        if not stripped:
            result.append("")
            indent_next = False
            continue

        if indent_next and not line[0].isspace():
            result.append("    " * (current_indent + 1) + stripped)
        else:
            result.append(line)

        ends_block = stripped.rstrip().endswith(":") and bool(_BLOCK_STARTERS.match(stripped))
        if ends_block:
            current_indent = (len(line) - len(stripped)) // 4
        indent_next = ends_block

    return "\n".join(result)


def _sanitise_code(code: str) -> str:
    code = _unescape_tg_code(code)
    code = _fix_indentation(code)
    return code


def _wrap_eval_code(code: str) -> str:
    code = code.strip()
    if not code:
        return "async def __executor_runner__():\n    pass"

    try:
        tree = ast.parse(code, mode="exec")
    except SyntaxError:
        try:
            ast.parse(code, mode="eval")
            return f"async def __executor_runner__():\n    return await _auto_await({code})"
        except SyntaxError:
            pass
        indented = textwrap.indent(code, "    ")
        return f"async def __executor_runner__():\n{indented}"

    if not tree.body:
        return "async def __executor_runner__():\n    pass"

    if (
        len(tree.body) == 1
        and isinstance(tree.body[0], (ast.AsyncFunctionDef, ast.FunctionDef))
    ):
        fname = tree.body[0].name
        indented = textwrap.indent(code, "    ")
        return (
            "async def __executor_runner__():\n"
            f"{indented}\n"
            f"    return await _auto_await({fname}())"
        )

    last = tree.body[-1]

    if not isinstance(last, ast.Expr) or isinstance(last.value, (ast.Yield, ast.YieldFrom)):
        indented = textwrap.indent(code, "    ")
        return f"async def __executor_runner__():\n{indented}"

    last_src = ast.unparse(last.value)

    if len(tree.body) == 1:
        return f"async def __executor_runner__():\n    return await _auto_await({last_src})"

    preceding = ast.Module(body=tree.body[:-1], type_ignores=[])
    head_src = ast.unparse(preceding)
    head = textwrap.indent(head_src, "    ")
    tail = f"    return await _auto_await({last_src})"
    return f"async def __executor_runner__():\n{head}\n{tail}"


async def _auto_await(value: Any) -> Any:
    while asyncio.iscoroutine(value) or asyncio.isfuture(value):
        value = await value
    return value


def _escape(value: str) -> str:
    return html.escape(str(value), quote=False)


def _clean_code(text: str) -> str:
    text = text.strip()
    if text.startswith("```") and text.endswith("```"):
        lines = text.splitlines()
        inner = "\n".join(lines[1:-1]) if len(lines) > 1 else text.strip("`")
        return inner.strip()
    if text.startswith("`") and text.endswith("`") and len(text) > 2:
        return text[1:-1]
    return text


def _truncate(text: str, max_len: int = 3500) -> str:
    if len(text) > max_len:
        return text[:max_len] + f"\n\n... [Cut: {len(text) - max_len} chars]"
    return text


def _censor(ret: str, ctx: Any) -> str:
    runtime = getattr(ctx, "runtime", None)
    if runtime is not None:
        config = getattr(runtime, "config", None)
        if config is not None:
            for key in ("bot_token", "inline_bot_token", "api_hash"):
                try:
                    secret = getattr(config, key, None)
                except Exception:
                    secret = None
                if secret:
                    masked = (
                        f'{str(secret).split(":")[0]}:{"*" * 26}'
                        if ":" in str(secret)
                        else "*" * 26
                    )
                    ret = ret.replace(str(secret), masked)
    return ret


def _tools(ctx: Any) -> Any:
    tools = getattr(ctx, "tools", None)
    if tools is not None and hasattr(tools, "rich_to_html"):
        return tools
    if hasattr(ctx, "runtime") and ctx.runtime is not None:
        runtime_tools = getattr(ctx.runtime, "tools", None)
        if runtime_tools is not None and hasattr(runtime_tools, "rich_to_html"):
            return runtime_tools
    try:
        from relay.toolkit import TOOLS

        return TOOLS
    except Exception:
        return None


class OutputUpdater:
    def __init__(self, ctx: Any, cmd: str, is_py: bool = False):
        self.ctx = ctx
        self.cmd = cmd
        self.is_py = is_py
        self.buffer = ""
        self.last_update = 0.0
        self.msg = None
        self.closed = False
        self.start_time = time.perf_counter()
        self.ansi_re = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')
        self._sending = False
        self._pending = False
        self._lock = asyncio.Lock()
        self._pages: list[str] = []
        self._page = 0

    def _strip_ansi(self, text: str) -> str:
        text = self.ansi_re.sub('', text)
        lines = text.split('\n')
        res = []
        for line in lines:
            parts = line.split('\r')
            valid_parts = [p for p in parts if p]
            if valid_parts:
                res.append(valid_parts[-1])
            elif parts:
                res.append('')
        return '\n'.join(res)

    def _fmt_entry(self, title: str, content: Any, is_code: bool, lang: str | None = None) -> str:
        if is_code and not lang:
            lang = "python" if self.is_py else "shell"
        esc = _escape(_censor(str(content), self.ctx))
        if is_code:
            cls = f' class="language-{_escape(lang)}"' if lang else ""
            return f"<b>{_escape(title)}:</b>\n<pre{cls}>{esc}</pre>"
        return f"<code>{_escape(title)}:</code> {esc}"

    def _pages_from(self, sections: list, returncode: int | None) -> list[str]:
        elapsed = (time.perf_counter() - self.start_time) * 1000
        parts = [f"<b>Executor</b> | <code>{elapsed:.1f}ms</code>"]
        for entry in sections:
            title, content, is_code = entry[0], entry[1], entry[2]
            lang = entry[3] if len(entry) > 3 else None
            if content is None or content == "":
                continue
            parts.append(self._fmt_entry(title, content, is_code, lang))
        if returncode is not None:
            parts.append(self._fmt_entry("result", f"Exit code: {returncode}", False))
        full = "\n\n".join(parts)
        limit = 4096
        if len(full) <= limit:
            return [full]
        return [full[i:i + limit] for i in range(0, len(full), limit)]

    def _nav(self, idx: int) -> list:
        ui = getattr(self.ctx, "ui", None)
        if ui is None:
            return []
        n = max(len(self._pages), 1)
        if n <= 1:
            return []
        return [
            [
                ui.button("<", self._on_page, (idx - 1) % n),
                ui.button(">", self._on_page, (idx + 1) % n),
            ],
            [ui.button("x", self._on_del)],
        ]

    def _kbd(self, buttons: list | None) -> dict | None:
        if not buttons:
            return None
        rows = []
        for row in buttons:
            clean = []
            for b in row:
                item = {"text": str(b.get("text", ""))}
                if b.get("callback_data") is not None:
                    item["callback_data"] = b["callback_data"]
                elif b.get("url"):
                    item["url"] = b["url"]
                clean.append(item)
            rows.append(clean)
        return {"inline_keyboard": rows}

    async def _on_page(self, call: Any, payload: Any) -> None:
        n = max(len(self._pages), 1)
        idx = int(payload) % n if payload is not None else 0
        self._page = idx
        text = self._pages[idx] if self._pages else ""
        await call.edit(text, kbd=self._kbd(self._nav(idx)))
        try:
            await call.answer()
        except Exception:
            pass

    async def _on_del(self, call: Any, payload: Any) -> None:
        try:
            await call.answer()
        except Exception:
            pass
        await call.delete()

    async def _deliver(self, text: str, buttons: list | None, final: bool) -> None:
        kwargs: dict[str, Any] = {"parse_mode": "HTML", "rich": False}
        if buttons:
            kwargs["buttons"] = buttons
        if self.msg:
            kwargs["output"] = "edit"
        try:
            self.msg = await self.ctx.respond(text, **kwargs)
        except Exception:
            if final:
                self.msg = await self.ctx.respond(text, output="reply", parse_mode="HTML", rich=False)

    async def _send(self, sections: list | None = None, returncode: int | None = None, final: bool = False) -> None:
        async with self._lock:
            if self.closed and not final:
                return
            buffer_str = self._strip_ansi(self.buffer).strip()
            if sections is None:
                sections = [("code" if self.is_py else "command", self.cmd, True)]
                if buffer_str:
                    sections.append(("output", buffer_str[-2800:], True))
                else:
                    sections.append(("output", "Running...", False))
            if returncode is not None:
                sections = list(sections) + [("result", f"Exit code: {returncode}", False)]
            if final:
                self._pages = self._pages_from(sections, None)
                self._page = 0
                text = self._pages[0]
                buttons = self._nav(0)
            else:
                elapsed = (time.perf_counter() - self.start_time) * 1000
                parts = [f"<b>Executor</b> | <code>{elapsed:.1f}ms</code>"]
                for entry in sections:
                    title, content, is_code = entry[0], entry[1], entry[2]
                    lang = entry[3] if len(entry) > 3 else None
                    if content is None or content == "":
                        continue
                    parts.append(self._fmt_entry(title, content, is_code, lang))
                text = "\n\n".join(parts)
                buttons = None
            await self._deliver(text, buttons, final)

    async def update(self, new_text: str, force: bool = False, wait: bool = False) -> None:
        if self.closed:
            return
        self.buffer += new_text
        now = time.time()
        self._pending = True
        if force or now - self.last_update > 2.0:
            if not self._sending:
                task = asyncio.create_task(self._trigger_send())
                if wait:
                    await task

    async def _trigger_send(self) -> None:
        self._sending = True
        try:
            while self._pending and not self.closed:
                self._pending = False
                self.last_update = time.time()
                try:
                    await self._send()
                except Exception:
                    pass
                if self._pending and not self.closed:
                    await asyncio.sleep(2.0)
        finally:
            self._sending = False

    async def finish(self, sections: list | None = None, returncode: int | None = None) -> None:
        self.closed = True
        await self._send(sections, returncode=returncode, final=True)


class StreamInterceptor(io.StringIO):
    def __init__(self, updater: OutputUpdater) -> None:
        super().__init__()
        self.updater = updater

    def write(self, s: str) -> int:
        res = super().write(s)
        asyncio.create_task(self.updater.update(s))
        return res


async def _send_result(ctx: Any, sections: list, elapsed_ms: float) -> None:
    header = f"<code>{elapsed_ms:.1f}ms</code>"
    parts = [f"<b>Executor</b> | {header}\n"]
    for entry in sections:
        title, content, is_code = entry[0], entry[1], entry[2]
        lang = entry[3] if len(entry) > 3 else None
        if not content:
            continue
        esc = _escape(_truncate(_censor(content, ctx)))
        if is_code:
            if lang:
                block = f'<pre><code class="language-{lang}">{esc}</code></pre>'
            else:
                block = f"<pre>{esc}</pre>"
            parts.append(f"<b>{_escape(title)}:</b>\n{block}")
        else:
            parts.append(f"<code>{_escape(title)}:</code> {esc}")
    await ctx.respond("\n\n".join(parts), parse_mode="HTML", rich=False)


def _get_raw_text(invocation: Any) -> str:
    msg = getattr(invocation, "message", None)
    if msg is None:
        return " ".join(getattr(invocation, "args", []))
    for attr in ("text", "raw_text", "message", "caption"):
        raw = getattr(msg, attr, None)
        if raw is None and hasattr(msg, "get"):
            raw = msg.get(attr)
        if isinstance(raw, str) and raw:
            name = getattr(invocation, "name", "")
            idx = raw.find(name)
            if idx != -1:
                after = raw[idx + len(name):]
                if after and after[0] in " \t":
                    after = after[1:]
                return after
    return " ".join(getattr(invocation, "args", []))


def _msg_id(value):
    if value is None:
        return None
    if isinstance(value, dict):
        mid = value.get("id") or value.get("message_id") or value.get("msg_id")
        return int(mid) if isinstance(mid, int) else None
    mid = getattr(value, "id", None) or getattr(value, "message_id", None) or getattr(value, "msg_id", None)
    if callable(mid):
        return None
    return int(mid) if isinstance(mid, int) else None


def _attr_or(obj, *names):
    if obj is None:
        return None
    if isinstance(obj, dict):
        for name in names:
            if name in obj:
                return obj[name]
        return None
    for name in names:
        value = getattr(obj, name, None)
        if callable(value) or value is None:
            continue
        return value
    return None


async def _get_reply(ctx, invocation):
    reply = None
    fetch = getattr(ctx, "reply", None)
    if callable(fetch):
        try:
            reply = await fetch()
        except Exception:
            reply = None
    if reply is None:
        for obj in (invocation, ctx):
            for attr in ("reply", "reply_message", "reply_to_message"):
                candidate = _attr_or(obj, attr)
                if callable(candidate):
                    continue
                if candidate is not None:
                    return candidate
    return reply


async def _reply_text(ctx: Any, invocation: Any) -> str | None:
    reply = await _get_reply(ctx, invocation)
    if reply is None:
        return None
    for attr in ("text", "raw_text", "message", "caption"):
        text = getattr(reply, attr, None)
        if isinstance(text, str) and text:
            return text
    if hasattr(reply, "get"):
        for key in ("text", "message", "caption"):
            text = reply.get(key)
            if isinstance(text, str) and text:
                return text
    return None


def _sent_id(result):
    if result is None:
        return None
    body = getattr(result, "message", result) if hasattr(result, "delivered") else result
    if isinstance(body, dict):
        body = body.get("result", body)
    sent = extract_sent_message(body)
    if sent is not None:
        mid = sent.get("id") if isinstance(sent, dict) else getattr(sent, "id", None)
        if isinstance(mid, int):
            return int(mid)
    if isinstance(result, dict) and isinstance(result.get("message_id"), int):
        return int(result["message_id"])
    return _msg_id(body)


_SENTINEL = object()


class _MsgProxy:

    def __init__(
        self,
        raw: Any,
        ctx: Any = None,
        invocation: Any = None,
        is_cmd: bool = False,
    ) -> None:
        self.__dict__["_raw"] = raw
        self.__dict__["_ctx"] = ctx
        self.__dict__["_inv"] = invocation
        self.__dict__["_is_cmd"] = is_cmd


    def _g(self, *attrs: str, default: Any = None) -> Any:
        raw = self.__dict__["_raw"]
        if raw is None:
            return default
        for a in attrs:
            v = getattr(raw, a, _SENTINEL)
            if v is not _SENTINEL and v is not None:
                return v
            if hasattr(raw, "get"):
                v = raw.get(a)
                if v is not None:
                    return v
        return default

    def _rich_html(self) -> str:
        raw = self.__dict__["_raw"]
        if raw is None:
            return ""
        rich = None
        if hasattr(raw, "get"):
            rich = raw.get("rich_message") or raw.get("richMessage")
        if not isinstance(rich, dict):
            return ""
        tools = _tools(self.__dict__["_ctx"])
        render = getattr(tools, "rich_to_html", None) if tools is not None else None
        if render is None:
            return ""
        try:
            return render(raw)
        except Exception:
            return ""


    @property
    def plain_text(self) -> str:
        return self._g("text", "raw_text", "message", "caption") or ""

    @property
    def text(self) -> str:
        return self.html

    @property
    def html(self) -> str:
        rich = self._rich_html()
        if rich:
            return rich
        plain = self._g("text", "raw_text", "message", "caption") or ""
        if not isinstance(plain, str):
            plain = str(plain) if plain else ""
        ents = self._g("entities") or []
        tools = _tools(self.__dict__["_ctx"])
        conv = getattr(tools, "entities_to_html", None) if tools is not None else None
        if conv is not None:
            return conv(plain, ents)
        return html.escape(plain) if plain else ""

    @property
    def content(self) -> str:
        if self.__dict__["_is_cmd"] and self.__dict__["_inv"]:
            return " ".join(getattr(self.__dict__["_inv"], "args", []))
        return self.text

    @property
    def args(self) -> str:
        return self.content

    @property
    def args_list(self) -> list[str]:
        if self.__dict__["_is_cmd"] and self.__dict__["_inv"]:
            return list(getattr(self.__dict__["_inv"], "args", []))
        return self.text.split()


    @property
    def id(self) -> int | None:
        return self._g("id", "message_id")

    @property
    def msg_id(self) -> int | None:
        return self.id

    @property
    def chat_id(self) -> int | None:
        return self._g("chat_id", "peer_id", "chat")

    @property
    def user_id(self) -> int | None:
        return self._g("from_id", "sender_id", "user_id")

    @property
    def from_id(self) -> int | None:
        return self.user_id


    @property
    def first_name(self) -> str:
        return self._g("first_name") or ""

    @property
    def last_name(self) -> str:
        return self._g("last_name") or ""

    @property
    def full_name(self) -> str:
        name = f"{self.first_name} {self.last_name}".strip()
        return name or self.username or str(self.user_id or "?")

    @property
    def name(self) -> str:
        return self.full_name

    @property
    def username(self) -> str | None:
        return self._g("username")

    @property
    def mention(self) -> str:
        uid = self.user_id
        display = html.escape(self.full_name)
        if uid:
            return f'<a href="tg://user?id={uid}">{display}</a>'
        if self.username:
            return f"@{self.username}"
        return display


    @property
    def is_me(self) -> bool:
        return bool(self._g("is_me", "out"))

    @property
    def out(self) -> bool:
        return self.is_me

    @property
    def date(self) -> Any:
        return self._g("date")

    @property
    def src(self) -> str | None:
        return self._g("src", "source")


    @property
    def has_media(self) -> bool:
        return self._g("media") is not None

    @property
    def media(self) -> Any:
        return self._g("media")

    @property
    def photo(self) -> Any:
        return self._g("photo")

    @property
    def document(self) -> Any:
        return self._g("document")

    @property
    def video(self) -> Any:
        return self._g("video")

    @property
    def audio(self) -> Any:
        return self._g("audio")

    @property
    def voice(self) -> Any:
        return self._g("voice")

    @property
    def sticker(self) -> Any:
        return self._g("sticker")

    @property
    def animation(self) -> Any:
        return self._g("animation")


    @property
    def topic_id(self) -> int | None:
        return self._g("topic_id", "message_thread_id", "top_msg_id")


    @property
    def raw(self) -> Any:
        return self.__dict__["_raw"]

    def get(self, key: str, default: Any = None) -> Any:
        raw = self.__dict__["_raw"]
        if hasattr(raw, "get"):
            return raw.get(key, default)
        return getattr(raw, key, default)

    def __getattr__(self, name: str) -> Any:
        raw = self.__dict__.get("_raw")
        if raw is not None:
            v = getattr(raw, name, _SENTINEL)
            if v is not _SENTINEL:
                return v
        raise AttributeError(f"MsgProxy has no attribute {name!r}")

    def __bool__(self) -> bool:
        return self.__dict__.get("_raw") is not None

    def __repr__(self) -> str:
        raw = self.__dict__.get("_raw")
        if raw is None:
            return "MsgProxy(empty)"

        def _clean_dict(d: dict) -> dict:
            cleaned = {}
            for k, v in d.items():
                if k in ("raw", "bytes", "access_hash", "file_reference"):
                    continue
                if isinstance(v, dict):
                    cleaned[k] = _clean_dict(v)
                elif isinstance(v, list):
                    cleaned[k] = [_clean_dict(i) if isinstance(i, dict) else i for i in v]
                else:
                    cleaned[k] = v
            return cleaned

        import datetime
        import time

        def _format_val(v: Any, indent: int, key: str = "") -> str:
            if isinstance(v, dict):
                if not v:
                    return "{}"
                type_name = v.get("_", "dict")
                items = [(k, val) for k, val in v.items() if k != "_"]
                if not items:
                    return f"{type_name}()"
                lines = [f"{type_name}("]
                for k, val in items:
                    lines.append(" " * (indent + 4) + f"{k}={_format_val(val, indent + 4, k)},")
                lines.append(" " * indent + ")")
                return "\n".join(lines)
            elif isinstance(v, list):
                if not v:
                    return "[]"
                lines = ["["]
                for val in v:
                    lines.append(" " * (indent + 4) + f"{_format_val(val, indent + 4)},")
                lines.append(" " * indent + "]")
                return "\n".join(lines)
            elif isinstance(v, datetime.datetime):
                return repr(v)
            elif isinstance(v, str):
                return repr(v)
            elif isinstance(v, int) and (key == "date" or key.endswith("_date")) and 0 < v < 4000000000:
                try:
                    return f"{v} ({time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(v))})"
                except (OverflowError, OSError, ValueError):
                    return repr(v)
            else:
                return repr(v)

        data = {}
        if hasattr(raw, "items"):
            data = dict(raw)
        elif hasattr(raw, "__dict__"):
            data = vars(raw)
            data = {k: v for k, v in data.items() if not k.startswith("_")}
            
        data = _clean_dict(data)
        
        if "id" not in data and self.id is not None:
            data["id"] = self.id
        
        rich_html = self._rich_html()
        if rich_html:
            data["html"] = rich_html
            
        plain = self.plain_text
        if plain and "text" not in data and "message" not in data:
            data["text"] = plain

        lines = ["Message("]
        for k, v in data.items():
            if v is not None and v != {} and v != []:
                lines.append(f"    {k}={_format_val(v, 4, k)},")
        lines.append(")")
        return "\n".join(lines)


    def as_mention(self, name: str | None = None) -> str:
        uid = self.user_id
        display = html.escape(name or self.full_name)
        return f'<a href="tg://user?id={uid}">{display}</a>' if uid else display

    def fmt_text(self, text: str | None = None) -> str:
        return html.escape(str(text if text is not None else self.text))


    async def respond(self, text: str, **kwargs: Any) -> Any:
        return await self.__dict__["_ctx"].respond(text, **kwargs)

    async def edit(self, text: str, **kwargs: Any) -> Any:
        return await self.__dict__["_ctx"].respond(text, output="edit", **kwargs)

    async def reply(self, text: str, **kwargs: Any) -> Any:
        return await self.__dict__["_ctx"].respond(text, output="reply", **kwargs)

    async def delete(self) -> Any:
        app = getattr(getattr(self.__dict__["_ctx"], "runtime", None), "app", None)
        if app is None or self.chat_id is None or self.id is None:
            return None
        return await app.delete_msg(self.chat_id, self.id)

    async def pin(self, both_sides: bool = False, **kwargs: Any) -> Any:
        app = getattr(getattr(self.__dict__["_ctx"], "runtime", None), "app", None)
        if app is None or self.chat_id is None or self.id is None:
            return None
        return await app.pin_msg(self.chat_id, self.id, notify=not both_sides, **kwargs)

    async def unpin(self) -> Any:
        app = getattr(getattr(self.__dict__["_ctx"], "runtime", None), "app", None)
        if app is None or self.chat_id is None or self.id is None:
            return None
        return await app.unpin_msg(self.chat_id, self.id)

    async def forward(self, to_chat: Any, **kwargs: Any) -> Any:
        app = getattr(getattr(self.__dict__["_ctx"], "runtime", None), "app", None)
        if app is None or self.chat_id is None or self.id is None:
            return None
        return await app.forward_msg(self.chat_id, self.id, to=to_chat, **kwargs)

    async def react(self, emoji: str) -> Any:
        app = getattr(getattr(self.__dict__["_ctx"], "runtime", None), "app", None)
        if app is None or self.chat_id is None or self.id is None:
            return None
        return await app.send_reaction(self.chat_id, self.id, emoji)

    async def unreact(self) -> Any:
        app = getattr(getattr(self.__dict__["_ctx"], "runtime", None), "app", None)
        if app is None or self.chat_id is None or self.id is None:
            return None
        return await app.send_reaction(self.chat_id, self.id, "")

    async def get_sender(self) -> Any:
        app = getattr(getattr(self.__dict__["_ctx"], "runtime", None), "app", None)
        uid = self.user_id
        if app is None or uid is None:
            return None
        return await app.get_user(uid)

    async def get_chat(self) -> Any:
        app = getattr(getattr(self.__dict__["_ctx"], "runtime", None), "app", None)
        cid = self.chat_id
        if app is None or cid is None:
            return None
        return await app.get_chat(cid)

    async def download(self, destination: Any = None) -> Any:
        ctx = self.__dict__["_ctx"]
        source = self.__dict__["_raw"]
        if destination is None:
            destination = "/tmp"
        return await ctx.download_file(source, destination)

    async def read(self) -> Any:
        app = getattr(getattr(self.__dict__["_ctx"], "runtime", None), "app", None)
        if app is None or self.chat_id is None:
            return None
        return await app.mark_read(self.chat_id, self.id)


class _DBProxy:

    def __init__(self, state: Any, module_id: str = "executor") -> None:
        ns = None
        if state is not None:
            if hasattr(state, "namespace"):
                try:
                    ns = state.namespace(module_id)
                except Exception:
                    ns = state
            else:
                ns = state
        self.__dict__["_ns"] = ns
        self.__dict__["_raw_state"] = state

    def _ns(self) -> Any:
        return self.__dict__["_ns"]


    def get(self, key: str, default: Any = None) -> Any:
        ns = self.__dict__["_ns"]
        if ns is None:
            return default
        try:
            return ns.get(key, default)
        except Exception:
            return default

    def set(self, key: str, value: Any) -> None:
        ns = self.__dict__["_ns"]
        if ns is None:
            return
        try:
            ns.set(key, value)
        except Exception:
            pass

    def delete(self, key: str) -> bool:
        ns = self.__dict__["_ns"]
        if ns is None:
            return False
        try:
            result = ns.delete(key)
            return bool(result)
        except Exception:
            return False

    def has(self, key: str) -> bool:
        ns = self.__dict__["_ns"]
        if ns is None:
            return False
        try:
            return ns.get(key) is not None
        except Exception:
            return False

    def keys(self) -> tuple[str, ...]:
        ns = self.__dict__["_ns"]
        if ns is None:
            return ()
        try:
            return ns.keys()
        except Exception:
            return ()

    def all(self) -> dict[str, Any]:
        return {k: self.get(k) for k in self.keys()}

    def update(self, data: dict[str, Any]) -> None:
        for k, v in data.items():
            self.set(k, v)

    def clear(self) -> None:
        for k in self.keys():
            self.delete(k)

    def incr(self, key: str, by: int | float = 1, default: int | float = 0) -> int | float:
        current = self.get(key, default)
        new_val = (current or 0) + by
        self.set(key, new_val)
        return new_val

    def append(self, key: str, item: Any, max_len: int | None = None) -> list:
        lst = self.get(key, [])
        if not isinstance(lst, list):
            lst = [lst]
        lst.append(item)
        if max_len is not None:
            lst = lst[-max_len:]
        self.set(key, lst)
        return lst

    def pointer(self, key: str, default: Any = None) -> Any:
        ns = self.__dict__["_ns"]
        if ns is not None and hasattr(ns, "pointer"):
            return ns.pointer(key, default)
        raise AttributeError("pointer() requires a StateNamespace backend")


    def __getitem__(self, key: str) -> Any:
        v = self.get(key, _SENTINEL)
        if v is _SENTINEL:
            raise KeyError(key)
        return v

    def __setitem__(self, key: str, value: Any) -> None:
        self.set(key, value)

    def __delitem__(self, key: str) -> None:
        self.delete(key)

    def __contains__(self, key: str) -> bool:
        return self.has(key)

    def __len__(self) -> int:
        return len(self.keys())

    def __iter__(self):
        return iter(self.keys())

    def __repr__(self) -> str:
        return f"<DB keys={list(self.keys())}>"

    def ns(self, module_id: str) -> "_DBProxy":
        return _DBProxy(self.__dict__["_raw_state"], module_id)


def _build_py_helpers(ctx: Any, invocation: Any, reply: Any) -> dict[str, Any]:
    source = getattr(ctx, "_source", None)
    state = getattr(ctx, "state", None)

    m_proxy = _MsgProxy(source, ctx=ctx, invocation=invocation, is_cmd=True)
    r_proxy = _MsgProxy(reply, ctx=ctx, invocation=invocation, is_cmd=False) if reply else None
    db_proxy = _DBProxy(state)

    def _attr_or(obj, *attrs, default=None):
        for a in attrs:
            v = getattr(obj, a, None)
            if v is not None:
                return v
            if hasattr(obj, "get"):
                v = obj.get(a)
                if v is not None:
                    return v
        return default


    def get_text(msg=None) -> str | None:
        if msg is not None:
            if hasattr(msg, "html"):
                html_text = msg.html
            else:
                html_text = _attr_or(msg, "text", "raw_text", "message", "caption")
            return html_text or None
        if r_proxy:
            return r_proxy.html or None
        return m_proxy.content or None

    def get_reply_text() -> str | None:
        return (r_proxy.html if r_proxy else None) or None

    def get_args() -> str:
        return m_proxy.args

    def get_args_list() -> list[str]:
        return m_proxy.args_list

    def get_chat_id(msg=None) -> int | None:
        if msg is not None:
            return _attr_or(msg, "chat_id", "peer_id", "chat")
        return m_proxy.chat_id

    def get_user_id(msg=None) -> int | None:
        if msg is not None:
            return _attr_or(msg, "from_id", "sender_id", "user_id")
        return m_proxy.user_id

    def get_msg_id(msg=None) -> int | None:
        if msg is not None:
            return _attr_or(msg, "id", "message_id")
        return m_proxy.id

    def get_reply_id() -> int | None:
        return r_proxy.id if r_proxy else None

    def is_reply() -> bool:
        return r_proxy is not None

    def is_me() -> bool:
        return m_proxy.is_me

    def has_media(msg=None) -> bool:
        if msg is not None:
            return _attr_or(msg, "media") is not None
        return m_proxy.has_media

    def get_media(msg=None) -> Any:
        if msg is not None:
            return _attr_or(msg, "media", "photo", "document", "video", "audio")
        return m_proxy.media

    def get_sender_name(msg=None) -> str | None:
        if msg is not None:
            first = _attr_or(msg, "first_name") or ""
            last = _attr_or(msg, "last_name") or ""
            full = f"{first} {last}".strip()
            return full or _attr_or(msg, "username")
        return m_proxy.full_name

    def get_username(msg=None) -> str | None:
        if msg is not None:
            return _attr_or(msg, "username")
        return m_proxy.username


    async def get_entity(peer) -> Any:
        tg = getattr(ctx, "tg", None)
        if tg is None:
            raise RuntimeError("tg gateway unavailable")
        return await tg.get_entity(peer)

    async def get_full_user(user_id=None) -> Any:
        uid = user_id or get_user_id()
        return await ctx.mt(
            "users.getFullUser",
            id={"_": "inputUser", "user_id": uid, "access_hash": 0},
        )

    async def get_peers_count(chat_id=None) -> int | None:
        cid = chat_id or get_chat_id()
        try:
            res = await ctx.mt(
                "channels.getFullChannel",
                channel={"_": "inputChannel", "channel_id": cid, "access_hash": 0},
            )
            return res.get("full_chat", {}).get("participants_count")
        except Exception:
            return None


    def mention(user_id: int, name: str = "user") -> str:
        return f'<a href="tg://user?id={user_id}">{html.escape(str(name))}</a>'

    def bold(text: str) -> str:
        return f"<b>{html.escape(str(text))}</b>"

    def italic(text: str) -> str:
        return f"<i>{html.escape(str(text))}</i>"

    def under(text: str) -> str:
        return f"<u>{html.escape(str(text))}</u>"

    def strike(text: str) -> str:
        return f"<s>{html.escape(str(text))}</s>"

    def spoiler(text: str) -> str:
        return f"<tg-spoiler>{html.escape(str(text))}</tg-spoiler>"

    def code(text: str) -> str:
        return f"<code>{html.escape(str(text))}</code>"

    def pre(text: str, lang: str = "") -> str:
        lang_attr = f' class="language-{html.escape(lang)}"' if lang else ""
        return f"<pre><code{lang_attr}>{html.escape(str(text))}</code></pre>"

    def link(url: str, text: str) -> str:
        return f'<a href="{url}">{html.escape(str(text))}</a>'

    def hesc(text: str) -> str:
        return html.escape(str(text))

    def fmt_size(size: int) -> str:
        for unit in ("B", "KB", "MB", "GB", "TB"):
            if abs(size) < 1024:
                return f"{size:.1f} {unit}"
            size /= 1024
        return f"{size:.1f} PB"

    def fmt_time(seconds: float) -> str:
        if seconds < 60:
            return f"{seconds:.1f}s"
        mi, s = divmod(int(seconds), 60)
        if mi < 60:
            return f"{mi}m {s}s"
        h, mi = divmod(mi, 60)
        return f"{h}h {mi}m {s}s"


    async def respond(text: str, **kwargs) -> Any:
        return await ctx.respond(text, **kwargs)

    async def edit_msg(text: str, **kwargs) -> Any:
        return await ctx.respond(text, output="edit", **kwargs)

    async def reply_to(text: str, **kwargs) -> Any:
        return await ctx.respond(text, output="reply", **kwargs)

    return {
        "m": m_proxy,
        "r": r_proxy,
        "db": db_proxy,
        "get_text": get_text,
        "get_reply_text": get_reply_text,
        "get_args": get_args,
        "get_args_list": get_args_list,
        "get_chat_id": get_chat_id,
        "get_user_id": get_user_id,
        "get_msg_id": get_msg_id,
        "get_reply_id": get_reply_id,
        "is_reply": is_reply,
        "is_me": is_me,
        "has_media": has_media,
        "get_media": get_media,
        "get_sender_name": get_sender_name,
        "get_username": get_username,
        "get_entity": get_entity,
        "get_full_user": get_full_user,
        "get_peers_count": get_peers_count,
        "mention": mention,
        "bold": bold,
        "italic": italic,
        "under": under,
        "strike": strike,
        "spoiler": spoiler,
        "code": code,
        "pre": pre,
        "link": link,
        "hesc": hesc,
        "fmt_size": fmt_size,
        "fmt_time": fmt_time,
        "respond": respond,
        "edit_msg": edit_msg,
        "reply_to": reply_to,
        "html": html,
        "re": re,
        "json": __import__("json"),
        "inspect": inspect,
    }


async def command_sh(ctx, invocation):
    raw = _get_raw_text(invocation)
    skip_output = False
    if match := re.match(r"^(?:-so|--skip-output)(?:\s+|$)", raw):
        skip_output = True
        raw = raw[match.end():]

    cmd = _clean_code(raw)
    if not cmd:
        reply_code = await _reply_text(ctx, invocation)
        if reply_code:
            cmd = _clean_code(reply_code)
    if not cmd:
        prefix = ctx.runtime.config.prefix if ctx.runtime else "."
        await ctx.respond(
            f"<b>Usage:</b> <code>{prefix}sh &lt;command&gt;</code>",
            parse_mode="HTML", rich=False,
        )
        return

    cmd = _unescape_tg_code(cmd)

    inv_msg_id = _msg_id(invocation.message)

    start_time = time.perf_counter()
    env = os.environ.copy()
    env["TERM"] = "xterm"
    bindir = os.path.dirname(sys.executable)
    env["PATH"] = f"{bindir}{os.pathsep}{env.get('PATH', '')}"
    if sys.prefix != getattr(sys, "base_prefix", sys.prefix):
        env["VIRTUAL_ENV"] = sys.prefix

    pm = None
    if "UV" in env or "UV_RUN_RECURSION_DEPTH" in env:
        pm = "uv pip"
    elif "PDM_PROJECT_ROOT" in env:
        pm = "pdm run pip"
    elif "POETRY_ACTIVE" in env:
        pm = "poetry run pip"
    if pm:
        cmd = f"pip() {{ {pm} \"$@\"; }};\n" + cmd

    shell = os.environ.get("SHELL", "/bin/bash")
    master, slave = pty.openpty()

    process = await asyncio.create_subprocess_exec(
        shell, "-c", cmd,
        stdin=slave,
        stdout=slave,
        stderr=slave,
        env=env,
    )
    os.close(slave)
    os.set_blocking(master, False)
    updater = OutputUpdater(ctx, cmd)
    updater.master_fd = master
    updater.process = process

    if inv_msg_id:
        _ACTIVE_SH[inv_msg_id] = process
    if not skip_output:
        await updater.update("", force=True, wait=True)
        resp_msg_id = _sent_id(updater.msg)
        if resp_msg_id:
            _ACTIVE_SH[resp_msg_id] = process

    async def read_pty():
        while True:
            try:
                data = os.read(master, 4096)
                if data:
                    text = data.decode("utf-8", errors="replace")
                    if not skip_output:
                        await updater.update(text)
                else:
                    break
            except BlockingIOError:
                await asyncio.sleep(0.1)
            except OSError:
                break

    reader_task = asyncio.create_task(read_pty())
    
    try:
        await process.wait()
        try:
            await asyncio.wait_for(reader_task, timeout=1.0)
        except asyncio.TimeoutError:
            pass
    except asyncio.CancelledError:
        process.kill()
        await process.wait()
    finally:
        if not reader_task.done():
            reader_task.cancel()
        os.close(master)

    if inv_msg_id and inv_msg_id in _ACTIVE_SH:
        del _ACTIVE_SH[inv_msg_id]
    resp_msg_id = _sent_id(updater.msg)
    if resp_msg_id and resp_msg_id in _ACTIVE_SH:
        del _ACTIVE_SH[resp_msg_id]

    if skip_output:
        return

    buffer_str = updater._strip_ansi(updater.buffer).strip()
    sections = [("command", cmd, True, "shell")]
    if buffer_str:
        sections.append(("output", buffer_str, True, "shell"))
    
    await updater.finish(sections, returncode=process.returncode)


async def command_py(ctx, invocation):
    raw = _get_raw_text(invocation)
    skip_output = False
    if match := re.match(r"^(?:-so|--skip-output)(?:\s+|$)", raw):
        skip_output = True
        raw = raw[match.end():]

    raw_code = _clean_code(raw)
    if not raw_code:
        reply_code = await _reply_text(ctx, invocation)
        if reply_code:
            raw_code = _clean_code(reply_code)
    if not raw_code:
        prefix = ctx.runtime.config.prefix if ctx.runtime else "."
        await ctx.respond(
            f"<b>Usage:</b> <code>{prefix}py &lt;code&gt;</code> | reply с кодом | -so без вывода",
            parse_mode="HTML", rich=False,
        )
        return

    raw_code = _sanitise_code(raw_code)

    wrapped_code = _wrap_eval_code(raw_code)

    reply = await _get_reply(ctx, invocation)

    helpers = _build_py_helpers(ctx, invocation, reply)
    env: dict[str, Any] = {
        "_auto_await": _auto_await,
        "ctx": ctx,
        "runtime": getattr(ctx, "runtime", None),
        "tg": getattr(ctx, "tg", None),
        "c": getattr(ctx, "tg", None),
        "client": getattr(ctx, "client", getattr(ctx, "tg", None)),
        "state": getattr(ctx, "state", None),
        "_source_raw": getattr(ctx, "_source", None),
        "_reply_raw": reply,
        "invocation": invocation,
        "i": invocation,
        "asyncio": asyncio,
        "os": os,
        "sys": sys,
        "time": time,
        "re": re,
        "html": html,
        "io": io,
        "traceback": traceback,
        "inspect": inspect,
        **helpers,
    }
    env["msg"] = env["m"]
    env["message"] = env["m"]
    env["reply"] = env["r"]
    env["rep"] = env["r"]

    inv_msg_id = _msg_id(invocation.message)

    updater = OutputUpdater(ctx, raw_code, is_py=True)
    if not skip_output:
        await updater.update("", force=True, wait=True)

    result_val = _SENTINEL
    error_trace = None

    async def _task():
        nonlocal result_val
        exec_scope = dict(env)
        try:
            bytecode = compile(wrapped_code, "<executor>", "exec")
        except SyntaxError as exc:
            raise SyntaxError(f"SyntaxError: {exc.msg} (line {exc.lineno})") from None
        exec(bytecode, exec_scope)
        runner = exec_scope.get("__executor_runner__")
        if runner is None:
            raise NameError("__executor_runner__ missing — code wrapping failed") from None
        result_val = await runner()

    eval_task = asyncio.create_task(_task())
    updater.process = eval_task
    if inv_msg_id:
        _ACTIVE_PY[inv_msg_id] = eval_task
    if not skip_output:
        resp_msg_id = _sent_id(updater.msg)
        if resp_msg_id:
            _ACTIVE_PY[resp_msg_id] = eval_task

    stdout_buf = StreamInterceptor(updater)
    stderr_buf = StreamInterceptor(updater)

    try:
        with contextlib.redirect_stdout(stdout_buf), contextlib.redirect_stderr(stderr_buf):
            await eval_task
    except asyncio.CancelledError:
        error_trace = "Execution cancelled"
    except Exception:
        error_trace = traceback.format_exc()
    finally:
        if inv_msg_id and inv_msg_id in _ACTIVE_PY:
            del _ACTIVE_PY[inv_msg_id]
        resp_msg_id = _sent_id(updater.msg)
        if resp_msg_id and resp_msg_id in _ACTIVE_PY:
            del _ACTIVE_PY[resp_msg_id]

    if skip_output:
        return

    sections = [("code", raw_code, True, "python")]
    buffer_str = updater._strip_ansi(updater.buffer).strip()
    if buffer_str:
        sections.append(("output", buffer_str, True, "python"))
    if result_val is not _SENTINEL:
        rendered = str(result_val) if isinstance(result_val, str) else repr(result_val)
        sections.append(("return", rendered if rendered else "''", True, "python"))
    if error_trace:
        sections.append(("traceback", error_trace, True, "python"))
    if len(sections) == 1:
        sections.append(("result", "Done ✓", False))

    await updater.finish(sections)
    
async def command_kill(ctx, invocation):
    reply = await _get_reply(ctx, invocation)
    if not reply:
        await ctx.respond("<b>Reply to a running py/sh output message to kill it.</b>", parse_mode="HTML")
        return

    target_id = _msg_id(reply)
    killed = False

    proc = _ACTIVE_SH.get(target_id)
    if proc is not None:
        try:
            proc.kill()
            killed = True
        except Exception:
            pass
        _ACTIVE_SH.pop(target_id, None)

    task = _ACTIVE_PY.get(target_id)
    if task is not None:
        try:
            task.cancel()
            killed = True
        except Exception:
            pass
        _ACTIVE_PY.pop(target_id, None)

    if killed:
        await ctx.respond("<b>Process killed!</b>", parse_mode="HTML")
    else:
        await ctx.respond("<b>No active process found for this message.</b>", parse_mode="HTML")


