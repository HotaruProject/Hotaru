HOTARU = {
    "id": "executor",
    "version": "2.1.0",
    "commands": ["sh", "py"],
    "capabilities": ["mt", "files", "net", "state"],
}

import ast
import asyncio
import contextlib
import html
import io
import os
import re
import sys
import time
import traceback
from typing import Any


_ACTIVE: dict[str, Any] = {"sh": None, "py": None}


async def _auto_await(value):
    while asyncio.iscoroutine(value) or asyncio.isfuture(value):
        value = await value
    return value


def _wrap_eval_code(code: str):
    code = code.strip(); lines = code.splitlines()
    try:
        tree = ast.parse(code)
    except SyntaxError:
        indented = "\n".join(f"    {line}" for line in lines)
        return f"async def __executor_runner__():\n{indented}"
    if not tree.body:
        indented = "\n".join(f"    {line}" for line in lines)
        return f"async def __executor_runner__():\n{indented}"
    last = tree.body[-1]
    if isinstance(last, ast.Expr) and not isinstance(last.value, (ast.Yield, ast.YieldFrom)):
        if len(tree.body) > 1 and tree.body[-2].end_lineno >= last.lineno:
            head = "\n".join(f"    {ast.unparse(stmt)}" for stmt in tree.body[:-1])
        else:
            head = "\n".join(f"    {line}" for line in lines[: last.lineno - 1])
        tail = f"    return await _auto_await({ast.unparse(last.value)})"
        return f"async def __executor_runner__():\n{head}\n{tail}"
    indented = "\n".join(f"    {line}" for line in lines)
    return f"async def __executor_runner__():\n{indented}"


def _escape(value: str) -> str:
    return html.escape(str(value), quote=False)


def _clean_code(text: str) -> str:
    text = text.strip()
    if text.startswith("```") and text.endswith("```"):
        lines = text.splitlines()
        return "\n".join(lines[1:-1]).strip() if len(lines) > 1 else text.strip("`").strip()
    return text


def _truncate(text: str, max_len: int = 3500) -> str:
    if len(text) > max_len:
        return text[:max_len] + f"\n\n... [Cut: {len(text) - max_len} chars]"
    return text


async def _reply_text(ctx, invocation):
    reply = getattr(invocation, "reply", None) or getattr(invocation, "reply_message", None)
    if reply is None:
        return None
    text = getattr(reply, "text", None) or getattr(reply, "raw_text", None)
    return text if isinstance(text, str) else None


def _censor(ret: str, ctx) -> str:
    runtime = getattr(ctx, "runtime", None)
    if runtime is not None:
        config = getattr(runtime, "config", None)
        if config is not None:
            for key in ("bot_token", "inline_bot_token", "api_hash"):
                try:
                    secret = getattr(config, key, None)
                except Exception:
                    secret = None
                if secret:
                    ret = ret.replace(str(secret), f'{str(secret).split(":")[0]}:{"*" * 26}' if ":" in str(secret) else "*" * 26)
    return ret


async def _send_result(ctx, sections: list, elapsed_ms: float):
    header = f"<code>{elapsed_ms:.1f}ms</code>"
    parts = [f"<b>Executor</b> | {header}\n"]
    for title, content, is_code in sections:
        if not content:
            continue
        esc = _escape(_truncate(_censor(content, ctx)))
        parts.append(f"<b>{_escape(title)}:</b>\n<pre><code>{esc}</code></pre>")
    await ctx.respond("\n\n".join(parts), parse_mode="HTML", rich=False)


async def command_sh(ctx, invocation):
    args = getattr(invocation, "args", [])

    raw = " ".join(args)
    skip_output = False
    if match := re.match(r"^(?:-so|--skip-output)(?:\s+|$)", raw):
        skip_output = True
        raw = raw[match.end():]

    cmd = _clean_code(raw)
    if not cmd:
        reply_code = await _reply_text(ctx, invocation)
        if reply_code:
            cmd = _clean_code(reply_code)
    if not cmd:
        prefix = ctx.runtime.config.prefix if ctx.runtime else "."
        await ctx.respond(f"<b>Usage:</b> <code>{prefix}sh &lt;command&gt;</code>", parse_mode="HTML", rich=False)
        return

    start_time = time.perf_counter()

    process = await asyncio.create_subprocess_shell(
        cmd,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
        env=os.environ.copy(),
    )
    _ACTIVE["sh"] = process

    try:
        stdout_bytes, stderr_bytes = await process.communicate()
    except asyncio.CancelledError:
        process.kill()
        stdout_bytes, stderr_bytes = b"", b"Process terminated"
    finally:
        _ACTIVE["sh"] = None
        elapsed = (time.perf_counter() - start_time) * 1000

    if skip_output:
        return

    stdout_str = stdout_bytes.decode("utf-8", errors="replace").strip()
    stderr_str = stderr_bytes.decode("utf-8", errors="replace").strip()

    sections = [("command", cmd, True)]
    if stdout_str:
        sections.append(("stdout", stdout_str, True))
    if stderr_str:
        sections.append(("stderr", stderr_str, True))
    if not sections:
        sections.append(("result", f"Exit code: {process.returncode}", False))

    await _send_result(ctx, sections, elapsed)


async def command_py(ctx, invocation):
    args = getattr(invocation, "args", [])

    raw = " ".join(args)
    skip_output = False
    if match := re.match(r"^(?:-so|--skip-output)(?:\s+|$)", raw):
        skip_output = True
        raw = raw[match.end():]

    raw_code = _clean_code(raw)
    if not raw_code:
        reply_code = await _reply_text(ctx, invocation)
        if reply_code:
            raw_code = _clean_code(reply_code)
    if not raw_code:
        prefix = ctx.runtime.config.prefix if ctx.runtime else "."
        await ctx.respond(f"<b>Usage:</b> <code>{prefix}py &lt;code&gt;</code> | reply с кодом | -so без вывода", parse_mode="HTML", rich=False)
        return

    raw_code = raw_code.replace("\xa0", "\x20")
    wrapped_code = _wrap_eval_code(raw_code)

    reply = getattr(invocation, "reply", None) or getattr(invocation, "reply_message", None)
    env = {
        "ctx": ctx,
        "runtime": getattr(ctx, "runtime", None),
        "client": getattr(ctx, "client", getattr(ctx, "tg", None)),
        "tg": getattr(ctx, "tg", None),
        "c": getattr(ctx, "tg", None),
        "db": getattr(ctx, "state", None),
        "state": getattr(ctx, "state", None),
        "message": getattr(ctx, "message", None),
        "m": getattr(ctx, "message", None),
        "msg": getattr(ctx, "message", None),
        "reply": reply,
        "r": reply,
        "invocation": invocation,
        "i": invocation,
        "asyncio": asyncio,
        "os": os,
        "sys": sys,
        "time": time,
    }

    stdout_buf = io.StringIO()
    stderr_buf = io.StringIO()
    result_val = None
    error_trace = None
    start_time = time.perf_counter()

    async def _task():
        nonlocal result_val
        exec_scope = dict(env)
        exec(wrapped_code, exec_scope)
        runner = exec_scope["__executor_runner__"]
        result_val = await runner()

    eval_task = asyncio.create_task(_task())
    _ACTIVE["py"] = eval_task

    try:
        with contextlib.redirect_stdout(stdout_buf), contextlib.redirect_stderr(stderr_buf):
            await eval_task
    except asyncio.CancelledError:
        error_trace = "Execution cancelled"
    except Exception:
        error_trace = traceback.format_exc()
    finally:
        _ACTIVE["py"] = None
        elapsed = (time.perf_counter() - start_time) * 1000

    if skip_output:
        return

    stdout_str = stdout_buf.getvalue().strip()
    stderr_str = stderr_buf.getvalue().strip()

    sections = [("code", raw_code, True)]
    if stdout_str:
        sections.append(("stdout", stdout_str, True))
    if stderr_str:
        sections.append(("stderr", stderr_str, True))
    if result_val is not None:
        sections.append(("return", repr(result_val), True))
        sections.append(("type", type(result_val).__name__, False))
    if error_trace:
        sections.append(("traceback", error_trace, True))
    if not sections:
        sections.append(("result", "Done (None)", False))

    await _send_result(ctx, sections, elapsed)
