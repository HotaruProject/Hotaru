from goygram.sugar import extract_sent_message


_ACTIVE_SH: dict[int, Any] = {}
_ACTIVE_PY: dict[int, Any] = {}

def _wrap_eval_code(code: str) -> ast.Module:
    tree = ast.parse(code, mode="exec")
    body = tree.body or [ast.Pass()]
    if len(body) == 1 and isinstance(body[0], (ast.AsyncFunctionDef, ast.FunctionDef)):
        body.append(ast.Expr(value=ast.Call(func=ast.Name(id=body[0].name, ctx=ast.Load()), args=[], keywords=[])))
    last = body[-1]
    if isinstance(last, ast.Expr) and not isinstance(last.value, (ast.Yield, ast.YieldFrom)):
        body[-1] = ast.Return(value=ast.Await(value=ast.Call(
            func=ast.Name(id="_auto_await", ctx=ast.Load()), args=[last.value], keywords=[],
        )))
    runner = ast.AsyncFunctionDef(
        name="__executor_runner__",
        args=ast.arguments(posonlyargs=[], args=[], vararg=None, kwonlyargs=[], kw_defaults=[], kwarg=None, defaults=[]),
        body=body, decorator_list=[], returns=None,
    )
    return ast.fix_missing_locations(ast.Module(body=[runner], type_ignores=[]))

async def _auto_await(value: Any) -> Any:
    while asyncio.iscoroutine(value) or asyncio.isfuture(value):
        value = await value
    return value


def _escape(value: str) -> str:
    return html.escape(str(value), quote=False)


def _u16(s: str) -> int:
    return len(s.encode("utf-16-le")) // 2


def _trace(exc: BaseException) -> str:
    frames = traceback.extract_tb(exc.__traceback__)
    internal = frames[0].filename if frames else ""
    line = None
    while frames and frames[0].filename == internal:
        frames.pop(0)
    if frames and frames[0].name == "__executor_runner__":
        line = frames[0].lineno
        frames.pop(0)
    head = f"{type(exc).__name__}: {exc}"
    if not frames:
        return head + (f" (line {line})" if line else "")
    return "".join([
        "Traceback (most recent call last):\n",
        *traceback.format_list(frames),
        *traceback.format_exception_only(type(exc), exc),
    ])


def _clean_code(text: str) -> str:
    if text.startswith("```") and text.endswith("```"):
        opening, separator, inner = text[3:-3].partition("\n")
        if separator and opening.strip() in {"", "py", "python", "sh", "bash", "shell"}:
            return inner
        if not separator:
            return text[3:-3]
    return text


def _censor(ret: str, ctx: Any) -> str:
    runtime = getattr(ctx, "runtime", None)
    if runtime is not None:
        config = getattr(runtime, "config", None)
        if config is not None:
            for key in ("bot_token", "inline_bot_token", "api_hash"):
                try:
                    secret = getattr(config, key, None)
                except Exception:
                    secret = None
                if secret:
                    masked = (
                        f'{str(secret).split(":")[0]}:{"*" * 26}'
                        if ":" in str(secret)
                        else "*" * 26
                    )
                    ret = ret.replace(str(secret), masked)
    return ret


def _tools(ctx: Any) -> Any:
    tools = getattr(ctx, "tools", None)
    if tools is not None and hasattr(tools, "rich_to_html"):
        return tools
    if hasattr(ctx, "runtime") and ctx.runtime is not None:
        runtime_tools = getattr(ctx.runtime, "tools", None)
        if runtime_tools is not None and hasattr(runtime_tools, "rich_to_html"):
            return runtime_tools
    try:
        from relay.toolkit import TOOLS

        return TOOLS
    except Exception:
        return None


class OutputUpdater:
    def __init__(self, ctx: Any, cmd: str, is_py: bool = False) -> None:
        self.ctx = ctx
        self.cmd = cmd
        self.is_py = is_py
        self.buffer = ""
        self.last_update = 0.0
        self.msg = None
        self.closed = False
        self.start_time = time.perf_counter()
        self.ansi_re = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')
        self._sending = False
        self._pending = False
        self._lock = asyncio.Lock()
        self._pages: list[str] = []
        self._page = 0
        self.master_fd: Any = None
        self.process: Any = None

    def strip_ansi(self, text: str) -> str:
        text = self.ansi_re.sub('', text)
        lines = text.split('\n')
        res: list[str] = []
        for line in lines:
            parts = line.split('\r')
            valid_parts = [p for p in parts if p]
            if valid_parts:
                res.append(valid_parts[-1])
            elif parts:
                res.append('')
        return '\n'.join(res)

    def _fmt_entry(self, title: str, content: Any, is_code: bool, lang: str | None = None) -> str:
        esc = _escape(_censor(str(content), self.ctx))
        title = self.ctx.t("kernel.executor.section." + title, title)
        if is_code:
            block = f'<pre class="language-{_escape(lang)}">{esc}</pre>' if lang else f"<pre>{esc}</pre>"
            return f"<b>{_escape(title)}:</b>\n{block}"
        return f"<code>{_escape(title)}:</code> {esc}"

    def _pages_from(self, sections: list[Any], returncode: int | None) -> list[str]:
        elapsed = (time.perf_counter() - self.start_time) * 1000
        head = self.ctx.t('kernel.executor.heading', elapsed=elapsed)
        limit = 4096
        entries = list(sections)
        if returncode is not None:
            entries.append(("result", self.ctx.t('kernel.executor.exit_code', returncode=returncode), False))
        pages: list[str] = []
        cur: list[str] = [head]
        size = _u16(head)
        for entry in entries:
            title, content, is_code = entry[0], entry[1], entry[2]
            lang = entry[3] if len(entry) > 3 else None
            if content is None or content == "":
                continue
            text = str(content)
            overhead = _u16(self._fmt_entry(title, "", is_code, lang))
            i = 0
            n = len(text)
            while i < n:
                space = limit - size - 2
                if space - overhead < 64 and len(cur) > 1:
                    pages.append("\n\n".join(cur))
                    cur = [head]
                    size = _u16(head)
                    continue
                take = min(n - i, max(1, space - overhead))
                block = self._fmt_entry(title, text[i:i + take], is_code, lang)
                while take > 1 and _u16(block) > space:
                    take = max(1, take * max(1, space - overhead) // max(1, _u16(block) - overhead))
                    block = self._fmt_entry(title, text[i:i + take], is_code, lang)
                cur.append(block)
                size += 2 + _u16(block)
                i += take
        pages.append("\n\n".join(cur))
        return pages

    def _nav(self, idx: int) -> list[Any]:
        ui = getattr(self.ctx, "ui", None)
        if ui is None:
            return []
        n = max(len(self._pages), 1)
        if n <= 1:
            return []
        return [
            [
                ui.button("<", self._on_page, (idx - 1) % n),
                ui.button(">", self._on_page, (idx + 1) % n),
            ],
            [ui.button("x", self._on_del)],
        ]

    def _kbd(self, buttons: list[Any] | None) -> dict[str, Any] | None:
        if not buttons:
            return None
        rows: list[list[dict[str, Any]]] = []
        for row in buttons:
            clean: list[dict[str, Any]] = []
            for b in row:
                b = cast('dict[str, Any]', b)
                item = {"text": str(b.get("text", ""))}
                if b.get("callback_data") is not None:
                    item["callback_data"] = b["callback_data"]
                elif b.get("url"):
                    item["url"] = b["url"]
                clean.append(item)
            rows.append(clean)
        return {"inline_keyboard": rows}

    async def _on_page(self, call: Any, payload: Any) -> None:
        n = max(len(self._pages), 1)
        idx = int(payload) % n if payload is not None else 0
        self._page = idx
        text = self._pages[idx] if self._pages else ""
        await call.edit(text, kbd=self._kbd(self._nav(idx)))
        try:
            await call.answer()
        except Exception:
            pass

    async def _on_del(self, call: Any, payload: Any) -> None:
        try:
            await call.answer()
        except Exception:
            pass
        await call.delete()

    async def _deliver(self, text: str, buttons: list[Any] | None, final: bool) -> None:
        kwargs: dict[str, Any] = {"parse_mode": "HTML", "rich": False}
        if buttons:
            kwargs["buttons"] = buttons
        if self.msg:
            kwargs["output"] = "edit"
        try:
            self.msg = await self.ctx.respond(text, **kwargs)
        except Exception:
            if final:
                self.msg = await self.ctx.respond(text, output="reply", parse_mode="HTML", rich=False)

    async def _send(self, sections: list[Any] | None = None, returncode: int | None = None, final: bool = False) -> None:
        async with self._lock:
            if self.closed and not final:
                return
            buffer_str = self.strip_ansi(self.buffer).strip()
            if sections is None:
                sections = [("code" if self.is_py else "command", self.cmd, True)]
                if buffer_str:
                    sections.append(("output", buffer_str[-2800:], True))
                else:
                    sections.append(("output", self.ctx.t('kernel.executor.running'), False))
            if returncode is not None:
                sections = list(sections) + [("result", self.ctx.t('kernel.executor.exit_code', returncode=returncode), False)]
            if final:
                self._pages = self._pages_from(sections, None)
                self._page = 0
                text = self._pages[0]
                buttons = self._nav(0)
            else:
                elapsed = (time.perf_counter() - self.start_time) * 1000
                parts = [self.ctx.t('kernel.executor.heading', elapsed=elapsed)]
                for entry in sections:
                    title, content, is_code = entry[0], entry[1], entry[2]
                    lang = entry[3] if len(entry) > 3 else None
                    if content is None or content == "":
                        continue
                    parts.append(self._fmt_entry(title, content, is_code, lang))
                text = "\n\n".join(parts)
                buttons = None
            await self._deliver(text, buttons, final)

    async def update(self, new_text: str, force: bool = False, wait: bool = False) -> None:
        if self.closed:
            return
        self.buffer += new_text
        now = time.time()
        self._pending = True
        if force or now - self.last_update > 2.0:
            if not self._sending:
                task = asyncio.create_task(self._trigger_send())
                if wait:
                    await task

    async def _trigger_send(self) -> None:
        self._sending = True
        try:
            while self._pending and not self.closed:
                self._pending = False
                self.last_update = time.time()
                try:
                    await self._send()
                except Exception:
                    pass
                if self._pending and not self.closed:
                    await asyncio.sleep(2.0)
        finally:
            self._sending = False

    async def finish(self, sections: list[Any] | None = None, returncode: int | None = None) -> None:
        self.closed = True
        await self._send(sections, returncode=returncode, final=True)


class StreamInterceptor(io.StringIO):
    def __init__(self, updater: OutputUpdater) -> None:
        super().__init__()
        self.updater = updater

    def write(self, s: str) -> int:
        res = super().write(s)
        asyncio.create_task(self.updater.update(s))
        return res


def _get_raw_text(invocation: Any) -> str:
    parsed = getattr(invocation, "raw_args", None)
    if isinstance(parsed, str):
        return parsed
    msg = getattr(invocation, "message", None)
    if msg is None:
        return " ".join(getattr(invocation, "args", []))
    for attr in ("text", "raw_text", "message", "caption"):
        raw = getattr(msg, attr, None)
        if raw is None and hasattr(msg, "get"):
            raw = msg.get(attr)
        if isinstance(raw, str) and raw:
            name = getattr(invocation, "name", "")
            idx = raw.find(name)
            if idx != -1:
                after = raw[idx + len(name):]
                if after and after[0] in " \t":
                    after = after[1:]
                return after
    return " ".join(getattr(invocation, "args", []))


def _msg_id(value: Any) -> Any:
    if value is None:
        return None
    if isinstance(value, dict):
        value = cast('dict[str, Any]', value)
        mid = value.get("id") or value.get("message_id") or value.get("msg_id")
        return int(mid) if isinstance(mid, int) else None
    mid = getattr(value, "id", None) or getattr(value, "message_id", None) or getattr(value, "msg_id", None)
    if callable(mid):
        return None
    return int(mid) if isinstance(mid, int) else None


def _attr_or(obj: Any, *names: Any) -> Any:
    if obj is None:
        return None
    if isinstance(obj, dict):
        for name in names:
            if name in obj:
                return cast(Any, obj[name])
        return None
    for name in names:
        value = getattr(obj, name, None)
        if callable(value) or value is None:
            continue
        return value
    return None


async def _get_reply(ctx: Any, invocation: Any) -> Any:
    source = getattr(ctx, "_source", None)
    header = _msg_field(source, "reply_to")
    if _msg_field(header, "reply_to_peer_id") is not None:
        target = await _MsgProxy(source, ctx=ctx).get_reply_message()
        return target.raw if target is not None else None
    reply = None
    fetch = getattr(ctx, "reply", None)
    if callable(fetch):
        try:
            reply = await cast(Any, fetch())
        except Exception:
            reply = None
    if reply is None:
        for obj in (invocation, ctx):
            for attr in ("reply", "reply_message", "reply_to_message"):
                candidate = _attr_or(obj, attr)
                if callable(candidate):
                    continue
                if candidate is not None:
                    return candidate
    return reply


async def _reply_text(ctx: Any, invocation: Any) -> str | None:
    reply = await _get_reply(ctx, invocation)
    if reply is None:
        return None
    for attr in ("text", "raw_text", "message", "caption"):
        text = getattr(reply, attr, None)
        if isinstance(text, str) and text:
            return text
    if hasattr(reply, "get"):
        for key in ("text", "message", "caption"):
            text = reply.get(key)
            if isinstance(text, str) and text:
                return text
    return None


def _sent_id(result: Any) -> Any:
    if result is None:
        return None
    body = getattr(result, "message", result) if hasattr(result, "delivered") else result
    if isinstance(body, dict):
        body_dict = cast('dict[str, Any]', body)
        body = body_dict.get("result", body_dict)
    sent = extract_sent_message(body)
    if sent is not None:
        mid = sent.get("id")
        if isinstance(mid, int):
            return int(mid)
    if isinstance(result, dict):
        result_dict = cast('dict[str, Any]', result)
        if isinstance(result_dict.get("message_id"), int):
            return int(result_dict["message_id"])
    return _msg_id(body)


_SENTINEL = object()
_SKIP = {"raw", "bytes", "access_hash", "file_reference", "phone", "api_hash", "token", "stripped_thumb"}


def _clean_dict(d: Any) -> Any:
    if not isinstance(d, dict):
        return d
    d = cast('dict[Any, Any]', d)
    cleaned: dict[Any, Any] = {}
    for k, v in d.items():
        if k in _SKIP:
            continue
        if isinstance(v, dict):
            cleaned[k] = _clean_dict(v)
        elif isinstance(v, list):
            cleaned[k] = [_clean_dict(i) if isinstance(i, dict) else i for i in cast('list[Any]', v)]
        else:
            cleaned[k] = v
    return cleaned


def _format_val(v: Any, indent: int = 0, key: str = "") -> str:
    if is_dataclass(v) and not isinstance(v, type):
        type_name = type(v).__name__
        items = [(f.name, getattr(v, f.name)) for f in _dc_fields(v)]
        items = [(k, val) for k, val in items if val is not None]
        if not items:
            return f"{type_name}()"
        lines = [f"{type_name}("]
        for k, val in items:
            lines.append(" " * (indent + 4) + f"{k}={_format_val(val, indent + 4, k)},")
        lines.append(" " * indent + ")")
        return "\n".join(lines)
    if isinstance(v, dict):
        v = _clean_dict(v)
        if not v:
            return "{}"
        type_name = v.get("_", "dict")
        items = [(k, val) for k, val in v.items() if k != "_"]
        if not items:
            return f"{type_name}()"
        lines = [f"{type_name}("]
        for k, val in items:
            lines.append(" " * (indent + 4) + f"{k}={_format_val(val, indent + 4, k)},")
        lines.append(" " * indent + ")")
        return "\n".join(lines)
    if isinstance(v, list):
        if not v:
            return "[]"
        lines = ["["]
        for val in cast('list[Any]', v):
            lines.append(" " * (indent + 4) + f"{_format_val(val, indent + 4)},")
        lines.append(" " * indent + "]")
        return "\n".join(lines)
    if isinstance(v, str):
        return repr(v)
    if isinstance(v, int) and (key == "date" or key.endswith("_date")) and 0 < v < 4000000000:
        try:
            return f"{v} ({time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(v))})"
        except (OverflowError, OSError, ValueError):
            return repr(v)
    return repr(v)


def _dump(v: Any) -> str:
    return _format_val(v)


def _msg_field(value: Any, key: str, default: Any = None) -> Any:
    return value.get(key, default) if hasattr(value, "get") else getattr(value, key, default)


class _MsgProxy:

    def __init__(
        self,
        raw: Any,
        ctx: Any = None,
        invocation: Any = None,
        is_cmd: bool = False,
    ) -> None:
        self.__dict__["_raw"] = raw
        self.__dict__["_ctx"] = ctx
        self.__dict__["_inv"] = invocation
        self.__dict__["_is_cmd"] = is_cmd


    def _g(self, *attrs: str, default: Any = None) -> Any:
        raw = self.__dict__["_raw"]
        if raw is None:
            return default
        for a in attrs:
            v = getattr(raw, a, _SENTINEL)
            if v is not _SENTINEL and v is not None:
                return v
            if hasattr(raw, "get"):
                v = raw.get(a)
                if v is not None:
                    return v
        return default

    def _rich_html(self) -> str:
        raw = self.__dict__["_raw"]
        if raw is None:
            return ""
        rich = None
        if hasattr(raw, "get"):
            rich = raw.get("rich_message") or raw.get("richMessage")
        if not isinstance(rich, dict):
            return ""
        tools = _tools(self.__dict__["_ctx"])
        render = getattr(tools, "rich_to_html", None) if tools is not None else None
        if render is None:
            return ""
        try:
            return render(raw)
        except Exception:
            return ""


    @property
    def plain_text(self) -> str:
        for name in ("text", "raw_text", "message", "caption"):
            value = self._g(name)
            if isinstance(value, str) and value:
                return value
        return ""

    @property
    def text(self) -> str:
        return self.html

    @property
    def html(self) -> str:
        rich = self._rich_html()
        if rich:
            return rich
        plain = self.plain_text
        ents = cast(Any, self._g("entities") or [])
        tools = _tools(self.__dict__["_ctx"])
        conv = getattr(tools, "entities_to_html", None) if tools is not None else None
        if conv is not None:
            return conv(plain, ents)
        return html.escape(plain) if plain else ""

    @property
    def content(self) -> str:
        if self.__dict__["_is_cmd"] and self.__dict__["_inv"]:
            return " ".join(getattr(self.__dict__["_inv"], "args", []))
        return self.text

    @property
    def args(self) -> str:
        return self.content

    @property
    def args_list(self) -> list[str]:
        if self.__dict__["_is_cmd"] and self.__dict__["_inv"]:
            return list(getattr(self.__dict__["_inv"], "args", []))
        return self.text.split()


    @property
    def id(self) -> int | None:
        return self._g("id", "message_id", "msg_id")

    @property
    def msg_id(self) -> int | None:
        return self.id

    @property
    def chat_id(self) -> int | None:
        value = self._g("chat_id", "peer_id", "chat")
        if value is None:
            source = getattr(self.__dict__["_ctx"], "_source", None)
            value = _msg_field(source, "chat_id") or _msg_field(source, "peer_id")
        return self._peer_id(value)

    @property
    def user_id(self) -> int | None:
        return self._peer_id(self._g("from_id", "sender_id", "user_id"))

    @property
    def from_id(self) -> int | None:
        return self.user_id


    @property
    def first_name(self) -> str:
        return self._g("first_name") or ""

    @property
    def last_name(self) -> str:
        return self._g("last_name") or ""

    @property
    def full_name(self) -> str:
        name = f"{self.first_name} {self.last_name}".strip()
        return name or self.username or str(self.user_id or "?")

    @property
    def name(self) -> str:
        return self.full_name

    @property
    def username(self) -> str | None:
        return self._g("username")

    @property
    def mention(self) -> str:
        uid = self.user_id
        display = html.escape(self.full_name)
        if uid:
            return f'<a href="tg://user?id={uid}">{display}</a>'
        if self.username:
            return f"@{self.username}"
        return display


    @property
    def is_me(self) -> bool:
        return bool(self._g("out") or self._g("is_me"))

    @property
    def out(self) -> bool:
        return self.is_me

    @property
    def date(self) -> Any:
        return self._g("date")

    @property
    def src(self) -> str | None:
        return self._g("src", "source")


    @property
    def has_media(self) -> bool:
        return self._g("media") is not None or any(self._g(k) is not None for k in ("photo", "document", "video", "audio", "voice", "sticker", "animation"))

    @property
    def media(self) -> Any:
        return self._g("media")

    @property
    def photo(self) -> Any:
        return self._g("photo") or _msg_field(self.media, "photo")

    @property
    def document(self) -> Any:
        return self._g("document") or _msg_field(self.media, "document")

    @property
    def video(self) -> Any:
        return self._g("video")

    @property
    def audio(self) -> Any:
        return self._g("audio")

    @property
    def voice(self) -> Any:
        return self._g("voice")

    @property
    def sticker(self) -> Any:
        return self._g("sticker")

    @property
    def animation(self) -> Any:
        return self._g("animation")


    @property
    def topic_id(self) -> int | None:
        explicit = self._g("topic_id", "message_thread_id", "top_msg_id")
        if isinstance(explicit, int) and explicit > 0:
            return explicit
        header = self._g("reply_to")
        top = _msg_field(header, "reply_to_top_id")
        if isinstance(top, int) and top > 0:
            return top
        if _msg_field(header, "forum_topic"):
            return _msg_field(header, "reply_to_msg_id")
        action = self._g("action")
        return self.id if _msg_field(action, "_") == "messageActionTopicCreate" else None


    @property
    def raw(self) -> Any:
        return self.__dict__["_raw"]

    def get(self, key: str, default: Any = None) -> Any:
        raw = self.__dict__["_raw"]
        if hasattr(raw, "get"):
            return raw.get(key, default)
        return getattr(raw, key, default)

    def __getattr__(self, name: str) -> Any:
        value = self._g(name, default=_SENTINEL)
        if value is not _SENTINEL:
            return value
        raise AttributeError(f"MsgProxy has no attribute {name!r}")

    def __bool__(self) -> bool:
        return self.__dict__.get("_raw") is not None

    def __repr__(self) -> str:
        raw = self.__dict__.get("_raw")
        if raw is None:
            return "MsgProxy(empty)"
        data: dict[str, Any] = {}
        if hasattr(raw, "items"):
            data = dict(cast('dict[str, Any]', raw))
        elif hasattr(raw, "__dict__"):
            data = {k: v for k, v in cast('dict[str, Any]', vars(raw)).items() if not k.startswith("_")}
        data = _clean_dict(data)
        if "id" not in data and self.id is not None:
            data["id"] = self.id
        rich_html = self._rich_html()
        if rich_html:
            data["html"] = rich_html
        plain = self.plain_text
        if plain and "text" not in data and "message" not in data:
            data["text"] = plain
        lines = ["Message("]
        for k, v in data.items():
            if v is not None and v != {} and v != []:
                lines.append(f"    {k}={_format_val(v, 4, k)},")
        lines.append(")")
        return "\n".join(lines)


    def as_mention(self, name: str | None = None) -> str:
        uid = self.user_id
        display = html.escape(name or self.full_name)
        return f'<a href="tg://user?id={uid}">{display}</a>' if uid else display

    def fmt_text(self, text: str | None = None) -> str:
        return html.escape(str(text if text is not None else self.text))


    def _app(self) -> Any:
        ctx = self.__dict__["_ctx"]
        source = getattr(ctx, "_source", None)
        if (self.src or _msg_field(source, "src", "mt")) != "mt":
            raise ValueError("executor message operations require an MTProto message")
        app = getattr(getattr(ctx, "runtime", None), "app", None)
        if app is None:
            raise RuntimeError("message client is unavailable")
        self._target()
        return app

    def _target(self) -> tuple[int, int]:
        chat, mid = self.chat_id, self.id
        if not isinstance(chat, int) or not isinstance(mid, int) or mid <= 0:
            raise ValueError("message has no concrete peer/message identity")
        return chat, mid

    @staticmethod
    def _peer_id(value: Any) -> int | None:
        if isinstance(value, int):
            return value
        for key, prefix in (("channel_id", -1000000000000), ("chat_id", 0), ("user_id", None), ("id", None)):
            ident = _msg_field(value, key)
            if isinstance(ident, int):
                return ident if prefix is None else prefix - ident
        return None

    async def _rpc(self, method: str, **kwargs: Any) -> Any:
        result = await self._app().mt_req(method, **kwargs)
        if _msg_field(result, "ok") is False:
            raise RuntimeError(f"{method}: {_msg_field(result, 'error', 'RPC failed')}")
        return result

    async def _on_message(self, method: str, *, id_key: str = "msg_id", **kwargs: Any) -> Any:
        if "peer" in kwargs or id_key in kwargs:
            raise ValueError("a message operation cannot override its target")
        return await self._rpc(method, peer=await self.get_input_chat(), **{id_key: self.id}, **kwargs)

    def _send_options(self, kwargs: dict[str, Any], *, reply: bool = False) -> dict[str, Any]:
        data = dict(kwargs)
        for key in ("chat_id", "peer", "message_id", "msg_id", "id", "via"):
            if key in data:
                raise ValueError(f"{key} cannot override this message's target")
        topic = data.pop("topic_id", self.topic_id)
        target = data.pop("reply_to", self.id if reply else topic)
        if reply and target != self.id:
            raise ValueError("reply must target this message")
        if target is not None:
            if isinstance(target, int):
                target = {"_": "inputReplyToMessage", "reply_to_msg_id": target}
            elif isinstance(target, dict):
                target = dict(cast('dict[str, Any]', target))
            else:
                raise TypeError("reply_to must be a message ID or InputReplyToMessage")
            if topic is not None:
                target["top_msg_id"] = topic
            data["reply_to"] = target
        if "buttons" in data:
            data["kbd"] = data.pop("buttons")
        if isinstance(data.get("kbd"), list):
            data["kbd"] = {"inline_keyboard": data["kbd"]}
        if "link_preview" in data:
            data["no_webpage"] = not data.pop("link_preview")
        return data

    async def respond(self, text: str, **kwargs: Any) -> Any:
        kwargs.setdefault("parse_mode", "html")
        return await self._app().send_msg(self.chat_id, text, via="mt", **self._send_options(kwargs))

    async def edit(self, text: str, **kwargs: Any) -> Any:
        data = self._send_options(kwargs)
        data.pop("reply_to", None)
        data.setdefault("parse_mode", "html")
        return await self._app().edit_msg(self.chat_id, self.id, text, via="mt", **data)

    async def reply(self, text: str, **kwargs: Any) -> Any:
        kwargs.setdefault("parse_mode", "html")
        return await self._app().send_msg(self.chat_id, text, via="mt", **self._send_options(kwargs, reply=True))

    async def answer(self, text: str, **kwargs: Any) -> Any:
        return await (self.edit(text, **kwargs) if self.out else self.reply(text, **kwargs))

    async def delete(self, revoke: bool = True) -> Any:
        from relay.rpc import delete_chat_msg
        chat, mid = self._target()
        return await delete_chat_msg(self._app(), chat, mid, revoke=revoke)

    async def pin(self, both_sides: bool | None = None, *, notify: bool = False, pm_oneside: bool = False) -> Any:
        return await self._on_message("messages.updatePinnedMessage", id_key="id", silent=not notify, pm_oneside=pm_oneside if both_sides is None else not both_sides)

    async def unpin(self) -> Any:
        return await self._on_message("messages.updatePinnedMessage", id_key="id", unpin=True)

    async def forward(self, to_chat: Any, **kwargs: Any) -> Any:
        topic = kwargs.pop("topic_id", self.topic_id if to_chat == self.chat_id else None)
        if topic is not None:
            kwargs["top_msg_id"] = topic
        return await self._app().forward_msg(self.chat_id, self.id, to=to_chat, via="mt", **kwargs)

    async def forward_to(self, to_chat: Any, **kwargs: Any) -> Any:
        return await self.forward(to_chat, **kwargs)

    async def copy_to(self, to_chat: Any, **kwargs: Any) -> Any:
        kwargs["drop_author"] = True
        return await self.forward(to_chat, **kwargs)

    async def react(self, emoji: Any, **kwargs: Any) -> Any:
        values = cast("list[Any]", emoji) if isinstance(emoji, list) else [emoji] if emoji else []
        reactions = [{"_": "reactionEmoji", "emoticon": v} if isinstance(v, str) else {"_": "reactionCustomEmoji", "document_id": v} if isinstance(v, int) else v for v in values]
        return await self._on_message("messages.sendReaction", reaction=reactions, **kwargs)

    async def unreact(self) -> Any:
        return await self.react([])

    async def get_sender(self) -> Any:
        uid = self.user_id
        if uid is None:
            return None
        return await self.__dict__["_ctx"].resolve(uid)

    async def get_chat(self) -> Any:
        return await self._app().get_chat(self.chat_id, via="mt")

    async def get_input_chat(self) -> Any:
        return await self._app().mt.resolve_peer(self.chat_id)

    async def get_input_sender(self) -> Any:
        return await self._app().mt.resolve_peer(self.user_id) if self.user_id is not None else None

    @staticmethod
    def _input_entity(peer: Any, kind: str) -> dict[str, Any]:
        if isinstance(peer, bytes):
            from goygram import ext
            peer = ext.deserialize_constructor(peer)
        data = dict(cast("dict[str, Any]", peer))
        ctor = str(data.get("_", ""))
        allowed = {"inputPeerChannel": "inputChannel", "inputPeerChannelFromMessage": "inputChannelFromMessage"} if kind == "channel" else {"inputPeerUser": "inputUser", "inputPeerUserFromMessage": "inputUserFromMessage", "inputPeerSelf": "inputUserSelf"}
        if ctor not in allowed:
            raise ValueError(f"message peer is not a {kind}")
        data["_"] = allowed[ctor]
        return data

    async def get_input_channel(self) -> Any:
        return self._input_entity(await self.get_input_chat(), "channel")

    async def download(self, destination: Any = None, **kwargs: Any) -> Any:
        if not self.has_media:
            raise ValueError("this message has no media")
        if destination is None:
            import tempfile
            fd, destination = tempfile.mkstemp(prefix="hotaru-executor-")
            os.close(fd)
        return await self.__dict__["_ctx"].download_file(self.raw, destination, **kwargs)

    async def download_media(self, destination: Any = None, **kwargs: Any) -> Any:
        return await self.download(destination, **kwargs)

    async def read(self) -> Any:
        if self.topic_id is not None:
            return await self._rpc("messages.readDiscussion", peer=await self.get_input_chat(), msg_id=self.topic_id, read_max_id=self.id)
        if self.chat_id is not None and self.chat_id < -1000000000000:
            return await self._rpc("channels.readHistory", channel=await self.get_input_channel(), max_id=self.id)
        return await self._rpc("messages.readHistory", peer=await self.get_input_chat(), max_id=self.id)

    async def mark_read(self) -> Any:
        return await self.read()

    async def read_contents(self) -> Any:
        if self.chat_id is not None and self.chat_id < -1000000000000:
            return await self._rpc("channels.readMessageContents", channel=await self.get_input_channel(), id=[self.id])
        return await self._rpc("messages.readMessageContents", id=[self.id])

    async def get_reply_message(self) -> Any:
        header = self._g("reply_to")
        mid = self._g("reply_to_msg_id") or _msg_field(header, "reply_to_msg_id")
        direct = self._g("reply_to_message", "reply_msg")
        if direct is not None:
            if isinstance(direct, dict):
                direct = {"chat_id": self.chat_id, **cast("dict[str, Any]", direct)}
            return _MsgProxy(direct, self.__dict__["_ctx"])
        if not mid:
            return None
        peer = self._peer_id(_msg_field(header, "reply_to_peer_id")) or self.chat_id
        raw = await self.__dict__["_ctx"].msg(peer, mid)
        if raw is None:
            return None
        if isinstance(raw, dict):
            raw = {"chat_id": peer, **cast('dict[str, Any]', raw)}
        return _MsgProxy(raw, self.__dict__["_ctx"])

    async def refresh(self) -> "_MsgProxy":
        chat, mid = self._target()
        raw = await self.__dict__["_ctx"].msg(chat, mid)
        if raw is None:
            raise LookupError("message no longer exists or is inaccessible")
        self.__dict__["_raw"] = {"chat_id": chat, **cast('dict[str, Any]', raw)} if isinstance(raw, dict) else raw
        return self

    async def get_buttons(self) -> list[list[Any]]:
        return self.buttons

    @property
    def buttons(self) -> list[list[Any]]:
        markup = self._g("reply_markup")
        rows: Any = _msg_field(markup, "rows") or _msg_field(markup, "inline_keyboard") or _msg_field(markup, "keyboard") or []
        return [[_MsgButton(self, button) for button in (cast("list[Any]", row) if isinstance(row, list) else _msg_field(row, "buttons", []))] for row in rows]

    @property
    def button_count(self) -> int:
        return sum(len(row) for row in self.buttons)

    async def click(self, i: Any = None, j: int | None = None, *, text: Any = None, filter: Any = None, data: Any = None, share_phone: Any = None, share_geo: Any = None, password: Any = None, open_url: bool = False) -> Any:
        if data is not None:
            return await self.click_button({"_": "keyboardButtonCallback", "data": data}, password=password)
        if sum(value is not None for value in (i, text, filter)) > 1:
            raise ValueError("select only one of i, text or filter")
        if j is not None and (text is not None or filter is not None or isinstance(i, (list, tuple))):
            raise ValueError("j requires a row index")
        poll = _msg_field(self.media, "poll") or self._g("poll")
        answers: Any = _msg_field(poll, "answers", [])
        if poll is not None:
            if j is not None:
                raise ValueError("poll options have no columns")
            if i is not None:
                indices = cast("list[Any]", i) if isinstance(i, (list, tuple)) else [i]
                selected = [answers[index] for index in indices]
            else:
                selected = cast("list[Any]", [])
                for answer in answers:
                    label = _msg_field(answer, "text")
                    label = _msg_field(label, "text", label)
                    if (filter(_MsgButton(self, answer)) if filter is not None else text(label) if callable(text) else text is not None and label == text):
                        selected.append(answer)
                        break
            return await self.vote([_msg_field(a, "option") for a in selected])
        rows = self.buttons
        flat = [button for row in rows for button in row]
        if not flat:
            return None
        if text is not None:
            button = next((b for b in flat if (text(b.text) if callable(text) else b.text == text)), None)
        elif filter is not None:
            button = next((b for b in flat if filter(b)), None)
        else:
            button = rows[i or 0][j] if j is not None else flat[0 if i is None else i]
        return await button.click(share_phone=share_phone, share_geo=share_geo, password=password, open_url=open_url) if button else None

    async def click_button(self, button: Any, *, share_phone: Any = None, share_geo: Any = None, password: Any = None, open_url: bool = False) -> Any:
        kind = _msg_field(button, "type", button)
        ctor = str(_msg_field(kind, "_", ""))
        data = _msg_field(kind, "data", _msg_field(button, "callback_data"))
        if data is not None or ctor in {"keyboardButtonGame", "inlineButtonTypeGame"}:
            args: dict[str, Any] = {"game": True} if data is None else {"data": data.encode() if isinstance(data, str) else data}
            if password is not None:
                if isinstance(password, str):
                    from goygram.transports import mtproto
                    state = await self._rpc("account.getPassword")
                    state = _msg_field(state, "result", state)
                    srp_id, a, m1 = getattr(mtproto, "_compute_password_check")(state, password)
                    password = {"_": "inputCheckPasswordSRP", "srp_id": srp_id, "A": a, "M1": m1}
                args["password"] = password
            return await self._on_message("messages.getBotCallbackAnswer", **args)
        url = _msg_field(kind, "url", _msg_field(button, "url"))
        if url is not None and ctor not in {"keyboardButtonUrlAuth", "inlineButtonTypeUrlAuth"}:
            if open_url:
                import webbrowser
                return webbrowser.open(str(url))
            return url
        if ctor in {"keyboardButtonRequestPhone", "buttonTypeRequestPhone"} or _msg_field(button, "request_contact"):
            if not share_phone:
                raise ValueError("share_phone must be explicit")
            if isinstance(share_phone, dict):
                return await self.reply_media(share_phone)
            me = await self._app().get_me()
            phone = _msg_field(me, "phone") if share_phone is True else share_phone
            return await self.reply_contact(phone, _msg_field(me, "first_name", ""), last_name=_msg_field(me, "last_name", ""))
        if ctor in {"keyboardButtonRequestGeoLocation", "buttonTypeRequestGeoLocation"} or _msg_field(button, "request_location"):
            if share_geo is None:
                raise ValueError("share_geo=(longitude, latitude) must be explicit")
            if isinstance(share_geo, (tuple, list)):
                longitude, latitude = cast('Any', share_geo)
                return await self.reply_location(latitude, longitude)
            geo = share_geo if _msg_field(share_geo, "_") == "inputMediaGeoPoint" else {"_": "inputMediaGeoPoint", "geo_point": share_geo}
            return await self.reply_media(geo)
        if ctor in {"keyboardButtonSwitchInline", "inlineButtonTypeSwitchInline"} or _msg_field(button, "switch_inline_query") is not None or _msg_field(button, "switch_inline_query_current_chat") is not None:
            bot = self._g("via_bot_id") or self.user_id
            query = _msg_field(kind, "query", _msg_field(button, "switch_inline_query", _msg_field(button, "switch_inline_query_current_chat", "")))
            import secrets
            return await self._rpc("messages.startBot", bot=self._input_entity(await self._app().mt.resolve_peer(bot), "user"), peer=await self.get_input_chat(), random_id=secrets.randbits(63), start_param=query)
        if ctor in {"keyboardButton", "buttonTypeDefault"} or not ctor and (isinstance(button, str) or isinstance(button, dict) and set(cast("dict[str, Any]", button)) <= {"text"}):
            return await self.reply(button if isinstance(button, str) else _msg_field(button, "text", ""))
        raise NotImplementedError(f"click is not supported for {ctor or 'this button type'}")

    async def vote(self, options: Any) -> Any:
        answers = _msg_field(_msg_field(self.media, "poll") or self._g("poll"), "answers", [])
        values = cast("list[Any]", options) if isinstance(options, (list, tuple)) else [options]
        selected = [_msg_field(answers[v], "option") if isinstance(v, int) else v for v in values]
        return await self._on_message("messages.sendVote", options=selected)

    async def retract_vote(self) -> Any:
        return await self.vote([])

    async def get_poll_results(self) -> Any:
        return await self._on_message("messages.getPollResults", poll_hash=0)

    async def get_poll_votes(self, *, option: bytes | None = None, offset: str | None = None, limit: int = 100) -> Any:
        return await self._on_message("messages.getPollVotes", id_key="id", option=option, offset=offset, limit=limit)

    async def get_reactions(self) -> Any:
        return await self._rpc("messages.getMessagesReactions", peer=await self.get_input_chat(), id=[self.id])

    async def get_reactors(self, *, reaction: Any = None, offset: str | None = None, limit: int = 100) -> Any:
        if isinstance(reaction, str):
            reaction = {"_": "reactionEmoji", "emoticon": reaction}
        return await self._on_message("messages.getMessageReactionsList", id_key="id", reaction=reaction, offset=offset, limit=limit)

    async def translate(self, to_lang: str) -> Any:
        return await self._rpc("messages.translateText", peer=await self.get_input_chat(), id=[self.id], to_lang=to_lang)

    async def get_views(self, increment: bool = False) -> Any:
        return await self._rpc("messages.getMessagesViews", peer=await self.get_input_chat(), id=[self.id], increment=increment)

    async def get_replies(self, *, offset_id: int = 0, limit: int = 100, **kwargs: Any) -> Any:
        data: dict[str, Any] = {"offset_id": offset_id, "offset_date": 0, "add_offset": 0, "limit": limit, "max_id": 0, "min_id": 0, "hash": 0, **kwargs}
        return await self._on_message("messages.getReplies", **data)

    async def get_discussion(self) -> Any:
        return await self._on_message("messages.getDiscussionMessage")

    async def get_link(self, *, grouped: bool = False, thread: bool = False) -> str:
        if self.chat_id is not None and self.chat_id < -1000000000000:
            result = await self._rpc("channels.exportMessageLink", channel=await self.get_input_channel(), id=self.id, grouped=grouped, thread=thread)
            return str(_msg_field(_msg_field(result, "result", result), "link", ""))
        chat, mid = self._target()
        return f"tg://openmessage?{'user_id' if chat > 0 else 'chat_id'}={abs(chat)}&message_id={mid}"

    async def edit_buttons(self, buttons: Any = None) -> Any:
        from goygram.types.kbd import kbd_to_tl
        if isinstance(buttons, list):
            buttons = {"inline_keyboard": cast("list[Any]", buttons)}
        markup: dict[str, Any] | None = kbd_to_tl(buttons) if buttons else {"_": "replyInlineMarkup", "rows": []}
        if markup is None:
            raise ValueError("invalid button markup")
        return await self._on_message("messages.editMessage", id_key="id", reply_markup=markup)

    async def remove_buttons(self) -> Any:
        return await self.edit_buttons()

    async def edit_caption(self, caption: str, **kwargs: Any) -> Any:
        return await self.edit(caption, **kwargs)

    async def _prepare_media(self, media: Any, kind: str, file_name: str | None = None) -> Any:
        from relay.files import document
        self._app()
        if kind not in {"document", "photo", "video", "audio", "voice", "animation", "sticker"}:
            raise ValueError("unsupported media kind")
        if isinstance(media, _MsgProxy):
            media = media.media
        wrapped = _msg_field(media, "media")
        if wrapped is not None:
            media = wrapped
        ctor = str(_msg_field(media, "_", ""))
        if ctor.startswith("inputMedia"):
            return media
        for name in ("photo", "document"):
            item = _msg_field(media, name) or (media if ctor in {name, "input" + name.title()} else None)
            if item is not None:
                ref = {"_": "input" + name.title(), **{key: _msg_field(item, key) for key in ("id", "access_hash", "file_reference")}}
                return {"_": "inputMedia" + name.title(), "id": ref}
        if ctor:
            raise ValueError(f"cannot send {ctor} as InputMedia")
        if isinstance(media, str) and media.startswith(("https://", "http://")):
            return {"_": "inputMediaPhotoExternal" if kind == "photo" else "inputMediaDocumentExternal", "url": media}
        import mimetypes
        from goygram.sugar import media_duration
        up = await self.__dict__["_ctx"].upload_file(media, file_name=file_name)
        mime = mimetypes.guess_type(str(file_name or up.get("name", "")))[0]
        if not mime or mime == "application/octet-stream":
            mime = {"voice": "audio/ogg", "audio": "audio/mpeg", "video": "video/mp4", "animation": "video/mp4", "sticker": "image/webp"}.get(kind, "application/octet-stream")
        payload = document(up, mime=mime, file_name=file_name, force_file=kind == "document")
        if kind == "photo":
            return {"_": "inputMediaUploadedPhoto", "file": payload["file"]}
        attrs: Any = payload["attributes"]
        duration = media_duration(os.fspath(media)) if isinstance(media, (str, os.PathLike)) and kind in {"audio", "voice", "video"} else 0
        if kind in {"audio", "voice"}:
            attrs.append({"_": "documentAttributeAudio", "voice": kind == "voice", "duration": duration or 0})
        elif kind == "video":
            attrs.append({"_": "documentAttributeVideo", "duration": duration or 0, "w": 0, "h": 0, "supports_streaming": True})
        elif kind == "animation":
            attrs.append({"_": "documentAttributeAnimated"})
        elif kind == "sticker":
            attrs.append({"_": "documentAttributeSticker", "alt": "", "stickerset": {"_": "inputStickerSetEmpty"}})
            payload["mime_type"] = "image/webp" if mime == "application/octet-stream" else mime
        return payload

    async def edit_media(self, media: Any, *, caption: str | None = None, kind: str = "document", **kwargs: Any) -> Any:
        from goygram.sugar import html_to_entities, md_to_entities
        data = self._send_options(kwargs)
        data.pop("reply_to", None)
        media = await self._prepare_media(media, kind, data.pop("file_name", None))
        mode = str(data.pop("parse_mode", "html")).lower()
        if "kbd" in data:
            from goygram.types.kbd import kbd_to_tl
            data["reply_markup"] = kbd_to_tl(data.pop("kbd"))
        if caption is not None:
            if mode in {"html", "md"}:
                caption, data["entities"] = (html_to_entities if mode == "html" else md_to_entities)(caption)
            data["message"] = caption
        return await self._on_message("messages.editMessage", id_key="id", media=media, **data)

    async def send_media(self, media: Any, caption: str | None = None, *, kind: str = "document", **kwargs: Any) -> Any:
        from goygram.sugar import html_to_entities, md_to_entities
        data = self._send_options(kwargs)
        media = await self._prepare_media(media, kind, data.pop("file_name", None))
        mode = str(data.pop("parse_mode", "html")).lower()
        if caption is not None and mode in {"html", "md"}:
            caption, data["entities"] = (html_to_entities if mode == "html" else md_to_entities)(caption)
        return await self._app().send_media(self.chat_id, media, kind, caption, via="mt", **data)

    async def reply_media(self, media: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.send_media(media, caption, **self._send_options(kwargs, reply=True))

    async def send_file(self, file: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.send_media(file, caption, **kwargs)

    async def reply_file(self, file: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.reply_media(file, caption, **kwargs)

    async def send_photo(self, photo: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.send_media(photo, caption, kind="photo", **kwargs)

    async def reply_photo(self, photo: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.reply_media(photo, caption, kind="photo", **kwargs)

    async def send_video(self, video: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.send_media(video, caption, kind="video", **kwargs)

    async def reply_video(self, video: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.reply_media(video, caption, kind="video", **kwargs)

    async def send_audio(self, audio: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.send_media(audio, caption, kind="audio", **kwargs)

    async def reply_audio(self, audio: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.reply_media(audio, caption, kind="audio", **kwargs)

    async def send_voice(self, voice: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.send_media(voice, caption, kind="voice", **kwargs)

    async def reply_voice(self, voice: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.reply_media(voice, caption, kind="voice", **kwargs)

    async def send_animation(self, animation: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.send_media(animation, caption, kind="animation", **kwargs)

    async def reply_animation(self, animation: Any, caption: str | None = None, **kwargs: Any) -> Any:
        return await self.reply_media(animation, caption, kind="animation", **kwargs)

    async def send_sticker(self, sticker: Any, **kwargs: Any) -> Any:
        return await self.send_media(sticker, kind="sticker", **kwargs)

    async def reply_sticker(self, sticker: Any, **kwargs: Any) -> Any:
        return await self.reply_media(sticker, kind="sticker", **kwargs)

    async def send_contact(self, phone: str, first_name: str, *, last_name: str = "", **kwargs: Any) -> Any:
        return await self.send_media({"_": "inputMediaContact", "phone_number": phone, "first_name": first_name, "last_name": last_name, "vcard": ""}, **kwargs)

    async def reply_contact(self, phone: str, first_name: str, **kwargs: Any) -> Any:
        return await self.send_contact(phone, first_name, **self._send_options(kwargs, reply=True))

    async def send_location(self, latitude: float, longitude: float, **kwargs: Any) -> Any:
        return await self.send_media({"_": "inputMediaGeoPoint", "geo_point": {"_": "inputGeoPoint", "lat": latitude, "long": longitude}}, **kwargs)

    async def reply_location(self, latitude: float, longitude: float, **kwargs: Any) -> Any:
        return await self.send_location(latitude, longitude, **self._send_options(kwargs, reply=True))

    async def send_dice(self, emoji: str = "🎲", **kwargs: Any) -> Any:
        return await self.send_media({"_": "inputMediaDice", "emoticon": emoji}, **kwargs)

    async def reply_dice(self, emoji: str = "🎲", **kwargs: Any) -> Any:
        return await self.send_dice(emoji, **self._send_options(kwargs, reply=True))

    async def send_rich(self, rich: Any, **kwargs: Any) -> Any:
        from goygram.rich import Rich
        payload = rich.to_tl() if isinstance(rich, Rich) else {"_": "inputRichMessageHTML", "html": rich} if isinstance(rich, str) else rich
        return await self.respond("", rich_message=payload, **kwargs)

    async def reply_rich(self, rich: Any, **kwargs: Any) -> Any:
        return await self.send_rich(rich, **self._send_options(kwargs, reply=True))

    async def edit_rich(self, rich: Any, **kwargs: Any) -> Any:
        data = self._send_options(kwargs)
        data.pop("reply_to", None)
        return await self._app().edit_rich(self.chat_id, self.id, rich, via="mt", **data)

    async def save(self, **kwargs: Any) -> Any:
        return await self.forward("me", **kwargs)

    async def schedule(self, text: str, when: int, **kwargs: Any) -> Any:
        return await self.respond(text, schedule_date=when, **kwargs)

    async def typing(self, action: str = "sendMessageTypingAction") -> Any:
        return await self._rpc("messages.setTyping", peer=await self.get_input_chat(), top_msg_id=self.topic_id, action={"_": action})

    def to_dict(self) -> dict[str, Any]:
        raw = self.raw
        if hasattr(raw, "to_dict"):
            return dict(raw.to_dict())
        if hasattr(raw, "items"):
            return dict(raw.items())
        return dict(cast("dict[str, Any]", vars(raw)))

    def stringify(self) -> str:
        return repr(self)


class _MsgButton:
    def __init__(self, message: _MsgProxy, raw: Any) -> None:
        self.message = message
        self.raw = raw

    @property
    def text(self) -> str:
        text = self.raw if isinstance(self.raw, str) else _msg_field(self.raw, "text", "")
        return str(_msg_field(text, "text", text))

    def get(self, key: str, default: Any = None) -> Any:
        return _msg_field(self.raw, key, default)

    def __getitem__(self, key: str) -> Any:
        value = self.get(key, _SENTINEL)
        if value is _SENTINEL:
            raise KeyError(key)
        return value

    def __getattr__(self, key: str) -> Any:
        value = _msg_field(self.__dict__.get("raw"), key, _SENTINEL)
        if value is _SENTINEL:
            raise AttributeError(key)
        return value

    @property
    def data(self) -> Any:
        kind = _msg_field(self.raw, "type", self.raw)
        return _msg_field(kind, "data", _msg_field(self.raw, "callback_data"))

    @property
    def url(self) -> Any:
        return _msg_field(_msg_field(self.raw, "type", self.raw), "url")

    async def click(self, **kwargs: Any) -> Any:
        return await self.message.click_button(self.raw, **kwargs)

class _DBProxy:

    def __init__(self, state: Any, module_id: str = "executor") -> None:
        if state is None:
            raise RuntimeError("executor state is unavailable")
        ns = state.namespace(module_id) if hasattr(state, "namespace") else state
        self.__dict__["_ns"] = ns
        self.__dict__["_raw_state"] = state

    def _ns(self) -> Any:
        return self.__dict__["_ns"]


    def get(self, key: str, default: Any = None) -> Any:
        ns = self.__dict__["_ns"]
        return ns.get(key, default)

    def set(self, key: str, value: Any) -> None:
        ns = self.__dict__["_ns"]
        ns.set(key, value)

    def delete(self, key: str) -> bool:
        ns = self.__dict__["_ns"]
        return bool(ns.delete(key))

    def has(self, key: str) -> bool:
        ns = self.__dict__["_ns"]
        return ns.get(key) is not None

    def keys(self) -> tuple[str, ...]:
        ns = self.__dict__["_ns"]
        return ns.keys()

    def all(self) -> dict[str, Any]:
        return {k: self.get(k) for k in self.keys()}

    def update(self, data: dict[str, Any]) -> None:
        for k, v in data.items():
            self.set(k, v)

    def clear(self) -> None:
        for k in self.keys():
            self.delete(k)

    def incr(self, key: str, by: int | float = 1, default: int | float = 0) -> int | float:
        current = self.get(key, default)
        new_val = (current or 0) + by
        self.set(key, new_val)
        return new_val

    def append(self, key: str, item: Any, max_len: int | None = None) -> list[Any]:
        lst = self.get(key, [])
        if not isinstance(lst, list):
            lst = [lst]
        lst = cast('list[Any]', lst)
        lst.append(item)
        if max_len is not None:
            lst = lst[-max_len:]
        self.set(key, lst)
        return lst

    def pointer(self, key: str, default: Any = None) -> Any:
        ns = self.__dict__["_ns"]
        if ns is not None and hasattr(ns, "pointer"):
            return ns.pointer(key, default)
        raise AttributeError("pointer() requires a StateNamespace backend")


    def __getitem__(self, key: str) -> Any:
        v = self.get(key, _SENTINEL)
        if v is _SENTINEL:
            raise KeyError(key)
        return v

    def __setitem__(self, key: str, value: Any) -> None:
        self.set(key, value)

    def __delitem__(self, key: str) -> None:
        self.delete(key)

    def __contains__(self, key: str) -> bool:
        return self.has(key)

    def __len__(self) -> int:
        return len(self.keys())

    def __iter__(self) -> Any:
        return iter(self.keys())

    def __repr__(self) -> str:
        return f"<DB keys={list(self.keys())}>"

    def ns(self, module_id: str) -> "_DBProxy":
        return _DBProxy(self.__dict__["_raw_state"], module_id)


def _build_py_helpers(ctx: Any, invocation: Any, reply: Any) -> dict[str, Any]:
    source = getattr(ctx, "_source", None)
    state = getattr(ctx, "state", None)

    m_proxy = _MsgProxy(source, ctx=ctx, invocation=invocation, is_cmd=True)
    r_proxy = _MsgProxy(reply, ctx=ctx, invocation=invocation, is_cmd=False) if reply else None
    db_proxy = _DBProxy(state)

    def _attr_or(obj: Any, *attrs: Any, default: Any=None) -> Any:
        for a in attrs:
            v = getattr(obj, a, None)
            if v is not None:
                return v
            if hasattr(obj, "get"):
                v = obj.get(a)
                if v is not None:
                    return v
        return default


    def get_text(msg: Any=None) -> str | None:
        if msg is not None:
            if hasattr(msg, "html"):
                html_text = msg.html
            else:
                html_text = _attr_or(msg, "text", "raw_text", "message", "caption")
            return html_text or None
        if r_proxy:
            return r_proxy.html or None
        return m_proxy.content or None

    def get_reply_text() -> str | None:
        return (r_proxy.html if r_proxy else None) or None

    def get_args() -> str:
        return m_proxy.args

    def get_args_list() -> list[str]:
        return m_proxy.args_list

    def get_chat_id(msg: Any=None) -> int | None:
        if msg is not None:
            return _attr_or(msg, "chat_id", "peer_id", "chat")
        return m_proxy.chat_id

    def get_user_id(msg: Any=None) -> int | None:
        if msg is not None:
            return _attr_or(msg, "from_id", "sender_id", "user_id")
        return m_proxy.user_id

    def get_msg_id(msg: Any=None) -> int | None:
        if msg is not None:
            return _attr_or(msg, "id", "message_id")
        return m_proxy.id

    def get_reply_id() -> int | None:
        return r_proxy.id if r_proxy else None

    def is_reply() -> bool:
        return r_proxy is not None

    def is_me() -> bool:
        return m_proxy.is_me

    def has_media(msg: Any=None) -> bool:
        if msg is not None:
            return _attr_or(msg, "media") is not None
        return m_proxy.has_media

    def get_media(msg: Any=None) -> Any:
        if msg is not None:
            return _attr_or(msg, "media", "photo", "document", "video", "audio")
        return m_proxy.media

    def get_sender_name(msg: Any=None) -> str | None:
        if msg is not None:
            first = _attr_or(msg, "first_name") or ""
            last = _attr_or(msg, "last_name") or ""
            full = f"{first} {last}".strip()
            return full or _attr_or(msg, "username")
        return m_proxy.full_name

    def get_username(msg: Any=None) -> str | None:
        if msg is not None:
            return _attr_or(msg, "username")
        return m_proxy.username


    async def get_entity(peer: Any) -> Any:
        tg = getattr(ctx, "tg", None)
        if tg is None:
            raise RuntimeError("tg gateway unavailable")
        return await tg.get_entity(peer)

    async def get_full_user(user_id: Any=None) -> Any:
        uid = user_id or get_user_id()
        return await ctx.mt(
            "users.getFullUser",
            id={"_": "inputUser", "user_id": uid, "access_hash": 0},
        )

    async def get_peers_count(chat_id: Any=None) -> int | None:
        cid = chat_id or get_chat_id()
        try:
            res = await ctx.mt(
                "channels.getFullChannel",
                channel={"_": "inputChannel", "channel_id": cid, "access_hash": 0},
            )
            return res.get("full_chat", {}).get("participants_count")
        except Exception:
            return None


    def mention(user_id: int, name: str = "user") -> str:
        return f'<a href="tg://user?id={user_id}">{html.escape(str(name))}</a>'

    def bold(text: str) -> str:
        return f"<b>{html.escape(str(text))}</b>"

    def italic(text: str) -> str:
        return f"<i>{html.escape(str(text))}</i>"

    def under(text: str) -> str:
        return f"<u>{html.escape(str(text))}</u>"

    def strike(text: str) -> str:
        return f"<s>{html.escape(str(text))}</s>"

    def spoiler(text: str) -> str:
        return f"<tg-spoiler>{html.escape(str(text))}</tg-spoiler>"

    def code(text: str) -> str:
        return f"<code>{html.escape(str(text))}</code>"

    def pre(text: str, lang: str = "") -> str:
        lang_attr = f' class="language-{html.escape(lang)}"' if lang else ""
        return f"<pre><code{lang_attr}>{html.escape(str(text))}</code></pre>"

    def link(url: str, text: str) -> str:
        return f'<a href="{url}">{html.escape(str(text))}</a>'

    def hesc(text: str) -> str:
        return html.escape(str(text))

    def fmt_size(size: float) -> str:
        for unit in ("B", "KB", "MB", "GB", "TB"):
            if abs(size) < 1024:
                return f"{size:.1f} {unit}"
            size /= 1024
        return f"{size:.1f} PB"

    def fmt_time(seconds: float) -> str:
        if seconds < 60:
            return f"{seconds:.1f}s"
        mi, s = divmod(int(seconds), 60)
        if mi < 60:
            return f"{mi}m {s}s"
        h, mi = divmod(mi, 60)
        return f"{h}h {mi}m {s}s"


    async def respond(text: str, **kwargs: Any) -> Any:
        return await ctx.respond(text, **kwargs)

    async def edit_msg(text: str, **kwargs: Any) -> Any:
        return await ctx.respond(text, output="edit", **kwargs)

    async def reply_to(text: str, **kwargs: Any) -> Any:
        return await ctx.respond(text, output="reply", **kwargs)

    return {
        "m": m_proxy,
        "r": r_proxy,
        "db": db_proxy,
        "get_text": get_text,
        "get_reply_text": get_reply_text,
        "get_args": get_args,
        "get_args_list": get_args_list,
        "get_chat_id": get_chat_id,
        "get_user_id": get_user_id,
        "get_msg_id": get_msg_id,
        "get_reply_id": get_reply_id,
        "is_reply": is_reply,
        "is_me": is_me,
        "has_media": has_media,
        "get_media": get_media,
        "get_sender_name": get_sender_name,
        "get_username": get_username,
        "get_entity": get_entity,
        "get_full_user": get_full_user,
        "get_peers_count": get_peers_count,
        "mention": mention,
        "bold": bold,
        "italic": italic,
        "under": under,
        "strike": strike,
        "spoiler": spoiler,
        "code": code,
        "pre": pre,
        "link": link,
        "hesc": hesc,
        "fmt_size": fmt_size,
        "fmt_time": fmt_time,
        "respond": respond,
        "edit_msg": edit_msg,
        "reply_to": reply_to,
        "html": html,
        "re": re,
        "json": __import__("json"),
        "inspect": inspect,
    }


def _kill_group(process: Any) -> None:
    try:
        os.killpg(os.getpgid(process.pid), signal.SIGKILL)
    except OSError:
        try:
            process.kill()
        except ProcessLookupError:
            pass


async def _fail(ctx: Any, exc: BaseException) -> None:
    text = _trace(exc)
    print(text, file=sys.stderr)
    title = ctx.t('kernel.executor.section.traceback')
    try:
        await ctx.respond(
            f"<b>{_escape(str(title))}</b>\n<pre>{_escape(text)}</pre>",
            parse_mode="HTML", rich=False,
        )
    except Exception:
        pass


async def command_sh(ctx: Any, invocation: Any) -> Any:
    try:
        return await _sh_run(ctx, invocation)
    except asyncio.CancelledError:
        raise
    except Exception as exc:
        await _fail(ctx, exc)


async def _sh_run(ctx: Any, invocation: Any) -> Any:
    raw = _get_raw_text(invocation)
    skip_output = False
    if match := re.match(r"^(?:-so|--skip-output)(?:\s+|$)", raw):
        skip_output = True
        raw = raw[match.end():]

    cmd = _clean_code(raw)
    if not cmd:
        reply_code = await _reply_text(ctx, invocation)
        if reply_code:
            cmd = _clean_code(reply_code)
    if not cmd:
        prefix = ctx.runtime.config.prefix if ctx.runtime else "."
        await ctx.respond(
            ctx.t('kernel.executor.usage_sh', prefix=prefix),
            parse_mode="HTML", rich=False,
        )
        return

    inv_msg_id = _msg_id(invocation.message)

    env = os.environ.copy()
    env["TERM"] = "xterm"
    env["PAGER"] = "cat"
    env["SYSTEMD_PAGER"] = "cat"
    env["GIT_PAGER"] = "cat"
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["DEBIAN_FRONTEND"] = "noninteractive"
    bindir = os.path.dirname(sys.executable)
    env["PATH"] = f"{bindir}{os.pathsep}{env.get('PATH', '')}"
    if sys.prefix != getattr(sys, "base_prefix", sys.prefix):
        env["VIRTUAL_ENV"] = sys.prefix

    pm = None
    if "UV" in env or "UV_RUN_RECURSION_DEPTH" in env:
        pm = "uv pip"
    elif "PDM_PROJECT_ROOT" in env:
        pm = "pdm run pip"
    elif "POETRY_ACTIVE" in env:
        pm = "poetry run pip"
    if pm:
        cmd = f"pip() {{ {pm} \"$@\"; }};\n" + cmd

    shell = os.environ.get("SHELL", "/bin/bash")
    master, slave = pty.openpty()

    process = await asyncio.create_subprocess_exec(
        shell, "-c", cmd,
        stdin=asyncio.subprocess.DEVNULL,
        stdout=slave,
        stderr=slave,
        env=env,
        start_new_session=True,
    )
    os.close(slave)
    os.set_blocking(master, False)
    updater = OutputUpdater(ctx, cmd)
    updater.master_fd = master
    updater.process = process

    if inv_msg_id:
        _ACTIVE_SH[inv_msg_id] = process
    if not skip_output:
        await updater.update("", force=True, wait=True)
        resp_msg_id = _sent_id(updater.msg)
        if resp_msg_id:
            _ACTIVE_SH[resp_msg_id] = process

    async def read_pty() -> Any:
        while True:
            try:
                data = os.read(master, 4096)
                if data:
                    text = data.decode("utf-8", errors="replace")
                    if not skip_output:
                        await updater.update(text)
                else:
                    break
            except BlockingIOError:
                await asyncio.sleep(0.1)
            except OSError:
                break

    reader_task = asyncio.create_task(read_pty())
    
    try:
        await process.wait()
        try:
            await asyncio.wait_for(reader_task, timeout=1.0)
        except asyncio.TimeoutError:
            pass
    except asyncio.CancelledError:
        _kill_group(process)
        await process.wait()
    finally:
        if not reader_task.done():
            reader_task.cancel()
        os.close(master)

    if inv_msg_id and inv_msg_id in _ACTIVE_SH:
        del _ACTIVE_SH[inv_msg_id]
    resp_msg_id = _sent_id(updater.msg)
    if resp_msg_id and resp_msg_id in _ACTIVE_SH:
        del _ACTIVE_SH[resp_msg_id]

    if skip_output:
        return

    buffer_str = updater.strip_ansi(updater.buffer).strip()
    sections = [("command", cmd, True)]
    if buffer_str:
        sections.append(("output", buffer_str, True))
    
    await updater.finish(sections, returncode=process.returncode)


async def command_py(ctx: Any, invocation: Any) -> Any:
    try:
        return await _py_run(ctx, invocation)
    except asyncio.CancelledError:
        raise
    except Exception as exc:
        await _fail(ctx, exc)


async def _py_run(ctx: Any, invocation: Any) -> Any:
    raw = _get_raw_text(invocation)
    skip_output = False
    if match := re.match(r"^(?:-so|--skip-output)(?:\s+|$)", raw):
        skip_output = True
        raw = raw[match.end():]

    raw_code = _clean_code(raw)
    if not raw_code:
        reply_code = await _reply_text(ctx, invocation)
        if reply_code:
            raw_code = _clean_code(reply_code)
    if not raw_code:
        prefix = ctx.runtime.config.prefix if ctx.runtime else "."
        await ctx.respond(
            ctx.t('kernel.executor.usage_py', prefix=prefix),
            parse_mode="HTML", rich=False,
        )
        return

    reply = await _get_reply(ctx, invocation)

    helpers = _build_py_helpers(ctx, invocation, reply)
    env: dict[str, Any] = {
        "_auto_await": _auto_await,
        "ctx": ctx,
        "runtime": getattr(ctx, "runtime", None),
        "tg": getattr(ctx, "tg", None),
        "c": getattr(ctx, "tg", None),
        "client": getattr(ctx, "client", getattr(ctx, "tg", None)),
        "state": getattr(ctx, "state", None),
        "_source_raw": getattr(ctx, "_source", None),
        "_reply_raw": reply,
        "invocation": invocation,
        "i": invocation,
        "asyncio": asyncio,
        "os": os,
        "sys": sys,
        "time": time,
        "re": re,
        "html": html,
        "io": io,
        "traceback": traceback,
        "inspect": inspect,
        **helpers,
    }
    env["msg"] = env["m"]
    env["message"] = env["m"]
    env["reply"] = env["r"]
    env["rep"] = env["r"]

    inv_msg_id = _msg_id(invocation.message)

    updater = OutputUpdater(ctx, raw_code, is_py=True)
    if not skip_output:
        await updater.update("", force=True, wait=True)

    result_val = _SENTINEL
    error_trace = None

    async def _task() -> Any:
        nonlocal result_val
        exec_scope = dict(env)
        try:
            bytecode = compile(_wrap_eval_code(raw_code), "<executor>", "exec")
        except SyntaxError as exc:
            raise SyntaxError(f"SyntaxError: {exc.msg} (line {exc.lineno})") from None
        exec(bytecode, exec_scope)
        runner = exec_scope.get("__executor_runner__")
        if runner is None:
            raise NameError("__executor_runner__ missing — code wrapping failed") from None
        result_val = await runner()

    eval_task = asyncio.create_task(_task())
    updater.process = eval_task
    if inv_msg_id:
        _ACTIVE_PY[inv_msg_id] = eval_task
    if not skip_output:
        resp_msg_id = _sent_id(updater.msg)
        if resp_msg_id:
            _ACTIVE_PY[resp_msg_id] = eval_task

    stdout_buf = StreamInterceptor(updater)
    stderr_buf = StreamInterceptor(updater)

    try:
        with contextlib.redirect_stdout(stdout_buf), contextlib.redirect_stderr(stderr_buf):
            await eval_task
    except asyncio.CancelledError:
        error_trace = ctx.t('kernel.executor.cancelled')
    except Exception as exc:
        error_trace = _trace(exc)
    finally:
        if inv_msg_id and inv_msg_id in _ACTIVE_PY:
            del _ACTIVE_PY[inv_msg_id]
        resp_msg_id = _sent_id(updater.msg)
        if resp_msg_id and resp_msg_id in _ACTIVE_PY:
            del _ACTIVE_PY[resp_msg_id]

    if skip_output:
        return

    sections: list[Any] = [("code", raw_code, True)]
    buffer_str = updater.strip_ansi(updater.buffer).strip()
    if buffer_str:
        sections.append(("output", buffer_str, True))
    if result_val is not _SENTINEL:
        rendered = result_val if isinstance(result_val, str) else _dump(result_val)
        sections.append(("return", rendered if rendered else "''", True, "python"))
    if error_trace:
        sections.append(("traceback", error_trace, True, "python"))
    if len(sections) == 1:
        sections.append(("result", ctx.t('kernel.executor.done'), False))

    await updater.finish(sections)
    
async def command_kill(ctx: Any, invocation: Any) -> Any:
    reply = await _get_reply(ctx, invocation)
    if not reply:
        await ctx.respond(ctx.t('kernel.executor.kill_reply'), parse_mode="HTML")
        return

    target_id = _msg_id(reply)
    killed = False

    proc = _ACTIVE_SH.get(target_id)
    if proc is not None:
        _kill_group(proc)
        killed = True
        _ACTIVE_SH.pop(target_id, None)

    task = _ACTIVE_PY.get(target_id)
    if task is not None:
        task.cancel()
        killed = True
        _ACTIVE_PY.pop(target_id, None)

    runtime = getattr(ctx, "runtime", None)
    kernel = getattr(runtime, "kernel", None)
    if kernel is not None and getattr(reply, "chat_id", None) is not None:
        try:
            killed = kernel.cancel(getattr(reply, "chat_id", None), target_id) or killed
        except Exception:
            pass

    if killed:
        await ctx.respond(ctx.t('kernel.executor.killed'), parse_mode="HTML")
    else:
        await ctx.respond(ctx.t('kernel.executor.no_process'), parse_mode="HTML")


