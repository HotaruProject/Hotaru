HOTARU = {
    "id": "executor",
    "version": "1.0.0",
    "commands": ["sh"],
    "capabilities": ["mt", "files", "net", "state"],
    "description": "A simple module for execute commands in shell"
}


import asyncio


async def _executeInShell(cmd: str) -> dict:
    result = {"stdout": "",
              "stderr": ""}
    process = await asyncio.create_subprocess_shell(cmd,
                                                    stdout=asyncio.subprocess.PIPE,
                                                    stderr=asyncio.subprocess.PIPE)
    stdout, stderr = await process.communicate()
    if not stdout and not stderr:
        result["stdout"] = "None"
        result["stderr"] = "None"
        return result
    result["stdout"] = stdout.decode("UTF-8", errors="replace").strip()
    result["stderr"] = stderr.decode("UTF-8", errors="replace").strip()
    return result


async def command_sh(ctx, i):
    premium = await ctx.premium()

    args = getattr(i, "args", [])
    if args == []:
        if premium:
            await ctx.respond("<b>usage:</b>\n.sh ...", parse_mode="HTML")
        else:
            await ctx.respond("<b>usage:</b>\n.sh ...", parse_mode="HTML", rich=False)
        return

    cmd = " ".join(args)
    result = await _executeInShell(cmd)

    stdout: str = __import__("html").escape(result["stdout"], quote=False)
    stderr: str = __import__("html").escape(result["stderr"], quote=False)

    if premium:
        message = (
            f"<details><summary><b>stdout</b></summary><p><pre><code>{stdout}</code></pre></p></details>"
            f"<details><summary><b>stderr</b></summary><p><pre><code>{stderr}</code></pre></p></details>"
        )
        await ctx.respond(message, parse_mode="HTML")
    else:
        plain = (
            f"<b>stdout:</b>\n<code>{stdout}</code>\n\n"
            f"<b>stderr:</b>\n<code>{stderr}</code>"
        )
        await ctx.respond(plain, parse_mode="HTML", rich=False)
