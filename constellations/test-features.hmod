HOTARU = {
    "id": "test-features",
    "version": "1.0.0",
    "description": "Hotaru proxy and capability test module",
    "commands": ["tfstatus", "tfhistory", "tfstate", "tffile", "tfnet", "tfbutton", "tfmedia", "tfinlinerich", "tfrichboth"],
    "capabilities": ["mt", "state", "files", "net"],
}

import asyncio


async def command_tfstatus(ctx, invocation):
    result = await ctx.tg.get("updates.getState")
    await ctx.answer(text=f"dynamic MTProto works: {result}")


async def command_tfhistory(ctx, invocation):
    result = await ctx.tg.get("messages.getHistory", peer="me", limit=5, offset_id=0, offset_date=0, add_offset=0, max_id=0, min_id=0, hash=0)
    items = result.get("messages", []) if isinstance(result, dict) else []
    await ctx.answer(text=f"history items: {len(items)}")


async def command_tfstate(ctx, invocation):
    current = ctx.state.get("runs", 0) or 0
    ctx.state.set("runs", current + 1)
    await ctx.answer(text=f"state runs: {current + 1}")


async def command_tffile(ctx, invocation):
    await ctx.cap("files", {"op": "write", "name": "test.txt", "content": "file proxy works"})
    value = await ctx.cap("files", {"op": "read", "name": "test.txt"})
    await ctx.answer(text=str(value))


async def command_tfnet(ctx, invocation):
    result = await ctx.net("https://api.github.com", timeout=10)
    await ctx.answer(text=f"network status: {result.get('status')}")


async def command_tfbutton(ctx, invocation):
    async def pressed(callback, payload):
        await callback.answer("callback accepted")
        await callback.edit("encrypted callback executed")

    action_id = ctx.ui.on(pressed)
    button = ctx.ui.button("Run encrypted callback", action_id, {"source": "test-features"})
    await ctx.answer(text="kernel callback proxy works", buttons=[[button]])


async def command_tfmedia(ctx, invocation):
    attachment = ctx.attachment or ctx.reply_attachment
    await ctx.answer(text=f"media detected: {attachment.kind if attachment else 'none'}")


async def command_tfinlinerich(ctx, invocation):
    async def pressed(call, payload):
        await call.answer("Inline callback accepted")
        await call.edit("<h2>Inline Rich updated</h2><p><b>Callback worked</b></p><details open><summary>Result</summary><p><code>inline_message_id</code> path</p></details>")

    button = ctx.ui.primary("Run callback", pressed)
    html = "<h1>Inline Rich test</h1><p><b>bold</b> <i>italic</i> <u>underline</u> <tg-spoiler>spoiler</tg-spoiler> <code>code</code> <a href=\"https://core.telegram.org\">docs</a></p><blockquote>inline bot + native inline result</blockquote><ul><li>HTML parser</li><li>inline message</li><li>callback edit</li></ul><details open><summary>Details</summary><p>Buttons and rich content are combined.</p></details><table><tr><td>mode</td><td>inline</td></tr><tr><td>format</td><td>HTML</td></tr></table><tg-button-row><tg-button type=\"callback_data\" data=\"kernel\">Native callback</tg-button><tg-button type=\"url\" url=\"https://telegram.org\">Telegram</tg-button></tg-button-row>"
    await ctx.inline_form(html, [button])


async def command_tfrichboth(ctx, invocation):
    rich = ctx.rich
    html = '''<h1>Hotaru Rich dual transport</h1><p><b>User MTProto</b> + <b>Bot API</b></p><blockquote expandable><i>Один модуль, два транспорта</i></blockquote><ul><li>HTML</li><li>таблица</li><li>details</li><li>map</li><li>media</li></ul><ol><li>Parse HTML</li><li>Build RichMessage</li><li>Send</li></ol><details open><summary><b>Details</b></summary><p><code>ctx.rich</code> and <code>ctx.bot</code></p></details><table><tr><td><b>Transport</b></td><td><b>Status</b></td></tr><tr><td>MTProto</td><td>ready</td></tr><tr><td>Bot API</td><td>ready</td></tr></table><tg-map latitude="55.7558" longitude="37.6173" zoom="10" width="600" height="400"><b>Moscow</b></tg-map><pre><code>return rich</code></pre><tg-button-row align="center"><tg-button type="url" style="success" url="https://telegram.org">Telegram</tg-button><tg-button type="copy_text" text="copied">Copy</tg-button></tg-button-row>'''
    user_result = await rich.send(html)
    bot_result = await ctx.bot.rich_send(111040773, html)
    await ctx.answer("<b>Rich dual test отправлен</b><br>user=ok<br>bot=ok")
    return {"user": bool(user_result), "bot": bool(bot_result)}
