HOTARU = {
    "id": "genesis",
    "version": "1.1.0",
    "commands": [],
    "bot_commands": ["start", "github"],
    "capabilities": ["mt", "state"],
    "banner": "https://raw.githubusercontent.com/HotaruProject/Hotaru/develop/hotaru/assets/genesis.mp4",
    "rise": "on_rise",
}

import asyncio
import html
from typing import Any, List, Optional


def _escape(text: Any) -> str:
    return html.escape(str(text), quote=False)


def _get_log_level(runtime: Any) -> str:
    if runtime and getattr(runtime, "state", None):
        return str(runtime.state.namespace("logger").get("level", "info")).lower()
    return "info"


def _set_log_level(runtime: Any, level: str) -> None:
    lvl = level.lower()
    if runtime and getattr(runtime, "state", None):
        runtime.state.namespace("logger").set("level", lvl)
    mod = runtime.modules.get("logger") if runtime and getattr(runtime, "modules", None) else None
    if mod and hasattr(mod, "context") and hasattr(mod.context, "config"):
        try:
            mod.context.config.set("level", lvl)
        except Exception:
            pass


def _get_backup_config(runtime: Any) -> tuple[bool, int]:
    if runtime and getattr(runtime, "state", None):
        ns = runtime.state.namespace("backups")
        return bool(ns.get("enabled", True)), int(ns.get("interval_hours", 24))
    return True, 24


def _set_backup_enabled(runtime: Any, enabled: bool) -> None:
    if runtime and getattr(runtime, "state", None):
        runtime.state.namespace("backups").set("enabled", bool(enabled))
    mod = runtime.modules.get("backups") if runtime and getattr(runtime, "modules", None) else None
    if mod and hasattr(mod, "context") and hasattr(mod.context, "config"):
        try:
            mod.context.config.set("enabled", bool(enabled))
        except Exception:
            pass


def _set_backup_hours(runtime: Any, hours: int) -> None:
    if runtime and getattr(runtime, "state", None):
        runtime.state.namespace("backups").set("interval_hours", int(hours))
    mod = runtime.modules.get("backups") if runtime and getattr(runtime, "modules", None) else None
    if mod and hasattr(mod, "context") and hasattr(mod.context, "config"):
        try:
            mod.context.config.set("interval_hours", int(hours))
        except Exception:
            pass


def _webapp_button(ctx: Any) -> Optional[Any]:
    k = ctx.screens
    runtime = getattr(ctx, "runtime", None)
    if not runtime:
        return None
    bot_user = ""
    if getattr(runtime, "state", None):
        bot_user = str(runtime.state.get_setting("inline-bot-username") or "").lstrip("@").strip()
    if not bot_user and getattr(runtime, "inline", None) and getattr(runtime.inline, "info", None):
        bot_user = str(getattr(runtime.inline.info, "username", "") or "").lstrip("@").strip()

    short_slug = "dashboard"
    svc = getattr(runtime, "singularity", None)
    if svc is not None:
        short_slug = getattr(getattr(svc, "config", None), "short_name", "dashboard") or "dashboard"

    app_link = f"https://t.me/{bot_user}/{short_slug}" if bot_user else ""
    tunnel_url = ""
    if svc is not None:
        tunnel_url = str(getattr(svc, "tunnel_url", "") or getattr(svc, "local_url", "") or "")
    if not tunnel_url and getattr(runtime, "state", None):
        tunnel_url = str(runtime.state.get_setting("singularity-last-tunnel-url") or "")

    label = ctx.t("kernel.genesis.btn_webapp", "🌐 Open WebApp")
    if app_link:
        return k.url(label, app_link)
    if tunnel_url and hasattr(k, "webapp"):
        return k.webapp(label, tunnel_url)
    if tunnel_url:
        return k.url(label, tunnel_url)
    return None


def _finish_keyboard(ctx: Any) -> list[list[Any]]:
    k = ctx.screens
    rows: list[list[Any]] = []
    wb = _webapp_button(ctx)
    if wb:
        rows.append([wb])
    rows.append([
        k.link(ctx.t("kernel.genesis.btn_settings", "⚙️ Settings"), "settings", "home"),
        k.url(ctx.t("kernel.genesis.btn_github", "GitHub Repository"), "https://github.com/HotaruProject/Hotaru"),
    ])
    rows.append([k.close()])
    return rows


def active_screen(ctx: Any, nav: Any = None) -> Any:
    k = ctx.screens
    text = (
        f'{k.wordmark()} - <b>{_escape(ctx.t("kernel.genesis.active_title", "Active & Online"))}</b>\n\n'
        f'<i>{_escape(ctx.t("kernel.genesis.active_desc", "Hotaru Userbot is configured and running. Use commands directly in your account."))}</i>'
    )
    return k.screen(text, _finish_keyboard(ctx), banner=k.banner("genesis"), rich=True)


def home(ctx: Any, nav: Any = None) -> Any:
    if ctx.state.get("setup_completed"):
        return active_screen(ctx, nav)

    k = ctx.screens
    runtime = ctx.runtime
    lang = runtime.language() if runtime else "en"
    lang_meta = ctx.i18n.get_meta(lang) if hasattr(ctx, "i18n") and hasattr(ctx.i18n, "get_meta") else {"name_native": lang}
    log_level = _get_log_level(runtime).upper()
    backups_enabled, backups_hours = _get_backup_config(runtime)
    backups_status = ctx.t("kernel.backups.enabled" if backups_enabled else "kernel.backups.disabled")

    text = (
        f'{k.wordmark()} · <tg-emoji emoji-id="5366045973988522066">✨</tg-emoji> <b>{_escape(ctx.t("kernel.genesis.title", "Genesis Setup"))}</b>\n\n'
        f'<i>{_escape(ctx.t("kernel.genesis.welcome", "Welcome to Hotaru! Fast initial setup wizard:"))}</i>\n\n'
        f'<tg-emoji emoji-id="5291803847914698795">🌐</tg-emoji> <b>{_escape(ctx.t("kernel.genesis.language", "Language"))}:</b> <code>{_escape(lang_meta.get("name_native", lang))}</code>\n'
        f'<tg-emoji emoji-id="5310285203858535580">📔</tg-emoji> <b>{_escape(ctx.t("kernel.genesis.log_level", "Log Level"))}:</b> <code>{log_level}</code>\n'
        f'<tg-emoji emoji-id="5258514780469075716">📂</tg-emoji> <b>{_escape(ctx.t("kernel.genesis.backups", "Backups"))}:</b> <code>{backups_hours}h</code> ({backups_status})\n'
    )
    rows: List[List[Any]] = [
        [k.primary(ctx.t("kernel.genesis.start_wizard", "🚀 Start Setup Wizard"), step_lang)],
        [k.button(ctx.t("kernel.genesis.btn_language", "🌐 Language"), step_lang), k.button(ctx.t("kernel.genesis.btn_logs", "📔 Log Level"), step_logs)],
        [k.button(ctx.t("kernel.genesis.btn_backups", "📂 Backups"), step_backups)],
    ]
    wb = _webapp_button(ctx)
    if wb:
        rows.append([wb])
    rows.append([k.close()])
    return k.screen(text, rows, banner=k.banner("genesis"), rich=True)


def step_lang(ctx: Any, nav: Any = None) -> Any:
    if ctx.state.get("setup_completed"):
        return active_screen(ctx, nav)

    k = ctx.screens
    runtime = ctx.runtime
    current = runtime.language() if runtime else "en"
    available = ctx.i18n.available_languages() if hasattr(ctx, "i18n") and hasattr(ctx.i18n, "available_languages") else ("en", "ru", "uk", "kz", "ja", "zh")
    labels = {"en": "English", "ru": "Русский", "uk": "Український", "kz": "Қазақша", "ja": "日本語", "zh": "中文"}
    buttons: list[Any] = []
    for code in available:
        label = labels.get(code, code)
        is_selected = (code == current)
        buttons.append(k.button(k.radio(label, is_selected), apply_lang, style="success" if is_selected else None, code=code))
    rows: list[list[Any]] = k.grid(buttons, 2)
    rows.append([k.back(home), k.button(ctx.t("kernel.genesis.btn_next_logs", "Next: Logs ›"), step_logs)])
    rows.append([k.close()])
    text = (
        f'{k.wordmark()} · <tg-emoji emoji-id="5291803847914698795">🌐</tg-emoji> <b>{_escape(ctx.t("kernel.genesis.step_lang_title", "Step 1/3 · Language"))}</b>\n\n'
        f'{_escape(ctx.t("kernel.genesis.step_lang_desc", "Select your interface language:"))}\n'
        f'<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji> {_escape(ctx.t("kernel.genesis.current", "Current:"))} <code>{_escape(current)}</code>'
    )
    return k.screen(text, rows, banner=k.banner("genesis"), rich=True)


async def apply_lang(ctx: Any, nav: Any) -> Any:
    if ctx.state.get("setup_completed"):
        return active_screen(ctx, nav)
    code = str(nav.arg("code") or "en")
    runtime = ctx.runtime
    if runtime is not None:
        runtime.set_language(code)
    meta = ctx.i18n.get_meta(code) if hasattr(ctx, "i18n") and hasattr(ctx.i18n, "get_meta") else {"name_native": code}
    screen = step_lang(ctx, nav)
    screen.toast = f"✅ {meta.get('name_native', code)}"
    return screen


def step_logs(ctx: Any, nav: Any = None) -> Any:
    if ctx.state.get("setup_completed"):
        return active_screen(ctx, nav)

    k = ctx.screens
    runtime = ctx.runtime
    current = _get_log_level(runtime)
    options = ["all", "debug", "info", "warn", "error", "fatal"]
    buttons: list[Any] = []
    for opt in options:
        is_selected = (opt == current)
        buttons.append(k.button(k.radio(opt.upper(), is_selected), apply_loglevel, style="success" if is_selected else None, level=opt))
    rows: list[list[Any]] = k.grid(buttons, 3)
    rows.append([k.back(step_lang), k.button(ctx.t("kernel.genesis.btn_next_backups", "Next: Backups ›"), step_backups)])
    rows.append([k.close()])
    text = (
        f'{k.wordmark()} · <tg-emoji emoji-id="5310285203858535580">📔</tg-emoji> <b>{_escape(ctx.t("kernel.genesis.step_logs_title", "Step 2/3 · Log Level"))}</b>\n\n'
        f'{_escape(ctx.t("kernel.genesis.step_logs_desc", "Select minimum log level for mirror & observatory:"))}\n'
        f'<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji> {_escape(ctx.t("kernel.genesis.current", "Current:"))} <code>{current.upper()}</code>'
    )
    return k.screen(text, rows, banner=k.banner("genesis"), rich=True)


async def apply_loglevel(ctx: Any, nav: Any) -> Any:
    if ctx.state.get("setup_completed"):
        return active_screen(ctx, nav)
    level = str(nav.arg("level") or "info").lower()
    _set_log_level(ctx.runtime, level)
    screen = step_logs(ctx, nav)
    screen.toast = ctx.t("kernel.logger.level_set", level=level.upper())
    return screen


def step_backups(ctx: Any, nav: Any = None) -> Any:
    if ctx.state.get("setup_completed"):
        return active_screen(ctx, nav)

    k = ctx.screens
    runtime = ctx.runtime
    enabled, current_hours = _get_backup_config(runtime)
    intervals = [6, 12, 24, 48, 72]
    buttons: list[Any] = []
    for h in intervals:
        is_selected = (h == current_hours)
        buttons.append(k.button(k.radio(f"{h}h", is_selected), apply_backup_hours, style="success" if is_selected else None, hours=h))
    status_label = f"✅ {ctx.t('kernel.backups.enabled')}" if enabled else f"❌ {ctx.t('kernel.backups.disabled')}"
    status_style = "success" if enabled else "danger"
    rows = [
        [k.button(status_label, toggle_backup, style=status_style)],
        buttons,
        [k.back(step_logs), k.primary(ctx.t("kernel.genesis.btn_complete", "Complete Setup ✅"), step_finish)],
        [k.close()],
    ]
    text = (
        f'{k.wordmark()} · <tg-emoji emoji-id="5258514780469075716">📂</tg-emoji> <b>{_escape(ctx.t("kernel.genesis.step_backups_title", "Step 3/3 · Backups Schedule"))}</b>\n\n'
        f'{_escape(ctx.t("kernel.genesis.step_backups_desc", "Configure automatic encrypted backups:"))}\n'
        f'<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji> {_escape(ctx.t("kernel.genesis.current", "Current:"))} <code>{current_hours}h</code> ({ctx.t("kernel.backups.enabled" if enabled else "kernel.backups.disabled")})'
    )
    return k.screen(text, rows, banner=k.banner("genesis"), rich=True)


async def toggle_backup(ctx: Any, nav: Any) -> Any:
    if ctx.state.get("setup_completed"):
        return active_screen(ctx, nav)
    enabled, _ = _get_backup_config(ctx.runtime)
    _set_backup_enabled(ctx.runtime, not enabled)
    return step_backups(ctx, nav)


async def apply_backup_hours(ctx: Any, nav: Any) -> Any:
    if ctx.state.get("setup_completed"):
        return active_screen(ctx, nav)
    hours = int(nav.arg("hours") or 24)
    _set_backup_hours(ctx.runtime, hours)
    screen = step_backups(ctx, nav)
    screen.toast = ctx.t("kernel.genesis.backup_hours_applied", hours=hours)
    return screen


def step_finish(ctx: Any, nav: Any = None) -> Any:
    ctx.state.set("setup_completed", True)
    k = ctx.screens
    runtime = ctx.runtime
    prefix = getattr(runtime.config, "prefix", ".") if runtime else "."
    text = (
        f'{k.wordmark()} · <tg-emoji emoji-id="5260726538302660868">✅</tg-emoji> <b>{_escape(ctx.t("kernel.genesis.done_title", "Setup Complete!"))}</b>\n\n'
        f'<tg-emoji emoji-id="5366045973988522066">✨</tg-emoji> {_escape(ctx.t("kernel.genesis.done_desc", "Hotaru is fully configured and ready to shine."))}\n\n'
        f'• <code>{_escape(prefix)}help</code> - {_escape(ctx.t("kernel.help.description", "Module list"))}\n'
        f'• <code>{_escape(prefix)}config</code> - {_escape(ctx.t("kernel.config.title", "Settings"))}\n'
        f'• <code>{_escape(prefix)}info</code> - {_escape(ctx.t("kernel.info.description", "Information and latency"))}\n'
    )
    return k.screen(text, _finish_keyboard(ctx), banner=k.banner("genesis"), rich=True)


async def command_start(ctx: Any, invocation: Any) -> Any:
    if ctx.state.get("setup_completed"):
        await ctx.screens.show(active_screen(ctx))
    else:
        await ctx.screens.show(home(ctx))


async def command_github(ctx: Any, invocation: Any) -> Any:
    k = ctx.screens
    text = (
        f'{k.wordmark()} - <b>{_escape(ctx.t("kernel.genesis.links_title", "Hotaru Links"))}</b>\n\n'
        f'<i>{_escape(ctx.t("kernel.genesis.links_desc", "Official Hotaru project repository, documentation, and source code:"))}</i>'
    )
    rows = [
        [k.url(ctx.t("kernel.genesis.btn_github", "GitHub Repository"), "https://github.com/HotaruProject/Hotaru")]
    ]
    await ctx.screens.show(k.screen(text, rows, banner=k.banner("genesis"), rich=True))


async def on_rise(ctx: Any) -> None:
    asyncio.create_task(_rise_tasks(ctx))


async def _rise_tasks(ctx: Any) -> None:
    try:
        if not ctx.state.get("onboarded") and not ctx.state.get("setup_completed"):
            ctx.state.set("onboarded", True)
            bot_user = ""
            runtime = getattr(ctx, "runtime", None)
            if runtime and getattr(runtime, "state", None):
                bot_user = str(runtime.state.get_setting("inline-bot-username") or "").lstrip("@").strip()
            if not bot_user and runtime and getattr(runtime, "inline", None) and getattr(runtime.inline, "info", None):
                bot_user = str(getattr(runtime.inline.info, "username", "") or "").lstrip("@").strip()
            if bot_user and runtime and getattr(runtime, "app", None):
                target = "@" + bot_user
                sent = await runtime.app.send_msg(target, "/start")
                from goygram.sugar import extract_sent_message
                msg = extract_sent_message(sent)
                mid = msg.get("id") if isinstance(msg, dict) else None
                if mid is not None:
                    await asyncio.sleep(0.5)
                    try:
                        await runtime.app.delete_msg(target, mid, revoke=True)
                    except Exception:
                        pass
    except Exception:
        pass
