HOTARU = {
    "id": "catalyst",
    "version": "1.0.0",
    "commands": ['ld', 'ul', 'rl', 'rm'],
    "capabilities": [],
}

from typing import Any

async def command_ld(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("runtime unavailable")
        return
    result = await runtime._command_ld(invocation)
    if isinstance(result, tuple):
        text, buttons = result
        await ctx.respond(text, buttons=buttons)
    else:
        await ctx.respond(result)
async def command_ul(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("runtime unavailable")
        return
    result = await runtime._command_ul(invocation)
    await ctx.respond(result)
async def command_rl(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("runtime unavailable")
