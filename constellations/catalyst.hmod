HOTARU = {
    "id": "catalyst",
    "version": "1.3.0",
    "commands": ['ld', 'ul', 'rl', 'ex', 'rs', 'resetdb'],
    "capabilities": [],
}

from typing import Any, Tuple, cast

_consent_ttl = 3600

async def command_ld(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.kernel.runtime_unavailable'))
        return
    result = await runtime._command_ld(invocation)
    if isinstance(result, tuple):
        text, rows = cast(Tuple[Any, Any], result)
        await ctx.screens.show(ctx.screens.screen(text, rows, ttl=_consent_ttl))
    else:
        await ctx.respond(result)

async def command_ul(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.kernel.runtime_unavailable'))
        return
    result = await runtime._command_ul(invocation)
    await ctx.respond(result)

async def command_rl(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.kernel.runtime_unavailable'))
        return
    result = await runtime._command_rl(invocation)
    await ctx.respond(result)

async def command_ex(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.kernel.runtime_unavailable'))
        return
    result = await runtime._command_ex(invocation, ctx=ctx)
    if result:
        await ctx.respond(result)

async def command_rs(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.kernel.runtime_unavailable'))
        return
    result = await runtime._command_rs(invocation)
    await ctx.respond(result)

command_resetdb = command_rs