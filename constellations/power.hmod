HOTARU = {
    "id": "power",
    "version": "1.4.0",
    "commands": ["restart", "stop", "start"],
    "capabilities": ["mt"],
    "rise": "sunrise",
    "fade": "sundown",
}

import asyncio
import os
import subprocess
import sys
import time


def _text_running(ctx):
    return f"<b>{ctx.t('kernel.power.running', 'Юзербот работает')}</b>"

def _text_stopped(ctx):
    return f"<b>{ctx.t('kernel.power.stopped', 'Юзербот приостановлен')}</b>"

async def command_stop(ctx, invocation):
    runtime = ctx.runtime
    if runtime.kernel.suspended:
        await ctx.respond(ctx.t("kernel.power.already_stopped", "Юзербот уже остановлен (приостановлен)."))
        return
    runtime.kernel.suspended = True
    if runtime.state is not None:
        runtime.state.set_setting("suspended", "1")
    await ctx.respond(_text_stopped(ctx), parse_mode="HTML")

async def command_start(ctx, invocation):
    runtime = ctx.runtime
    if not runtime.kernel.suspended:
        await ctx.respond(ctx.t("kernel.power.already_running", "Юзербот уже запущен."))
        return
    runtime.kernel.suspended = False
    if runtime.state is not None:
        runtime.state.set_setting("suspended", "0")
    await ctx.respond(_text_running(ctx), parse_mode="HTML")

async def command_restart(ctx, invocation):
    chat_id = getattr(ctx.message, "chat_id", None)
    message_id = getattr(ctx.message, "id", None)
    peer_hex = None
    if isinstance(chat_id, int) and isinstance(message_id, int):
        try:
            app = getattr(ctx.runtime, "app", None)
            mt = getattr(app, "mt", None) if app is not None else None
            if mt is not None and hasattr(mt, "resolve_peer"):
                peer_hex = (await mt.resolve_peer(chat_id)).hex()
        except Exception:
            peer_hex = None
        ctx.state.set("restart_pending", {"chat_id": chat_id, "message_id": message_id, "peer": peer_hex, "ts": time.time()})
    await ctx.respond(ctx.t("kernel.power.restarting", "Перезапускаю юзербот..."), parse_mode="HTML")

    try:
        if ctx.runtime.app:
            await asyncio.wait_for(ctx.runtime.app.close(), timeout=1.0)
    except Exception:
        pass

    if "INVOCATION_ID" in os.environ:
        service_name = None
        is_user_service = False
        try:
            with open("/proc/self/cgroup", "r") as f:
                for line in f:
                    if ".service" in line:
                        service_name = line.strip().split("/")[-1]
                        if "user.slice" in line or "user@" in line:
                            is_user_service = True
                        break
        except Exception:
            pass
        if service_name:
            cmd = ["systemctl", "--user" if is_user_service else "", "restart", service_name]
            cmd = [c for c in cmd if c]
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return

    os.execv(sys.executable, [sys.executable, "-m", "hotaru"])

async def sunrise(ctx):
    pending = ctx.state.get("restart_pending")
    if not isinstance(pending, dict):
        return
    ctx.state.delete("restart_pending")
    ts = pending.get("ts")
    chat_id = pending.get("chat_id")
    message_id = pending.get("message_id")
    peer_hex = pending.get("peer") if isinstance(pending.get("peer"), str) else None
    if not (isinstance(chat_id, int) and isinstance(message_id, int)):
        return
    took = max(1, round(time.time() - float(ts))) if isinstance(ts, (int, float)) else None
    took = f"{took}s" if took is not None else "n/a"
    text = ctx.t("kernel.power.restarted", "Юзербот успешно перезапущен за {took}", took=took)
    html = f"<b>{text}</b>"
    rich = {"_": "inputRichMessageHTML", "html": html}
    try:
        if peer_hex:
            await ctx.tg.call("messages.editMessage", {"id": message_id, "rich_message": rich, "peer": bytes.fromhex(peer_hex)})
        else:
            await ctx.tg.edit_rich(message_id, html, peer=chat_id)
    except Exception:
        try:
            await ctx.tg.edit_rich(message_id, html, peer=chat_id)
        except Exception:
            pass

async def sundown(ctx):
    return None
