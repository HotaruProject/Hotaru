HOTARU = {
    "id": "power",
    "version": "1.3.0",
    "description": "Power management: restart, stop, start with persistent status messages",
    "commands": ["restart", "stop", "start"],
    "capabilities": ["mt"],
    "tasks": {
        "status_sync": {"interval": 60, "autostart": True},
    },
    "rise": "sunrise",
    "fade": "sundown",
}

import asyncio
import os
import subprocess
import sys
import time

from hotaru.kmsg import KernelMessageService

SLOT = "power:status"
RESTART_SLOT = "power:restart"

def _text_running(ctx):
    return f"<b>{ctx.t('kernel.power.running', 'Юзербот работает')}</b>"

def _text_stopped(ctx):
    return f"<b>{ctx.t('kernel.power.stopped', 'Юзербот приостановлен')}</b>"

async def _edit_status(ctx, text):
    record = ctx.kernel_messages.get(SLOT)
    if record is None:
        return
    updated = ctx.kernel_messages.put(SLOT, "power", record.chat_id, record.message_id, text, record.meta)
    if updated is not None:
        await KernelMessageService.edit(ctx.bot, updated, text)

async def command_stop(ctx, invocation):
    runtime = ctx.runtime
    if runtime.kernel.suspended:
        await ctx.respond(ctx.t("kernel.power.already_stopped", "Юзербот уже остановлен (приостановлен)."))
        return
    runtime.kernel.suspended = True
    if runtime.state is not None:
        runtime.state.set_setting("suspended", "1")
    await ctx.respond(_text_stopped(ctx), parse_mode="HTML")
    await _edit_status(ctx, _text_stopped(ctx))

async def command_start(ctx, invocation):
    runtime = ctx.runtime
    if not runtime.kernel.suspended:
        await ctx.respond(ctx.t("kernel.power.already_running", "Юзербот уже запущен."))
        return
    runtime.kernel.suspended = False
    if runtime.state is not None:
        runtime.state.set_setting("suspended", "0")
    await ctx.respond(_text_running(ctx), parse_mode="HTML")
    await _edit_status(ctx, _text_running(ctx))

async def command_restart(ctx, invocation):
    restarting = ctx.t("kernel.power.restarting", "Перезапускаю юзербот...")
    record = ctx.kernel_messages.get(RESTART_SLOT)
    if record is not None:
        ctx.kernel_messages.put(RESTART_SLOT, "power", record.chat_id, record.message_id, restarting, {"restart_ts": time.time()})
        await KernelMessageService.edit(ctx.bot, ctx.kernel_messages.get(RESTART_SLOT), restarting)
    else:
        sent = None
        try:
            sent = await ctx.respond(restarting, parse_mode="HTML")
        except Exception:
            sent = None
        body = sent.get("result", sent) if isinstance(sent, dict) else sent
        if isinstance(body, dict):
            chat_id = body.get("chat", {}).get("id") or body.get("chat_id")
            message_id = body.get("message_id")
            if isinstance(chat_id, int) and isinstance(message_id, int):
                ctx.kernel_messages.put(RESTART_SLOT, "power", chat_id, message_id, restarting, {"restart_ts": time.time()})

    try:
        if ctx.runtime.app:
            await asyncio.wait_for(ctx.runtime.app.close(), timeout=1.0)
    except Exception:
        pass

    if "INVOCATION_ID" in os.environ:
        service_name = None
        is_user_service = False
        try:
            with open("/proc/self/cgroup", "r") as f:
                for line in f:
                    if ".service" in line:
                        service_name = line.strip().split("/")[-1]
                        if "user.slice" in line or "user@" in line:
                            is_user_service = True
                        break
        except Exception:
            pass
        if service_name:
            cmd = ["systemctl", "--user" if is_user_service else "", "restart", service_name]
            cmd = [c for c in cmd if c]
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return

    os.execv(sys.executable, [sys.executable, "-m", "hotaru"])

async def sunrise(ctx):
    record = ctx.kernel_messages.get(RESTART_SLOT)
    if record is None:
        return
    meta = record.meta or {}
    restart_ts = meta.get("restart_ts")
    if not isinstance(restart_ts, (int, float)) or not restart_ts:
        ctx.kernel_messages.pop(RESTART_SLOT)
        return
    took = time.time() - float(restart_ts)
    if took < 1:
        took = 1
    if took > 600:
        took = "n/a"
    else:
        took = f"{round(took)}s"
    restarted = ctx.t("kernel.power.restarted", "Юзербот успешно перезапущен за {took}", took=took)
    text = f"<b>{restarted}</b>"
    ctx.kernel_messages.pop(RESTART_SLOT)
    try:
        await KernelMessageService.edit(ctx.bot, record, text)
    except Exception:
        pass

async def sundown(ctx):
    try:
        record = ctx.kernel_messages.get(SLOT)
        if record is not None:
            return
    except Exception:
        pass

async def task_status_sync(ctx):
    while True:
        try:
            record = ctx.kernel_messages.get(SLOT)
            if record is not None:
                expected = _text_running(ctx) if not ctx.runtime.kernel.suspended else _text_stopped(ctx)
                if record.text != expected:
                    if await KernelMessageService.edit(ctx.bot, record, expected):
                        ctx.kernel_messages.put(SLOT, "power", record.chat_id, record.message_id, expected, record.meta)
        except Exception:
            pass
        await asyncio.sleep(30)
