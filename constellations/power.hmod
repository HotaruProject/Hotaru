HOTARU = {
    "id": "power",
    "version": "1.5.0",
    "commands": ["restart", "stop", "resume"],
    "aliases": {"unpause": "resume"},
    "capabilities": ["mt"],
    "banner": "https://raw.githubusercontent.com/HotaruProject/Hotaru/develop/hotaru/assets/power.mp4",
    "fade": "sundown",
}

from typing import Any, cast


import asyncio
import logging
import time


log = logging.getLogger(__name__)


def _text_running(ctx: Any) -> Any:
    return ctx.t('kernel.power.running')

def _text_stopped(ctx: Any) -> Any:
    return ctx.t('kernel.power.stopped')

def _text_stopped_details(ctx: Any) -> Any:
    return f"{_text_stopped(ctx)}\n{ctx.t('kernel.power.stopped_details', prefix=ctx.runtime.config.prefix)}"

def _serialize_inline(value: Any) -> Any:
    if not isinstance(value, dict):
        return None
    v_dict = cast(dict[str, Any], value)
    out: dict[str, Any] = {"_": v_dict.get("_") if isinstance(v_dict.get("_"), str) else "inputBotInlineMessageID"}
    for key in ("dc_id", "id", "access_hash", "owner_id"):
        val = v_dict.get(key)
        if isinstance(val, int):
            out[key] = int(val)
    return out if isinstance(out.get("id"), int) else None

def _callback_inline(value: Any) -> Any:
    inline: Any = getattr(value, "inline_message_id", None)
    if inline is None:
        candidate: Any = getattr(value, "msg_id", None)
        inline = cast('dict[str, Any]', candidate) if isinstance(candidate, dict) else None
    return _serialize_inline(inline)

async def _peer_hex(runtime: Any, chat_id: Any) -> Any:
    if not isinstance(chat_id, int):
        return None
    app = getattr(runtime, "app", None)
    mt = getattr(app, "mt", None) if app is not None else None
    if mt is None or not hasattr(mt, "resolve_peer"):
        return None
    try:
        return (await mt.resolve_peer(chat_id)).hex()
    except (Exception, asyncio.CancelledError) as exc:
        log.error("power peer resolve failed for %s: %s: %s", chat_id, type(exc).__name__, exc)
        return None

async def command_stop(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime.kernel.suspended:
        await ctx.respond(ctx.t('kernel.power.already_stopped'))
        return
    args = [str(a).casefold() for a in getattr(invocation, "args", [])]
    if "-f" in args or "--force" in args:
        runtime.kernel.suspended = True
        if runtime.state is not None:
            runtime.state.set_setting("suspended", "1")
        await ctx.respond(_text_stopped_details(ctx), parse_mode="HTML")
        return
    k = ctx.screens
    screen = k.screen(
        ctx.t('kernel.power.stop_confirm', prefix=runtime.config.prefix),
        [
            [k.danger(ctx.t('kernel.power.stop_action'), confirm_stop)],
            [k.close()],
        ],
        rich=True,
    )
    await ctx.screens.show(screen)

async def confirm_stop(ctx: Any, nav: Any) -> Any:
    runtime = ctx.runtime
    runtime.kernel.suspended = True
    if runtime.state is not None:
        runtime.state.set_setting("suspended", "1")
    k = ctx.screens
    return k.screen(_text_stopped_details(ctx), [], rich=True)

async def command_resume(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if not runtime.kernel.suspended:
        await ctx.respond(ctx.t('kernel.power.already_running'), output="edit")
        return
    runtime.kernel.suspended = False
    if runtime.state is not None:
        runtime.state.set_setting("suspended", "0")
    await ctx.respond(_text_running(ctx), parse_mode="HTML", output="edit")

command_start = command_resume

async def command_restart(ctx: Any, invocation: Any) -> Any:
    args = [str(a).casefold() for a in getattr(invocation, "args", [])]
    if any(flag in args for flag in ("-f", "--force", "force", "f")):
        runtime = ctx.runtime
        chat_id = getattr(ctx, "chat_id", None)
        orig_msg_id = getattr(ctx, "message_id", None)
        peer_hex = await _peer_hex(runtime, chat_id)
        sent = await ctx.respond(ctx.t("kernel.power.restarting"), parse_mode="HTML", output="edit")
        target_msg_id = orig_msg_id
        if sent is not None:
            from goygram.sugar import extract_sent_message
            raw_msg = extract_sent_message(getattr(sent, "message", None))
            if raw_msg and raw_msg.get("id"):
                target_msg_id = int(raw_msg["id"])
            elif getattr(sent, "id", None):
                target_msg_id = int(sent.id)
        if isinstance(chat_id, int) and isinstance(target_msg_id, int):
            ctx.state.set("restart_pending", {"chat_id": chat_id, "message_id": target_msg_id, "peer": peer_hex, "inline_id": None, "bot": False, "ts": time.time()})
        runtime.request_restart()
        async def _do_shutdown() -> None:
            await asyncio.sleep(0.5)
            try:
                if runtime.app is not None:
                    await asyncio.wait_for(runtime.app.close(), timeout=2.0)
            except Exception:
                pass
        asyncio.create_task(_do_shutdown(), name="hotaru:forced-restart")
        return
    k = ctx.screens
    screen = k.screen(
        ctx.t('kernel.power.restart_confirm'),
        [
            [k.primary(ctx.t('kernel.power.restart_action'), confirm_restart)],
            [k.close()],
        ],
        rich=True,
    )
    await ctx.screens.show(screen)

async def confirm_restart(ctx: Any, nav: Any) -> Any:
    runtime = ctx.runtime
    chat_id = nav.form.chat
    message_id = nav.form.message_id
    inline_id = _callback_inline(nav.call) or _serialize_inline(getattr(nav.form, "inline_id", None))
    peer_hex = await _peer_hex(runtime, chat_id)
    if isinstance(chat_id, int) and isinstance(message_id, int):
        ctx.state.set("restart_pending", {"chat_id": chat_id, "message_id": message_id, "peer": peer_hex, "inline_id": inline_id, "bot": bool(nav.form.bot), "ts": time.time()})
    runtime.request_restart()

    async def _do_shutdown() -> None:
        await asyncio.sleep(0.3)
        try:
            if runtime.app:
                await asyncio.wait_for(runtime.app.close(), timeout=1.5)
        except (Exception, asyncio.CancelledError) as exc:
            log.error("restart shutdown failed: %s: %s", type(exc).__name__, exc)

    asyncio.create_task(_do_shutdown())
    return ctx.screens.screen(ctx.t('kernel.power.restarting'), rich=True)

async def sundown(ctx: Any) -> Any:
    return None
