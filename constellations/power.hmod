HOTARU = {
    "id": "power",
    "version": "1.4.0",
    "commands": ["restart", "stop", "start"],
    "capabilities": ["mt"],
    "rise": "sunrise",
    "fade": "sundown",
}

from typing import Any, Mapping, cast


import asyncio
import time


def _text_running(ctx: Any) -> Any:
    return f"<b>{ctx.t('kernel.power.running')}</b>"

def _text_stopped(ctx: Any) -> Any:
    return f"<b>{ctx.t('kernel.power.stopped')}</b>"

async def command_stop(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime.kernel.suspended:
        await ctx.respond(ctx.t('kernel.power.already_stopped'))
        return
    runtime.kernel.suspended = True
    if runtime.state is not None:
        runtime.state.set_setting("suspended", "1")
    await ctx.respond(_text_stopped(ctx), parse_mode="HTML")

async def command_start(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if not runtime.kernel.suspended:
        await ctx.respond(ctx.t('kernel.power.already_running'))
        return
    runtime.kernel.suspended = False
    if runtime.state is not None:
        runtime.state.set_setting("suspended", "0")
    await ctx.respond(_text_running(ctx), parse_mode="HTML")

async def command_restart(ctx: Any, invocation: Any) -> Any:
    chat_id = getattr(ctx.message, "chat_id", None)
    message_id = getattr(ctx.message, "id", None)
    peer_hex = None
    if isinstance(chat_id, int):
        try:
            app = getattr(ctx.runtime, "app", None)
            mt = getattr(app, "mt", None) if app is not None else None
            if mt is not None and hasattr(mt, "resolve_peer"):
                peer_hex = (await mt.resolve_peer(chat_id)).hex()
        except Exception:
            peer_hex = None
    await ctx.respond(ctx.t('kernel.power.restarting'), parse_mode="HTML")
    target_id = ctx.response_message_id
    if isinstance(target_id, int):
        message_id = target_id
    if isinstance(chat_id, int) and isinstance(message_id, int):
        ctx.state.set("restart_pending", {"chat_id": chat_id, "message_id": message_id, "peer": peer_hex, "ts": time.time()})

    ctx.runtime.request_restart()
    try:
        if ctx.runtime.app:
            await asyncio.wait_for(ctx.runtime.app.close(), timeout=1.0)
    except Exception:
        pass

async def sunrise(ctx: Any) -> Any:
    pending = ctx.state.get("restart_pending")
    if not isinstance(pending, dict):
        return
    pending = cast(Mapping[str, object], pending)
    ctx.state.delete("restart_pending")
    ts = pending.get("ts")
    chat_id = pending.get("chat_id")
    message_id = pending.get("message_id")
    peer = pending.get("peer")
    peer_hex = peer if isinstance(peer, str) else None
    if not (isinstance(chat_id, int) and isinstance(message_id, int)):
        return
    took = max(1, round(time.time() - float(ts))) if isinstance(ts, (int, float)) else None
    took = ctx.t("common.seconds", n=took) if took is not None else ctx.t("common.unknown")
    text = ctx.t('kernel.power.restarted', took=took)
    html = f"<b>{text}</b>"
    rich = {"_": "inputRichMessageHTML", "html": html}
    try:
        if peer_hex:
            await ctx.tg.call("messages.editMessage", {"id": message_id, "rich_message": rich, "peer": bytes.fromhex(peer_hex)})
        else:
            await ctx.tg.edit_rich(message_id, html, peer=chat_id)
    except Exception:
        try:
            await ctx.tg.edit_rich(message_id, html, peer=chat_id)
        except Exception:
            pass

async def sundown(ctx: Any) -> Any:
    return None
