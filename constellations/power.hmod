HOTARU = {
    "id": "power",
    "version": "1.0.0",
    "description": "High-level power management (restart, stop, start)",
    "commands": ["restart", "stop", "start"],
    "capabilities": [],
}

async def command_stop(ctx, invocation):
    if ctx.runtime.kernel.suspended:
        await ctx.respond("Юзербот уже остановлен (приостановлен).")
        return
        
    ctx.runtime.kernel.suspended = True
    if ctx.runtime.state is not None:
        ctx.runtime.state.set_setting("suspended", "1")
        
    await ctx.respond(
        "Юзербот остановлен (приостановлен).\n"
        "Обычные модули отключены, но команды ядра (например, .start) продолжают работать."
    )

async def command_start(ctx, invocation):
    if not ctx.runtime.kernel.suspended:
        await ctx.respond("Юзербот уже запущен.")
        return
        
    ctx.runtime.kernel.suspended = False
    if ctx.runtime.state is not None:
        ctx.runtime.state.set_setting("suspended", "0")
        
    await ctx.respond("Юзербот запущен. Обработка всех команд возобновлена.")

async def command_restart(ctx, invocation):
    import os
    import sys
    import subprocess
    
    await ctx.respond("Перезапускаю юзербот...")
    
    try:
        if ctx.runtime.app:
            import asyncio
            await asyncio.wait_for(ctx.runtime.app.close(), timeout=1.0)
    except Exception:
        pass
        
    # Determine if started by systemd
    if "INVOCATION_ID" in os.environ:
        service_name = None
        is_user_service = False
        try:
            with open("/proc/self/cgroup", "r") as f:
                for line in f:
                    if ".service" in line:
                        service_name = line.strip().split("/")[-1]
                        if "user.slice" in line or "user@" in line:
                            is_user_service = True
                        break
        except Exception:
            pass
            
        if service_name:
            cmd = ["systemctl"]
            if is_user_service or os.geteuid() != 0:
                cmd.append("--user")
            cmd.extend(["restart", service_name])
            
            # Fork a background process to restart the service via systemctl
            subprocess.Popen(
                cmd,
                start_new_session=True,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            sys.exit(0)
            
    # Default fallback: replace the current process (keeps same env, args, PID)
    os.execv(sys.executable, [sys.executable] + sys.argv)
