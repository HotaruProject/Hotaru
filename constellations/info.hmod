                '<tg-emoji emoji-id="5258258882022612173">⏳</tg-emoji> <b>Uptime:</b> <code>{uptime}</code>'
            ),
            "max_len": 4096,
            "description": "Custom message template for .ping",
            "legacy_braces": True,
            "template_fields": {
                "latency": {"type": "float", "example": 48.25, "format": ".2f", "description": "Response time in milliseconds"},
                "ping": {"type": "float", "example": 48.25, "format": ".2f", "description": "Response time in milliseconds"},
                "uptime": {"type": "str", "example": "2h 3m", "description": "Userbot uptime"},
                "uptime_seconds": {"type": "int", "example": 7380, "description": "Userbot uptime in seconds"},
                "modules": {"type": "int", "example": 15, "description": "Number of loaded modules"},
                "version": {"type": "str", "example": "2.2.0", "description": "Hotaru version"},
                "wordmark": {"type": "str", "example": "⚡⚡⚡⚡", "description": "Hotaru wordmark"},
                "wm": {"type": "str", "example": "⚡⚡⚡⚡", "description": "Hotaru wordmark shortcut"},
                "user": {"type": "str", "example": "@username", "description": "User handle or display name"},
                "owner_id": {"type": "int", "example": 123456789, "description": "Owner Telegram ID"},
            },
            "category": "General",
        },
    },
}

import html
import time
from typing import TYPE_CHECKING, Any

if TYPE_CHECKING:
    from hotaru.commands import CommandInvocation
    from hotaru.response import ModuleContext


async def _user_handle(ctx: 'ModuleContext', invocation: 'CommandInvocation', owner_id: Any) -> str:
    msg = invocation.message
    display_name = None
    username = None

    def _extract(data: Any) -> None:
        nonlocal display_name, username
        if not data:
            return
        if hasattr(data, "raw") and isinstance(data.raw, dict):
            raw = data.raw
        elif isinstance(data, dict):
            raw = data
        else:
            raw = {}
        un = raw.get("username") or getattr(data, "username", None)
        fn = raw.get("first_name") or getattr(data, "first_name", None)
        ln = raw.get("last_name") or getattr(data, "last_name", None)
        title = raw.get("title") or getattr(data, "title", None)
        if not username and un:
            username = str(un).lstrip("@")
        if not display_name:
            if fn and ln:
                display_name = f"{fn} {ln}".strip()
            elif fn:
                display_name = str(fn).strip()
            elif title:
                display_name = str(title).strip()

    if msg is not None:
        _extract(getattr(msg, "from_user", None))
        if hasattr(msg, "raw") and isinstance(msg.raw, dict):
            _extract(msg.raw.get("from"))
            _extract(msg.raw.get("sender_chat"))
            _extract(msg.raw.get("chat"))
        _extract(getattr(msg, "sender_chat", None))

    app = getattr(getattr(ctx, "runtime", None), "app", None)
    if app is not None and (not username or not display_name):
        _extract(getattr(app, "_me_cache", None))
        session = getattr(app, "session", None)
        if session is not None and hasattr(session, "data") and isinstance(session.data, dict):
            _extract(session.data.get("user"))
        if (not username or not display_name) and hasattr(app, "get_me"):
            try:
                me = await app.get_me()
                _extract(me)
            except Exception:
                pass
        if (not username or not display_name) and hasattr(app, "mt_req") and getattr(app, "mt", None) is not None:
            try:
                raw_users = await app.mt_req("users.getUsers", id=[{"_": "inputUserSelf"}])
                from goygram.client import _find_ctor
                u = _find_ctor(raw_users, "user")
                _extract(u)
            except Exception:
                pass

    nickname = display_name or (f"@{username}" if username else None) or (f"id:{owner_id}" if owner_id else "User")

    if username:
        return f'<a href="https://t.me/{username}">@{username}</a>'
    if isinstance(owner_id, int):
        target_name = html.escape(str(nickname))
        return f'<a href="tg://user?id={owner_id}">{target_name}</a>'
    return html.escape(str(nickname))


async def command_info(ctx: 'ModuleContext', invocation: 'CommandInvocation') -> None:
    start = time.perf_counter()
    ping_ms = 48.25
    try:
        app = getattr(getattr(ctx, "runtime", None), "app", None)
        if app is not None and hasattr(app, "mt_req") and getattr(app, "mt", None) is not None:
            await app.mt_req("help.getNearestDc")
            ping_ms = max(1.0, (time.perf_counter() - start) * 1000)
    except Exception:
        pass

    runtime = ctx.runtime
    uptime_s = max(0, int(time.monotonic() - runtime.started_at)) if runtime and hasattr(runtime, "started_at") else 0
    hours = uptime_s // 3600
    minutes = (uptime_s % 3600) // 60
    seconds = uptime_s % 60
    uptime_fmt = f"{hours}:{minutes:02d}:{seconds:02d}"

    modules = 0
    mod_mgr = getattr(runtime, "modules", None)
    if mod_mgr is not None and hasattr(mod_mgr, "items"):
        modules = len(mod_mgr.items())

    owner_id = getattr(getattr(runtime, "config", None), "owner_id", None) or getattr(invocation.message, "from_id", None)
    user_handle = await _user_handle(ctx, invocation, owner_id)

    wm = ctx.wordmark() if hasattr(ctx, "wordmark") else ctx.screens.wordmark() if hasattr(ctx, "screens") and hasattr(ctx.screens, "wordmark") else '<tg-emoji emoji-id="5985527717183888277">⚡</tg-emoji><tg-emoji emoji-id="5985515480822061758">⚡</tg-emoji><tg-emoji emoji-id="5985558606588681366">⚡</tg-emoji><tg-emoji emoji-id="5985757321840565902">⚡</tg-emoji>'
    owner_int = owner_id if isinstance(owner_id, int) else 0

    body = await ctx.render_template_async(
        "custominfo",
        latency=ping_ms,
        ping=ping_ms,
        uptime=uptime_fmt,
        uptime_seconds=uptime_s,
        modules=modules,
        version=str(ctx.version),
        wordmark=wm,
        wm=wm,
        user=user_handle,
        owner_id=owner_int,
    )

    if hasattr(ctx, "screens") and hasattr(ctx.screens, "show"):
        k = ctx.screens
        screen = k.screen(body, [[k.close()]], banner=k.banner("info"), rich=True)
        await ctx.screens.show(screen)
    else:
        await ctx.respond(body, parse_mode="HTML", rich=True)


async def command_ping(ctx: 'ModuleContext', invocation: 'CommandInvocation') -> None:
    start = time.perf_counter_ns()
    await ctx.respond(ctx.t("kernel.ping.measuring"), parse_mode="HTML")
    ping_ms = (time.perf_counter_ns() - start) / 10**6
    uptime_s = ctx.uptime
    lang = getattr(getattr(ctx, "i18n", None), "language", "en")
    uptime = ctx.tools.duration(uptime_s, lang) if hasattr(ctx, "tools") else f"{uptime_s}s"

    runtime = ctx.runtime
    modules = 0
    mod_mgr = getattr(runtime, "modules", None)
    if mod_mgr is not None and hasattr(mod_mgr, "items"):
        modules = len(mod_mgr.items())

    owner_id = getattr(getattr(runtime, "config", None), "owner_id", None) or getattr(invocation.message, "from_id", None)
    user_handle = await _user_handle(ctx, invocation, owner_id)

    wm = ctx.wordmark() if hasattr(ctx, "wordmark") else ctx.screens.wordmark() if hasattr(ctx, "screens") and hasattr(ctx.screens, "wordmark") else '<tg-emoji emoji-id="5985527717183888277">⚡</tg-emoji><tg-emoji emoji-id="5985515480822061758">⚡</tg-emoji><tg-emoji emoji-id="5985558606588681366">⚡</tg-emoji><tg-emoji emoji-id="5985757321840565902">⚡</tg-emoji>'
    owner_int = owner_id if isinstance(owner_id, int) else 0

    text = await ctx.render_template_async(
        "customping",
        latency=ping_ms,
        ping=ping_ms,
        uptime=uptime,
        uptime_seconds=uptime_s,
        modules=modules,
        version=str(ctx.version),
        wordmark=wm,
        wm=wm,
        user=user_handle,
        owner_id=owner_int,
    )
    await ctx.respond(text, parse_mode="HTML", output="edit")
