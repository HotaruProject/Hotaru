HOTARU = {
    "id": "info",
    "version": "1.5.0",
    "commands": ["info"],
    "capabilities": ["mt"],
    "config_schema": {
        "template": {
            "type": "str",
            "default_key": "kernel.info.template",
            "max_len": 3000,
            "category": "General",
        },
    },
}

import time
from typing import TYPE_CHECKING, Dict, Union

if TYPE_CHECKING:
    from hotaru.commands import CommandInvocation
    from hotaru.response import ModuleContext


def _placeholders(ctx: 'ModuleContext') -> Dict[str, Union[str, int]]:
    runtime = ctx.runtime
    uptime_s = max(0, int(time.monotonic() - ctx.runtime.started_at))
    uptime = ctx.tools.duration(uptime_s, ctx.i18n.language)
    modules = 0
    mod_mgr = getattr(runtime, "modules", None)
    if mod_mgr is not None and hasattr(mod_mgr, "items"):
        modules = len(mod_mgr.items())
    return {
        "version": ctx.version,
        "uptime": uptime,
        "modules": modules,
    }


async def command_info(ctx: 'ModuleContext', invocation: 'CommandInvocation') -> None:
    template = ctx.config.get("template")
    if not template:
        await ctx.respond(ctx.t("kernel.info.empty_template"))
        return
    values = _placeholders(ctx)
    try:
        text = template.format(**values)
    except (KeyError, IndexError, ValueError) as exc:
        await ctx.respond(ctx.t("kernel.info.bad_placeholder", error=str(exc)))
        return
    await ctx.respond(text, parse_mode="HTML", rich=True, rich_fallback="bot")
