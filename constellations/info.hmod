    "banner": "https://raw.githubusercontent.com/HotaruProject/Hotaru/develop/hotaru/assets/info.mp4",
    "config_schema": {
        "custominfo": {
            "type": "str",
            "default": (
                '<table bordered striped compact>'
                '<tr><th colspan="2" align="center">{wordmark} · <code>v{version}</code></th></tr>'
                '<tr><td><tg-emoji emoji-id="5289589186683222806">📶</tg-emoji> <b>Ping:</b></td><td align="right"><code>{latency:.2f} ms</code></td></tr>'
                '<tr><td><tg-emoji emoji-id="5258258882022612173">⏱</tg-emoji> <b>Uptime:</b></td><td align="right"><code>{uptime}</code></td></tr>'
                '<tr><td><tg-emoji emoji-id="5325732612084351248">📦</tg-emoji> <b>Modules:</b></td><td align="right"><code>{modules} loaded</code></td></tr>'
                '</table>'
