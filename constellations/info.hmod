        },
    },
}

import time
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from hotaru.commands import CommandInvocation
    from hotaru.response import ModuleContext


async def command_info(ctx: 'ModuleContext', invocation: 'CommandInvocation') -> None:
    start = time.perf_counter()
    try:
        if hasattr(ctx, "call"):
            await ctx.call("help.getNearestDc")
            ping_ms = max(1.0, (time.perf_counter() - start) * 1000)
        else:
            ping_ms = 48.25
    except Exception:
        ping_ms = 48.25

    runtime = ctx.runtime
    uptime_s = max(0, int(time.monotonic() - runtime.started_at)) if runtime and hasattr(runtime, "started_at") else 0
    hours = uptime_s // 3600
    minutes = (uptime_s % 3600) // 60
    seconds = uptime_s % 60
    uptime_fmt = f"{hours}:{minutes:02d}:{seconds:02d}"

    modules = 0
    mod_mgr = getattr(runtime, "modules", None)
    if mod_mgr is not None and hasattr(mod_mgr, "items"):
        modules = len(mod_mgr.items())

    owner_id = getattr(getattr(runtime, "config", None), "owner_id", None) or getattr(invocation.message, "from_id", None)
    user_handle = "Hotaru User"
    msg = invocation.message
    if hasattr(msg, "from_user") and getattr(msg.from_user, "username", None):
        user_handle = f'<a href="https://t.me/{msg.from_user.username}">@{msg.from_user.username}</a>'
    elif hasattr(msg, "sender_chat") and getattr(msg.sender_chat, "username", None):
        user_handle = f'<a href="https://t.me/{msg.sender_chat.username}">@{msg.sender_chat.username}</a>'
    elif isinstance(owner_id, int):
        user_handle = f'<a href="tg://user?id={owner_id}">id:{owner_id}</a>'

    wm = ctx.wordmark() if hasattr(ctx, "wordmark") else ctx.screens.wordmark() if hasattr(ctx, "screens") and hasattr(ctx.screens, "wordmark") else '<tg-emoji emoji-id="5985527717183888277">⚡</tg-emoji><tg-emoji emoji-id="5985515480822061758">⚡</tg-emoji><tg-emoji emoji-id="5985558606588681366">⚡</tg-emoji><tg-emoji emoji-id="5985757321840565902">⚡</tg-emoji>'
    owner_int = owner_id if isinstance(owner_id, int) else 0

    body = await ctx.render_template_async(
        "custominfo",
        latency=ping_ms,
        ping=ping_ms,
        uptime=uptime_fmt,
        uptime_seconds=uptime_s,
        modules=modules,
        version=str(ctx.version),
        wordmark=wm,
        wm=wm,
        user=user_handle,
        owner_id=owner_int,
    )

    await ctx.respond(body, parse_mode="HTML", output="edit")


async def command_ping(ctx: 'ModuleContext', invocation: 'CommandInvocation') -> None:
    start = time.perf_counter_ns()
    await ctx.respond(ctx.t("kernel.ping.measuring"), parse_mode="HTML")
    ping_ms = (time.perf_counter_ns() - start) / 10**6
    uptime_s = ctx.uptime
    lang = getattr(getattr(ctx, "i18n", None), "language", "en")
    uptime = ctx.tools.duration(uptime_s, lang) if hasattr(ctx, "tools") else f"{uptime_s}s"

    runtime = ctx.runtime
    modules = 0
    mod_mgr = getattr(runtime, "modules", None)
    if mod_mgr is not None and hasattr(mod_mgr, "items"):
        modules = len(mod_mgr.items())

    owner_id = getattr(getattr(runtime, "config", None), "owner_id", None) or getattr(invocation.message, "from_id", None)
    user_handle = "Hotaru User"
    msg = invocation.message
    if hasattr(msg, "from_user") and getattr(msg.from_user, "username", None):
        user_handle = f'<a href="https://t.me/{msg.from_user.username}">@{msg.from_user.username}</a>'
    elif hasattr(msg, "sender_chat") and getattr(msg.sender_chat, "username", None):
        user_handle = f'<a href="https://t.me/{msg.sender_chat.username}">@{msg.sender_chat.username}</a>'
    elif isinstance(owner_id, int):
        user_handle = f'<a href="tg://user?id={owner_id}">id:{owner_id}</a>'

    wm = ctx.wordmark() if hasattr(ctx, "wordmark") else ctx.screens.wordmark() if hasattr(ctx, "screens") and hasattr(ctx.screens, "wordmark") else '<tg-emoji emoji-id="5985527717183888277">⚡</tg-emoji><tg-emoji emoji-id="5985515480822061758">⚡</tg-emoji><tg-emoji emoji-id="5985558606588681366">⚡</tg-emoji><tg-emoji emoji-id="5985757321840565902">⚡</tg-emoji>'
    owner_int = owner_id if isinstance(owner_id, int) else 0

    text = await ctx.render_template_async(
        "customping",
        latency=ping_ms,
        ping=ping_ms,
        uptime=uptime,
        uptime_seconds=uptime_s,
        modules=modules,
        version=str(ctx.version),
        wordmark=wm,
        wm=wm,
        user=user_handle,
        owner_id=owner_int,
    )
    await ctx.respond(text, parse_mode="HTML", output="edit")
