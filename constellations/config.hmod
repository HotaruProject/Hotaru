HOTARU = {
    "id": "config",
    "version": "2.2.0",
    "commands": ["conf"],
    "capabilities": ["mt"],
}

from typing import Any, Callable, Dict, List, Tuple, cast
import html
import re
from hotaru.config import (
    BooleanValidator,
    ChoiceValidator,
    ConfigSchema,
    ConfigField,
    FloatValidator,
    IntegerValidator,
    ModuleConfig,
)


def _escape(value: Any) -> str:
    return html.escape(str(value), quote=False)


def _localized_schema(ctx: Any, manifest: Any) -> ConfigSchema:
    localized = manifest.localized(ctx.i18n.language)
    descriptions = localized.get("config", {})
    defaults = localized.get("config_defaults", {})
    descriptions = cast(Dict[str, Any], descriptions) if isinstance(descriptions, dict) else {}
    defaults = cast(Dict[str, Any], defaults) if isinstance(defaults, dict) else {}
    schema: Dict[str, Any] = {key: dict(cast(Dict[str, Any], spec)) if isinstance(spec, dict) else spec for key, spec in manifest.config_schema.items()}
    for key, value in schema.items():
        if isinstance(value, dict):
            spec = cast(Dict[str, Any], value)
            if isinstance(descriptions.get(key), str):
                spec["description"] = descriptions[key]
            if key in defaults:
                spec["default"] = defaults[key]
    return ConfigSchema.from_manifest(schema)


def _find_modules(ctx: Any) -> List[Tuple[str, ConfigSchema]]:
    runtime = ctx.runtime
    items: List[Tuple[str, ConfigSchema]] = []
    modules = getattr(runtime, "modules", None)
    if modules is not None and hasattr(modules, "items"):
        for mod in modules.items():
            if getattr(mod, "loaded", None) and getattr(mod.loaded, "manifest", None):
                manifest = mod.loaded.manifest
                if getattr(manifest, "config_schema", None):
                    schema = _localized_schema(ctx, manifest)
                    if len(schema) > 0:
                        items.append((str(manifest.module_id), schema))
    return items


def _directory_form(ctx: Any) -> Dict[str, Any]:
    modules = _find_modules(ctx)
    if not modules:
        return {
            "text": ctx.t("kernel.config.directory_empty"),
            "buttons": [[ctx.ui.close(ctx.t("common.close"))]],
            "inline": True,
        }

    text = ctx.t("kernel.config.directory")
    buttons: List[List[Any]] = []
    row: List[Any] = []

    for mod_id, _schema in modules:
        def make_handler(m: str) -> Any:
            async def handler(c: Any, p: Any) -> Any:
                await c.respond()
                await c.edit(**_module_form(ctx, m))
            return handler

        row.append(ctx.ui.button(f"📦 {mod_id}", make_handler(mod_id)))
        if len(row) == 2:
            buttons.append(row)
            row = []

    if row:
        buttons.append(row)

    buttons.append([ctx.ui.close(ctx.t("common.close"))])
    return {"text": text, "buttons": buttons, "inline": True, "module_id": "config"}


def _module_form(ctx: Any, module_id: str) -> Dict[str, Any]:
    runtime = ctx.runtime
    modules = getattr(runtime, "modules", None)
    active = modules.get(module_id) if modules is not None and hasattr(modules, "get") else None
    if not active or not getattr(active, "loaded", None):
        return {
            "text": ctx.t("kernel.config.module_missing_error", module=_escape(module_id)),
            "buttons": [[ctx.ui.close(ctx.t("common.close"))]],
            "inline": True,
            "module_id": module_id,
        }

    manifest = active.loaded.manifest
    if not manifest or not manifest.config_schema:
        return {
            "text": ctx.t("kernel.config.no_settings", module=_escape(module_id)),
            "buttons": [[ctx.ui.close(ctx.t("common.close"))]],
            "inline": True,
            "module_id": module_id,
        }

    schema = _localized_schema(ctx, manifest)
    namespace = runtime.state.namespace(module_id)
    mod_config = ModuleConfig(module_id, namespace, schema, translate=ctx.t)

    text = f"<b>{_escape(module_id)}</b>\n\n"
    param_buttons: List[Any] = []

    for key, field in schema.items():
        val = mod_config.get(key)
        disp = field.format_value(val)
        disp_str = disp if disp != "" else ctx.t("kernel.config.empty")
        text += f"• <b>{_escape(key)}</b>: <code>{_escape(disp_str)}</code>\n"



        def make_param_handler(k: str) -> Any:
            async def handler(c: Any, p: Any) -> Any:
                await c.edit(**_parameter_form(ctx, module_id, k))
            return handler

        param_buttons.append(ctx.ui.button(f"⚙️ {key}", make_param_handler(key)))

    buttons: List[List[Any]] = []
    for i in range(0, len(param_buttons), 2):
        buttons.append(param_buttons[i:i + 2])

    async def on_back(c: Any, p: Any) -> Any:
        await c.edit(**_directory_form(ctx))

    buttons.append([ctx.ui.button(ctx.t("common.back"), on_back), ctx.ui.close(ctx.t("common.close"))])
    return {"text": text, "buttons": buttons, "inline": True, "module_id": module_id}


def _parameter_form(ctx: Any, module_id: str, key: str, page: int = 0) -> Dict[str, Any]:
    runtime = ctx.runtime
    modules = getattr(runtime, "modules", None)
    active = modules.get(module_id) if modules is not None and hasattr(modules, "get") else None
    if not active or not getattr(active, "loaded", None):
        return {
            "text": ctx.t("kernel.config.module_missing_error", module=_escape(module_id)),
            "buttons": [[ctx.ui.close(ctx.t("common.close"))]],
            "inline": True,
            "module_id": module_id,
        }

    manifest = active.loaded.manifest
    if not manifest or not manifest.config_schema:
        return {
            "text": ctx.t("kernel.config.no_settings", module=_escape(module_id)),
            "buttons": [[ctx.ui.close(ctx.t("common.close"))]],
            "inline": True,
            "module_id": module_id,
        }

    schema = _localized_schema(ctx, manifest)
    field = schema.get(key)
    if not field:
        return {
            "text": ctx.t("kernel.config.parameter_missing_error", parameter=_escape(key)),
            "buttons": [[ctx.ui.close(ctx.t("common.close"))]],
            "inline": True,
            "module_id": module_id,
        }

    namespace = runtime.state.namespace(module_id)
    mod_config = ModuleConfig(module_id, namespace, schema, translate=ctx.t)
    val = mod_config.get(key)
    disp = field.format_value(val)
    disp_str = disp if disp != "" else ctx.t("kernel.config.empty")
    default = mod_config.default(key)
    def_str = str(default) if default is not None and str(default) != "" else ctx.t("kernel.config.empty")
    if field.template_fields is not None:
        disp_str = ctx.tools.truncate(disp_str, 200)
        def_str = ctx.tools.truncate(def_str, 200)


    text = (
        f"<b>{_escape(module_id)}</b> ➜ <b>{_escape(key)}</b>\n\n"
        + ctx.t("kernel.config.parameter_details", value=_escape(disp_str), type=_escape(field.validator.name), default=_escape(def_str))
    )

    if field.description:
        description = ctx.tools.truncate(field.description, 120) if field.template_fields is not None else field.description
        text += ctx.t("kernel.config.parameter_description", description=_escape(description))

    pages = 1
    if field.template_fields is not None:
        title = ctx.t("kernel.config.template_fields")
        text += f"\n<b>{_escape(title)}</b>\n"
        preview_fields = {name: dict(meta) for name, meta in field.template_fields.items()}
        preview_fields.update(runtime.modules.template_catalog(module_id))
        for meta in preview_fields.values():
            if meta.get("example_key"):
                meta["example"] = ctx.t(meta["example_key"], str(meta["example"]))
        pages = (len(preview_fields) + 2) // 3
        page = max(0, min(page, pages - 1))
        if pages > 1:
            text += f"{page + 1}/{pages}\n"
        for name, meta in list(preview_fields.items())[page * 3:(page + 1) * 3]:
            description = meta.get("description", "")
            if isinstance(description, dict):
                localized = cast(Dict[str, str], description)
                description = localized.get(ctx.i18n.language) or localized.get("en") or next(iter(localized.values()), "")
            if meta.get("description_key"):
                description = ctx.t(meta["description_key"], str(description) or name)
            description = ctx.tools.truncate(str(description), 120)
            example = ctx.tools.truncate(ctx.tools.template_render("{" + name + "}", {name: meta}), 80)
            text += f"• <code>{{{_escape(name)}}}</code> ({_escape(meta['type'])}) — {_escape(description)}\n  <code>{_escape(example)}</code>\n"
        text += "\n" + _escape(ctx.t("kernel.config.template_syntax")) + "\n"
        preview_label = ctx.t("kernel.config.template_preview")
        try:
            preview_names = ctx.tools.template_names(val, legacy_braces=field.legacy_braces)
            for name in preview_names:
                if "/" in name and name not in preview_fields:
                    raise ValueError(ctx.t("kernel.config.template_unavailable", name=name))
            preview = ctx.tools.template_render(val, {name: meta for name, meta in preview_fields.items() if name in preview_names or name in field.template_fields}, legacy_braces=field.legacy_braces)
        except ValueError as exc:
            preview = str(exc)
        preview = ctx.tools.truncate(preview, 400)
        text += f"\n<b>{_escape(preview_label)}</b>\n<pre>{_escape(preview)}</pre>\n"

    buttons: List[List[Any]] = []
    if pages > 1:
        def change_page(destination: int) -> Any:
            async def handler(c: Any, p: Any) -> Any:
                await c.edit(**_parameter_form(ctx, module_id, key, destination))
            return handler
        navigation: List[Any] = []
        if page > 0:
            navigation.append(ctx.ui.button("◀", change_page(page - 1)))
        if page + 1 < pages:
            navigation.append(ctx.ui.button("▶", change_page(page + 1)))
        buttons.append(navigation)

    def make_input_handler(k: str, field_obj: Any) -> Any:
        async def handler(c: Any, p: Any = None) -> Any:
            typed = getattr(c, "value", None)
            if typed is None and isinstance(p, str):
                typed = p
            if typed is None:
                return
            try:
                coerced = field_obj.parse_input(str(typed))
                mod_config.set(k, coerced)
            except Exception as exc:
                try:
                    await c.respond(ctx.t("kernel.config.error", error=str(exc)), alert=True)
                except Exception:
                    pass
                return
            await c.edit(**_parameter_form(ctx, module_id, k))
        return handler


    if isinstance(field.validator, BooleanValidator):
        def make_toggle(cur_v: bool) -> Any:
            async def handler(c: Any, p: Any) -> Any:
                mod_config.set(key, not cur_v)
                await c.edit(**_parameter_form(ctx, module_id, key))
            return handler

        lbl = ctx.t("kernel.config.boolean_true") if bool(val) else ctx.t("kernel.config.boolean_false")
        buttons.append([ctx.ui.button(lbl, make_toggle(bool(val)))])

    elif isinstance(field.validator, ChoiceValidator):
        choice_row: List[Any] = []
        for opt in field.validator.options:
            def make_choice(chosen: Any) -> Any:
                async def handler(c: Any, p: Any) -> Any:
                    mod_config.set(key, chosen)
                    await c.edit(**_parameter_form(ctx, module_id, key))
                return handler

            is_sel = (opt == val or str(opt).casefold() == str(val).casefold())
            lbl = f"🔘 {opt}" if is_sel else f"⚪️ {opt}"
            choice_row.append(ctx.ui.button(lbl, make_choice(opt)))
        for i in range(0, len(choice_row), 3):
            buttons.append(choice_row[i:i + 3])

    elif isinstance(field.validator, IntegerValidator):
        cur_i = int(val) if isinstance(val, int) else field.validator.default
        v_int = field.validator

        def make_int_step(delta: int, cur: int, validator: IntegerValidator) -> Any:
            async def handler(c: Any, p: Any) -> Any:
                new_val = cur + delta
                if validator.minimum is not None and new_val < validator.minimum:
                    await c.respond(ctx.t("kernel.config.minimum", value=validator.minimum), alert=True)
                    return
                if validator.maximum is not None and new_val > validator.maximum:
                    await c.respond(ctx.t("kernel.config.maximum", value=validator.maximum), alert=True)
                    return
                mod_config.set(key, new_val)
                await c.edit(**_parameter_form(ctx, module_id, key))
            return handler

        buttons.append([
            ctx.ui.button("-1", make_int_step(-1, cur_i, v_int)),
            ctx.ui.button("+1", make_int_step(1, cur_i, v_int)),
        ])
        buttons.append([ctx.ui.input(ctx.t("kernel.config.enter"), make_input_handler(key, field), placeholder=ctx.t("kernel.config.new_value", parameter=key))])

    elif isinstance(field.validator, FloatValidator):
        cur_f = float(val) if isinstance(val, (int, float)) else field.validator.default
        v_flt = field.validator

        def make_flt_step(delta: float, cur: float, validator: FloatValidator) -> Any:
            async def handler(c: Any, p: Any) -> Any:
                new_val = round(cur + delta, 2)
                if validator.minimum is not None and new_val < validator.minimum:
                    await c.respond(ctx.t("kernel.config.minimum", value=validator.minimum), alert=True)
                    return
                if validator.maximum is not None and new_val > validator.maximum:
                    await c.respond(ctx.t("kernel.config.maximum", value=validator.maximum), alert=True)
                    return
                mod_config.set(key, new_val)
                await c.edit(**_parameter_form(ctx, module_id, key))
            return handler

        buttons.append([
            ctx.ui.button("-0.5", make_flt_step(-0.5, cur_f, v_flt)),
            ctx.ui.button("+0.5", make_flt_step(0.5, cur_f, v_flt)),
        ])
        buttons.append([ctx.ui.input(ctx.t("kernel.config.enter"), make_input_handler(key, field), placeholder=ctx.t("kernel.config.new_value", parameter=key))])

    else:
        buttons.append([ctx.ui.input(ctx.t("kernel.config.enter"), make_input_handler(key, field), placeholder=ctx.t("kernel.config.new_value", parameter=key))])

    async def on_reset(c: Any, p: Any) -> Any:
        mod_config.reset(key)
        await c.edit(**_parameter_form(ctx, module_id, key))

    async def on_back(c: Any, p: Any) -> Any:
        await c.edit(**_module_form(ctx, module_id))

    buttons.append([
        ctx.ui.button(ctx.t("kernel.config.reset"), on_reset),
        ctx.ui.button(ctx.t("common.back"), on_back),
        ctx.ui.close(ctx.t("common.close")),
    ])

    return {"text": text, "buttons": buttons, "inline": True, "module_id": module_id}


async def command_conf(ctx: Any, invocation: Any) -> Any:
    args = list(invocation.args) if invocation and getattr(invocation, "args", None) else []
    if not args:
        await ctx.respond(**_directory_form(ctx))
        return

    module_id = args[0].casefold()
    candidates = _find_modules(ctx)
    if not any(item[0] == module_id for item in candidates):
        module_key: Callable[[Tuple[str, ConfigSchema]], str] = lambda item: item[0]
        matches = await ctx.tools.search(candidates, module_id, key=module_key, limit=1)
        if not matches:
            await ctx.respond(ctx.t("kernel.config.module_missing", module=_escape(module_id)))
            return
        module_id = matches[0]["value"][0]
    if len(args) == 1:
        await ctx.respond(**_module_form(ctx, module_id))
        return

    arg1 = args[1]
    if arg1.casefold() == "reset":
        runtime = ctx.runtime
        active = runtime.modules.get(module_id) if getattr(runtime, "modules", None) else None
        if not active or not getattr(active, "loaded", None) or not active.loaded.manifest.config_schema:
            await ctx.respond(ctx.t("kernel.config.module_missing", module=_escape(module_id)))
            return
        schema = _localized_schema(ctx, active.loaded.manifest)
        ns = runtime.state.namespace(module_id)
        mod_conf = ModuleConfig(module_id, ns, schema, translate=ctx.t)
        mod_conf.reset()
        await ctx.respond(**_module_form(ctx, module_id))
        return

    key = arg1
    raw = getattr(invocation, "raw_args", None)
    if isinstance(raw, str):
        match = re.match(r"\s*\S+\s+\S+([\s\S]*)", raw)
        suffix = match[1] if match else ""
        new_val = suffix[1:] if suffix else None
    else:
        new_val = " ".join(args[2:]) if len(args) > 2 else None
    runtime = ctx.runtime
    active = runtime.modules.get(module_id) if getattr(runtime, "modules", None) else None
    if not active or not getattr(active, "loaded", None) or not active.loaded.manifest.config_schema:
        await ctx.respond(ctx.t("kernel.config.module_missing", module=_escape(module_id)))
        return
    schema = _localized_schema(ctx, active.loaded.manifest)
    field = schema.get(key)
    if not field:
        field_key: Callable[[Tuple[str, ConfigField]], List[str]] = lambda item: [item[0], item[1].description or ""]
        matches = await ctx.tools.search(list(schema.items()), key, key=field_key, limit=1)
        if not matches:
            await ctx.respond(ctx.t("kernel.config.parameter_missing", parameter=_escape(key)))
            return
        key, field = matches[0]["value"]

    if new_val is not None:
        ns = runtime.state.namespace(module_id)
        mod_conf = ModuleConfig(module_id, ns, schema, translate=ctx.t)
        try:
            coerced = field.parse_input(new_val)
            mod_conf.set(key, coerced)
        except Exception as exc:
            await ctx.respond(ctx.t("kernel.config.error_html", error=_escape(exc)))
            return

    await ctx.respond(**_parameter_form(ctx, module_id, key))
