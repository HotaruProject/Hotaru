HOTARU = {
    "id": "updater",
    "version": "1.5.1",
    "description": "Hotaru self-updater: changelog, update confirmation, git pull, deps, restart",
    "commands": ["upd", "updlog", "updoff", "updon"],
    "capabilities": ["net", "mt"],
    "tasks": {
        "poller": {"interval": 300, "autostart": True},
    },
    "rise": "afterglow",
}

import asyncio
import os
import subprocess
import sys
import time

REPO_URL = "https://github.com/HotaruProject/Hotaru"


def _escape(value):
    import html as _html
    return _html.escape(str(value), quote=False)

def _repo_dir(runtime):
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__))) if runtime is None else str(getattr(runtime, "root", "") or os.getcwd())

def _git(runtime, *args):
    repo = _repo_dir(runtime)
    result = subprocess.run(
        ["git", "-C", repo] + list(args),
        capture_output=True,
        text=True,
        timeout=180,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "git failed")
    return result.stdout

def _fetch_origin(runtime):
    _git(runtime, "fetch", "origin", "main")

def _current_commit(runtime):
    return _git(runtime, "rev-parse", "HEAD").strip()

def _latest_commit(runtime):
    origin_main = _git(runtime, "rev-parse", "origin/main").strip()
    try:
        _git(runtime, "cat-file", "-e", origin_main + "^{commit}")
    except Exception:
        return _current_commit(runtime)
    return origin_main

def _changelog(runtime):
    current = _current_commit(runtime)
    latest = _latest_commit(runtime)
    if current == latest:
        return []
    return _git(runtime, "log", "--pretty=format:%s", f"{current}..{latest}").splitlines()

def _pull(runtime):
    before = _current_commit(runtime)
    _git(runtime, "reset", "--hard", "origin/main")
    _git(runtime, "clean", "-fd")
    after = _latest_commit(runtime)
    deps = False
    try:
        deps_changed = _git(runtime, "diff", "--name-only", before, after, "--", "pyproject.toml", "uv.lock")
        deps = bool(deps_changed.strip())
    except Exception:
        pass
    return before, after, deps

def _sync_deps(runtime):
    root = _repo_dir(runtime)
    try:
        subprocess.run(
            [sys.executable, "-m", "hotaru_deps_sync"],
            cwd=root,
            timeout=600,
            capture_output=True,
        )
    except Exception:
        pass

def _serialize_inline(mid):
    if not isinstance(mid, dict):
        return None
    out = {}
    for key in ("dc_id", "id", "access_hash"):
        if isinstance(mid.get(key), int):
            out[key] = int(mid[key])
    return out if "id" in out else None

def _restore_inline(stored):
    if not isinstance(stored, dict) or not isinstance(stored.get("id"), int):
        return None
    mid = {"_": "inputBotInlineMessageID"}
    for key in ("dc_id", "id", "access_hash"):
        if isinstance(stored.get(key), int):
            mid[key] = int(stored[key])
    return mid if "id" in mid else None

def _pending_from_callback(ctx, callback):
    existing = ctx.state.get("update_pending")
    base = existing if isinstance(existing, dict) else {}
    chat_id = getattr(callback, "chat_id", None)
    msg_id = getattr(callback, "msg_id", None)
    if isinstance(msg_id, dict):
        inline_id = _serialize_inline(msg_id)
        if inline_id is None:
            return
        pending = dict(base)
        pending["inline_id"] = inline_id
        pending["own"] = True
        if isinstance(chat_id, int):
            pending["chat_id"] = chat_id
        ctx.state.set("update_pending", pending)
    elif isinstance(msg_id, int) and isinstance(chat_id, int):
        pending = dict(base)
        pending["chat_id"] = chat_id
        pending["message_id"] = msg_id
        pending["own"] = False
        pending.pop("inline_id", None)
        ctx.state.set("update_pending", pending)

def _t(ctx, key, fallback, **params):
    try:
        value = ctx.t("kernel.updater." + key, fallback, **params)
    except Exception:
        value = None
    if not isinstance(value, str) or not value:
        try:
            value = fallback.format(**params) if params else fallback
        except Exception:
            value = fallback
    return value

def _rich(text):
    return {"_": "inputRichMessageHTML", "html": text}

async def _edit_inline(ctx, text, pending=None):
    pending = pending if isinstance(pending, dict) else ctx.state.get("update_pending")
    if not isinstance(pending, dict):
        return False
    mid = _restore_inline(pending.get("inline_id"))
    if mid is None:
        return False
    try:
        await ctx.bot.call("editMessageText", inline_message_id=mid, rich_message=_rich(text))
        return True
    except Exception:
        pass
    try:
        await ctx.bot.call("editMessageText", inline_message_id=mid, text=text, parse_mode="HTML")
        return True
    except Exception:
        return False

async def _edit_own(ctx, text, pending=None):
    pending = pending if isinstance(pending, dict) else ctx.state.get("update_pending")
    if not isinstance(pending, dict):
        return False
    peer_hex = pending.get("peer") if isinstance(pending.get("peer"), str) else None
    message_id = pending.get("message_id")
    if not peer_hex or not isinstance(message_id, int):
        return False
    try:
        await ctx.tg.call("messages.editMessage", {"id": int(message_id), "rich_message": _rich(text), "peer": bytes.fromhex(peer_hex)})
        return True
    except Exception:
        pass
    try:
        await ctx.tg.edit_rich(message_id, text, peer=pending.get("chat_id"))
        return True
    except Exception:
        return False

async def _bot_edit(ctx, chat_id, message_id, text):
    try:
        await ctx.bot.call("editMessageText", chat_id=int(chat_id), message_id=int(message_id), rich_message=_rich(text))
        return True
    except Exception:
        pass
    try:
        await ctx.bot.call("editMessageText", chat_id=int(chat_id), message_id=int(message_id), text=text, parse_mode="HTML")
        return True
    except Exception:
        pass
    return False

async def _status(ctx, text):
    try:
        pending = ctx.state.get("update_pending")
        if isinstance(pending, dict):
            if bool(pending.get("own")) and await _edit_inline(ctx, text):
                return
            chat_id = pending.get("chat_id")
            message_id = pending.get("message_id")
            if isinstance(chat_id, int) and isinstance(message_id, int):
                if bool(pending.get("own")) and await _edit_own(ctx, text):
                    return
                if await _bot_edit(ctx, chat_id, message_id, text):
                    return
    except Exception:
        pass
    try:
        await ctx.respond(text, parse_mode="HTML")
    except Exception:
        pass

async def afterglow(ctx):
    pending = ctx.state.get("update_pending")
    if not isinstance(pending, dict):
        return
    restarting = pending.get("restarting")
    if not restarting:
        return
    ctx.state.delete("update_pending")
    asyncio.get_event_loop().create_task(_finalize_restart(ctx, pending))

async def _finalize_restart(ctx, pending):
    took_raw = round(time.time() - float(pending["restarting"])) if isinstance(pending.get("restarting"), (int, float)) else None
    took = f"{took_raw}s" if took_raw is not None else "n/a"
    text = _t(ctx, "restarted", "Hotaru updated and successfully restarted in {took}", took=took)
    html = f"<b>{text}</b>"
    for attempt in range(30):
        try:
            if bool(pending.get("own")):
                if await _edit_inline(ctx, html, pending):
                    _emit(ctx, "afterglow_edited", attempt=attempt, mode="inline")
                    return
                if await _edit_own(ctx, html, pending):
                    _emit(ctx, "afterglow_edited", attempt=attempt, mode="own")
                    return
            else:
                chat_id = pending.get("chat_id")
                message_id = pending.get("message_id")
                if isinstance(chat_id, int) and isinstance(message_id, int):
                    if await _bot_edit(ctx, chat_id, message_id, html):
                        _emit(ctx, "afterglow_edited", attempt=attempt, mode="bot")
                        return
        except Exception as exc:
            _emit(ctx, "afterglow_error", attempt=attempt, error=type(exc).__name__)
        await asyncio.sleep(2)
    _emit(ctx, "afterglow_gave_up")

def _emit(ctx, event, **fields):
    observatory = getattr(ctx.runtime, "observatory", None)
    if observatory is not None:
        try:
            observatory.emit("updater", event, **fields)
        except Exception:
            pass

def _notify_text(current, latest, changelog):
    link = f'<a href="{REPO_URL}/compare/{current[:12]}...{latest[:12]}">{latest[:6]}</a>'
    lines = [f"<b>Hotaru update available</b> → <code>{link}</code>"]
    for entry in (changelog or [])[:10]:
        lines.append(f"• {_escape(entry)}")
    return "<br>".join(lines)

async def command_updlog(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(f"<b>{_t(ctx, 'unavailable', 'Runtime unavailable')}</b>", parse_mode="HTML")
        return
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception as exc:
        await ctx.respond(f"<b>Update check failed:</b> <i>{_escape(exc)}</i>", parse_mode="HTML")
        return
    if current == latest:
        await ctx.respond(f"<b>{_t(ctx, 'up_to_date', 'Hotaru is up to date')}</b>", parse_mode="HTML")
        return
    await ctx.respond(_notify_text(current, latest, changelog), parse_mode="HTML")

async def command_updoff(ctx, invocation):
    ctx.state.set("notify", False)
    await ctx.respond(f"<b>{_t(ctx, 'notify_off', 'Update notifications disabled')}</b>", parse_mode="HTML")

async def command_updon(ctx, invocation):
    ctx.state.set("notify", True)
    await ctx.respond(f"<b>{_t(ctx, 'notify_on', 'Update notifications enabled')}</b>", parse_mode="HTML")

async def _run_update(ctx):
    async def say(text):
        await _status(ctx, text)
    await say(f"<b>{_t(ctx, 'downloading', 'Downloading update…')}</b>")
    try:
        before, after, deps_changed = _pull(ctx.runtime)
    except Exception as exc:
        await say(f"<b>Update failed:</b> <i>{_escape(exc)}</i>")
        return
    if before == after:
        await say(f"<b>{_t(ctx, 'up_to_date', 'Hotaru is up to date')}</b>")
        return
    if deps_changed:
        await say(f"<b>{_t(ctx, 'syncing', 'Syncing dependencies…')}</b>")
        _sync_deps(ctx.runtime)
    await say(f"<b>{_t(ctx, 'restarting', 'Updated to {commit}. Restarting…', commit=_escape(after[:7]))}</b>")
    pending = ctx.state.get("update_pending")
    if isinstance(pending, dict):
        pending = dict(pending)
        pending["restarting"] = time.time()
        ctx.state.set("update_pending", pending)
    await asyncio.sleep(1)
    await _restart_service(ctx)

async def _restart_service(ctx):
    runtime = ctx.runtime
    try:
        if runtime.app:
            await asyncio.wait_for(runtime.app.close(), timeout=1.0)
    except Exception:
        pass
    if "INVOCATION_ID" in os.environ:
        service_name = None
        is_user_service = False
        try:
            with open("/proc/self/cgroup", "r") as f:
                for line in f:
                    if ".service" in line:
                        service_name = line.strip().split("/")[-1]
                        if "user.slice" in line or "user@".lower() in line.lower():
                            is_user_service = True
                        break
        except Exception:
            pass
        if service_name:
            cmd = ["systemctl", "--user" if is_user_service else "", "restart", service_name]
            cmd = [c for c in cmd if c]
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
    os.execv(sys.executable, [sys.executable, "-m", "hotaru"])

async def command_upd(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(f"<b>{_t(ctx, 'unavailable', 'Runtime unavailable')}</b>", parse_mode="HTML")
        return
    force = "force" in invocation.args or "-f" in invocation.args
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception as exc:
        if force:
            raise
        await ctx.respond(f"<b>Update check failed:</b> <i>{_escape(exc)}</i>", parse_mode="HTML")
        return

    if current == latest:
        await ctx.respond(f"<b>{_t(ctx, 'up_to_date', 'Hotaru is up to date')}</b>", parse_mode="HTML")
        return

    if force:
        await _run_update(ctx)
        return

    async def update_handler(callback, payload):
        await callback.answer(_t(ctx, "updating", "Updating…"))
        _pending_from_callback(ctx, callback)
        await _run_update(ctx)

    async def ignore_handler(callback, payload):
        ctx.state.set("notified_commit", latest)
        await callback.answer(_t(ctx, "ignored_toast", "Ignored"))
        try:
            await callback.edit(f"<b>{_t(ctx, 'ignored', 'Update ignored.')}</b>")
        except Exception:
            pass

    buttons = [
        [
            ctx.ui.button("Update", update_handler, style="primary"),
            ctx.ui.button("Ignore", ignore_handler, style="danger"),
        ]
    ]
    message = await ctx.respond(
        _notify_text(current, latest, changelog) + "<br><br>Update now?",
        buttons=buttons,
        inline=True,
        parse_mode="HTML",
    )
    pending = None
    sent = getattr(message, "value", None) if message is not None and not isinstance(message, dict) else message
    if isinstance(sent, dict):
        body = sent.get("result", sent)
        if isinstance(body, dict):
            message_id = body.get("id") if isinstance(body.get("id"), int) else body.get("message_id")
            chat_id = getattr(ctx.message, "chat_id", None)
            if isinstance(chat_id, int) and isinstance(message_id, int):
                pending = {"chat_id": chat_id, "message_id": message_id, "own": True}
    if pending is None:
        chat_id = getattr(ctx.message, "chat_id", None)
        message_id = getattr(ctx.message, "id", None)
        if isinstance(chat_id, int) and isinstance(message_id, int):
            pending = {"chat_id": chat_id, "message_id": message_id, "own": True}
    if pending is not None:
        peer_hex = None
        try:
            app = getattr(ctx.runtime, "app", None)
            mt = getattr(app, "mt", None) if app is not None else None
            if mt is not None and hasattr(mt, "resolve_peer"):
                peer_hex = (await mt.resolve_peer(pending["chat_id"])).hex()
        except Exception:
            peer_hex = None
        pending["peer"] = peer_hex
        ctx.state.set("update_pending", pending)

async def task_poller(ctx):
    runtime = ctx.runtime
    if runtime is None:
        return
    if ctx.state.get("notify", True) is False:
        return
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception:
        return
    if not changelog or current == latest:
        return
    notified = ctx.state.get("notified_commit")
    if notified == latest:
        return
    owner = None
    kernel = getattr(runtime, "kernel", None)
    if kernel is not None:
        owner = getattr(kernel, "owner_id", None)
    if owner is None:
        return

    async def update_handler(callback, payload):
        await callback.answer(_t(ctx, "updating", "Updating…"))
        _pending_from_callback(ctx, callback)
        await _run_update(ctx)

    async def ignore_handler(callback, payload):
        ctx.state.set("notified_commit", latest)
        await callback.answer(_t(ctx, "ignored_toast", "Ignored"))
        try:
            await callback.edit(f"<b>{_t(ctx, 'ignored', 'Update ignored.')}</b>")
        except Exception:
            pass

    buttons = [
        [
            ctx.ui.button("Update", update_handler, style="primary"),
            ctx.ui.button("Ignore", ignore_handler, style="danger"),
        ]
    ]
    text = _notify_text(current, latest, changelog)
    try:
        message = await ctx.bot.send_message(owner, text, buttons=buttons)
    except Exception:
        return
    sent = None
    if isinstance(message, dict):
        body = message.get("result", message)
        if isinstance(body, dict):
            for upd in body.get("updates") or []:
                msg = upd.get("message") if isinstance(upd, dict) else None
                if isinstance(msg, dict) and isinstance(msg.get("id"), int):
                    sent = msg
                    break
    if sent is not None:
        ctx.state.set("update_pending", {"chat_id": int(owner), "message_id": int(sent["id"]), "own": False})
    ctx.state.set("notified_commit", latest)
