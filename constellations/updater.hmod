HOTARU = {
    "id": "updater",
    "version": "1.5.4",
    "commands": ["upd", "updlog", "updoff", "updon"],
    "capabilities": ["net", "mt"],
    "tasks": {
        "poller": {"interval": 300, "autostart": True},
    },
    "rise": "afterglow",
}

from typing import Any, cast


import asyncio
import os
import subprocess
import time

REPO_URL = "https://github.com/HotaruProject/Hotaru"


def _escape(value: Any) -> Any:
    import html as _html
    return _html.escape(str(value), quote=False)

def _repo_dir(runtime: Any) -> Any:
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

def _git(runtime: Any, *args: Any) -> Any:
    repo = _repo_dir(runtime)
    result = subprocess.run(
        ["git", "-C", repo] + list(args),
        capture_output=True,
        text=True,
        timeout=180,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "git failed")
    return result.stdout

def _branch(runtime: Any) -> Any:
    name = _git(runtime, "rev-parse", "--abbrev-ref", "HEAD").strip()
    return name if name and name != "HEAD" else "main"

def _fetch_origin(runtime: Any) -> Any:
    _git(runtime, "fetch", "origin", _branch(runtime))

def _current_commit(runtime: Any) -> Any:
    return _git(runtime, "rev-parse", "HEAD").strip()

def _latest_commit(runtime: Any) -> Any:
    latest = _git(runtime, "rev-parse", "origin/" + _branch(runtime)).strip()
    _git(runtime, "cat-file", "-e", latest + "^{commit}")
    return latest

def _changelog(runtime: Any) -> Any:
    current = _current_commit(runtime)
    latest = _latest_commit(runtime)
    if current == latest:
        return []
    return _git(runtime, "log", "--pretty=format:%s", f"{current}..{latest}").splitlines()

def _pull(runtime: Any) -> Any:
    return runtime.update_checkout()

def _serialize_inline(mid: object) -> dict[str, Any] | None:
    if not isinstance(mid, dict):
        return None
    mid = cast('dict[str, Any]', mid)
    name = mid.get("_")
    if not isinstance(name, str) or "InlineMessageID" not in name:
        name = "inputBotInlineMessageID"
    out: dict[str, Any] = {"_": name}
    for key in ("dc_id", "id", "access_hash", "owner_id"):
        if isinstance(mid.get(key), int):
            out[key] = int(mid[key])
    return out if isinstance(out.get("id"), int) else None

def _restore_inline(stored: object) -> dict[str, Any] | None:
    if not isinstance(stored, dict):
        return None
    stored = cast('dict[str, Any]', stored)
    if not isinstance(stored.get("id"), int):
        return None
    name = stored.get("_") if isinstance(stored.get("_"), str) else None
    mid = {"_": name or "inputBotInlineMessageID"}
    for key in ("dc_id", "id", "access_hash", "owner_id"):
        if isinstance(stored.get(key), int):
            mid[key] = int(stored[key])
    return mid

def _remember_surface(ctx: Any, surface: dict[str, Any]) -> None:
    pending = ctx.state.get("update_pending")
    if not isinstance(pending, dict):
        pending = {}
    pending = cast('dict[str, Any]', pending)
    pending["surfaces"] = [dict(surface)]
    for key in ("chat_id", "message_id", "inline_id", "own", "peer"):
        pending.pop(key, None)
    ctx.state.set("update_pending", pending)

def _pending_from_callback(ctx: Any, callback: Any) -> None:
    chat_id = getattr(callback, "chat_id", None)
    msg_id = getattr(callback, "msg_id", None)
    if isinstance(msg_id, dict):
        inline_id = _serialize_inline(cast('dict[str, Any]', msg_id))
        if inline_id is None:
            return
        surface: dict[str, Any] = {"own": False, "inline_id": inline_id}
        if isinstance(chat_id, int):
            surface["chat_id"] = chat_id
        _remember_surface(ctx, surface)
    elif isinstance(msg_id, int) and isinstance(chat_id, int):
        _remember_surface(ctx, {"chat_id": chat_id, "message_id": msg_id, "own": False})


def _rich(text: Any) -> Any:
    return {"_": "inputRichMessageHTML", "html": text}

async def _edit_inline(ctx: Any, text: Any, surface: dict[str, Any]) -> bool:
    mid = _restore_inline(surface.get("inline_id"))
    if mid is None:
        return False
    try:
        await ctx.bot.call("editMessageText", inline_message_id=mid, rich_message=_rich(text))
        return True
    except Exception as exc:
        _emit(ctx, "edit_inline_error", error=type(exc).__name__, detail=str(exc)[:120])
    try:
        await ctx.bot.call("editMessageText", inline_message_id=mid, text=text, parse_mode="HTML")
        return True
    except Exception as exc:
        _emit(ctx, "edit_inline_error", error=type(exc).__name__, detail=str(exc)[:120])
    return False

async def _edit_own(ctx: Any, text: Any, surface: dict[str, Any]) -> bool:
    peer_hex = surface.get("peer") if isinstance(surface.get("peer"), str) else None
    message_id = surface.get("message_id")
    if not peer_hex or not isinstance(message_id, int):
        return False
    try:
        await ctx.tg.call("messages.editMessage", {"id": int(message_id), "rich_message": _rich(text), "peer": bytes.fromhex(peer_hex)})
        return True
    except Exception as exc:
        _emit(ctx, "edit_own_error", error=type(exc).__name__, detail=str(exc)[:120])
        err = str(exc)
        if "INLINE_BOT_REQUIRED" in err or "MESSAGE_AUTHOR_REQUIRED" in err:
            return False
    try:
        await ctx.tg.edit_rich(message_id, text, peer=surface.get("chat_id"))
        return True
    except Exception as exc:
        _emit(ctx, "edit_own_error", error=type(exc).__name__, detail=str(exc)[:120])
    return False

def _surfaces(pending: object) -> list[dict[str, Any]]:
    if not isinstance(pending, dict):
        return []
    pending = cast('dict[str, Any]', pending)
    out: list[dict[str, Any]] = []
    raw = pending.get("surfaces")
    for surface in cast('list[Any]', raw) if isinstance(raw, list) else []:
        if isinstance(surface, dict):
            out.append(cast('dict[str, Any]', surface))
    if not out:
        legacy = {key: pending[key] for key in ("chat_id", "message_id", "inline_id", "own", "peer") if key in pending}
        if legacy:
            out = [legacy]
    return out

async def _edit_surface(ctx: Any, text: Any, surface: dict[str, Any]) -> str | None:
    if isinstance(surface.get("inline_id"), dict):
        if await _edit_inline(ctx, text, surface):
            return "inline"
        return None
    chat_id = surface.get("chat_id")
    message_id = surface.get("message_id")
    if bool(surface.get("own")):
        if await _edit_own(ctx, text, surface):
            return "own"
        return None
    if isinstance(chat_id, int) and isinstance(message_id, int) and await _bot_edit(ctx, chat_id, message_id, text):
        return "bot"
    return None

def _drop_surface(ctx: Any, callback: Any) -> None:
    pending = ctx.state.get("update_pending")
    if not isinstance(pending, dict):
        return
    pending = cast('dict[str, Any]', pending)
    surfaces = pending.get("surfaces")
    if not isinstance(surfaces, list):
        return
    surfaces = cast('list[Any]', surfaces)
    chat_id = getattr(callback, "chat_id", None)
    msg_id = getattr(callback, "msg_id", None)
    keep: list[dict[str, Any]] = []
    for surface in surfaces:
        if not isinstance(surface, dict):
            continue
        surface = cast('dict[str, Any]', surface)
        if isinstance(msg_id, dict):
            same = surface.get("chat_id") == chat_id and isinstance(surface.get("inline_id"), dict)
        else:
            same = surface.get("chat_id") == chat_id and surface.get("message_id") == msg_id
        if not same:
            keep.append(surface)
    pending["surfaces"] = keep
    ctx.state.set("update_pending", pending)

async def _bot_edit(ctx: Any, chat_id: Any, message_id: Any, text: Any) -> Any:
    try:
        await ctx.bot.call("editMessageText", chat_id=int(chat_id), message_id=int(message_id), rich_message=_rich(text))
        return True
    except Exception as exc:
        _emit(ctx, "bot_edit_error", variant="rich", error=type(exc).__name__, detail=str(exc)[:140])
        if "access_hash" in str(exc) or "INLINE_BOT_REQUIRED" in str(exc):
            return False
    try:
        await ctx.bot.call("editMessageText", chat_id=int(chat_id), message_id=int(message_id), text=text, parse_mode="HTML")
        return True
    except Exception as exc:
        _emit(ctx, "bot_edit_error", variant="plain", error=type(exc).__name__, detail=str(exc)[:140])
    return False

async def _status(ctx: Any, text: Any) -> Any:
    try:
        pending = ctx.state.get("update_pending")
        for surface in _surfaces(pending):
            await _edit_surface(ctx, text, surface)
        return
    except Exception as exc:
        _emit(ctx, "status_error", error=type(exc).__name__, detail=str(exc)[:120])
    try:
        await ctx.respond(text, parse_mode="HTML")
    except Exception:
        pass

async def afterglow(ctx: Any) -> Any:
    pending = ctx.state.get("update_pending")
    if not isinstance(pending, dict):
        return
    pending = cast('dict[str, Any]', pending)
    restarting = pending.get("restarting")
    if not restarting:
        return
    ctx.state.delete("update_pending")
    asyncio.get_event_loop().create_task(_finalize_restart(ctx, pending))

async def _finalize_restart(ctx: Any, pending: dict[str, Any]) -> None:
    try:
        runtime = ctx.runtime
        inline = getattr(runtime, "inline", None)
        if inline is not None:
            await asyncio.wait_for(inline.ready.wait(), timeout=10.0)
    except Exception:
        pass
    took_raw = round(time.time() - float(pending["restarting"])) if isinstance(pending.get("restarting"), (int, float)) else None
    took = ctx.t("common.seconds", n=took_raw) if took_raw is not None else ctx.t("common.unknown")
    text = ctx.t('kernel.updater.restarted', took=took)
    html = f"<b>{text}</b>"
    surfaces = _surfaces(pending)
    done: dict[int, str] = {}
    for attempt in range(5):
        try:
            for index, surface in enumerate(surfaces):
                if index in done:
                    continue
                mode = await _edit_surface(ctx, html, surface)
                if mode is not None:
                    done[index] = mode
                    _emit(ctx, "afterglow_edited", attempt=attempt, mode=mode, surface=index)
            if len(done) >= len(surfaces):
                return
        except Exception as exc:
            _emit(ctx, "afterglow_error", attempt=attempt, error=type(exc).__name__)
        await asyncio.sleep(1)
    _emit(ctx, "afterglow_gave_up", done=len(done), total=len(surfaces))

def _emit(ctx: Any, event: Any, **fields: Any) -> Any:
    observatory = getattr(ctx.runtime, "observatory", None)
    if observatory is not None:
        try:
            observatory.emit("updater", event, **fields)
        except Exception:
            pass

def _notify_text(ctx: Any, current: str, latest: str, changelog: list[str]) -> str:
    link = f'<a href="{REPO_URL}/compare/{current[:12]}...{latest[:12]}">{latest[:6]}</a>'
    lines = [f"<b>{ctx.t('kernel.updater.update_available')}</b> → <code>{link}</code>"]
    for entry in (changelog or [])[:10]:
        lines.append(f"• {_escape(entry)}")
    return "<br>".join(lines)

async def command_updlog(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(f"<b>{ctx.t('kernel.updater.unavailable')}</b>", parse_mode="HTML")
        return
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception as exc:
        await ctx.respond(ctx.t('kernel.updater.check_failed', error=_escape(exc)), parse_mode="HTML")
        return
    if current == latest:
        await ctx.respond(f"<b>{ctx.t('kernel.updater.up_to_date')}</b>", parse_mode="HTML")
        return
    await ctx.respond(_notify_text(ctx, current, latest, changelog), parse_mode="HTML")

async def command_updoff(ctx: Any, invocation: Any) -> Any:
    ctx.state.set("notify", False)
    await ctx.respond(f"<b>{ctx.t('kernel.updater.notify_off')}</b>", parse_mode="HTML")

async def command_updon(ctx: Any, invocation: Any) -> Any:
    ctx.state.set("notify", True)
    await ctx.respond(f"<b>{ctx.t('kernel.updater.notify_on')}</b>", parse_mode="HTML")

async def _run_update(ctx: Any) -> Any:
    async def say(text: Any) -> Any:
        await _status(ctx, text)
    await say(f"<b>{ctx.t('kernel.updater.downloading')}</b>")
    try:
        update = _pull(ctx.runtime)
    except Exception as exc:
        await say(ctx.t('kernel.updater.failed', error=_escape(exc)))
        return
    if update.before == update.after:
        await say(f"<b>{ctx.t('kernel.updater.up_to_date')}</b>")
        return
    if update.conflicts:
        await say(ctx.t('kernel.updater.conflicts', path=_escape(str(update.recovery))))
    ctx.state.set("notified_commit", update.after)
    await say(f"<b>{ctx.t('kernel.updater.restarting', commit=_escape(update.after[:7]))}</b>")
    pending = ctx.state.get("update_pending")
    if isinstance(pending, dict):
        pending = dict(cast('dict[str, Any]', pending))
        pending["restarting"] = time.time()
        ctx.state.set("update_pending", pending)
    await asyncio.sleep(1)
    await _restart_service(ctx)

async def _restart_service(ctx: Any) -> Any:
    runtime = ctx.runtime
    runtime.request_restart()
    try:
        if runtime.app:
            await asyncio.wait_for(runtime.app.close(), timeout=1.0)
    except Exception:
        pass

async def command_upd(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(f"<b>{ctx.t('kernel.updater.unavailable')}</b>", parse_mode="HTML")
        return
    force = "force" in invocation.args or "-f" in invocation.args
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception as exc:
        if force:
            raise
        await ctx.respond(ctx.t('kernel.updater.check_failed', error=_escape(exc)), parse_mode="HTML")
        return

    if current == latest:
        await ctx.respond(f"<b>{ctx.t('kernel.updater.up_to_date')}</b>", parse_mode="HTML")
        return

    if force:
        await _run_update(ctx)
        return

    async def update_handler(callback: Any, payload: Any) -> Any:
        await callback.respond(ctx.t('kernel.updater.updating'))
        _pending_from_callback(ctx, callback)
        await _run_update(ctx)

    async def ignore_handler(callback: Any, payload: Any) -> Any:
        ctx.state.set("notified_commit", latest)
        await callback.respond(ctx.t('kernel.updater.ignored_toast'))
        try:
            await callback.edit(f"<b>{ctx.t('kernel.updater.ignored')}</b>")
        except Exception:
            pass
        _drop_surface(ctx, callback)

    buttons = [
        [
            ctx.ui.button(ctx.t('kernel.updater.button_update'), update_handler, style="primary"),
            ctx.ui.button(ctx.t('kernel.updater.button_ignore'), ignore_handler, style="danger"),
        ]
    ]
    message = await ctx.respond(
        _notify_text(ctx, current, latest, changelog) + ctx.t('kernel.updater.confirm'),
        buttons=buttons,
        inline=True,
        parse_mode="HTML",
    )
    surface: dict[str, Any] | None = None
    sent = cast(Any, getattr(message, "value", None) if message is not None and not isinstance(message, dict) else message)
    if isinstance(sent, dict):
        sent = cast('dict[str, Any]', sent)
        body = sent.get("result", sent)
        if isinstance(body, dict):
            body = cast('dict[str, Any]', body)
            message_id = body.get("id") if isinstance(body.get("id"), int) else body.get("message_id")
            chat_id = getattr(ctx.message, "chat_id", None)
            if isinstance(chat_id, int) and isinstance(message_id, int):
                surface = {"chat_id": chat_id, "message_id": message_id, "own": False}
    if surface is not None:
        peer_hex = None
        try:
            app = getattr(ctx.runtime, "app", None)
            mt = getattr(app, "mt", None) if app is not None else None
            if mt is not None and hasattr(mt, "resolve_peer"):
                peer_hex = (await mt.resolve_peer(surface["chat_id"])).hex()
        except Exception:
            peer_hex = None
        surface["peer"] = peer_hex
        _remember_surface(ctx, surface)

async def task_poller(ctx: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        return
    if ctx.state.get("notify", True) is False:
        return
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception as exc:
        _emit(ctx, "poller_git_error", error=type(exc).__name__)
        return
    if not changelog or current == latest:
        _emit(ctx, "poller_uptodate")
        return
    notified = ctx.state.get("notified_commit")
    if notified == latest:
        return
    owner = None
    kernel = getattr(runtime, "kernel", None)
    if kernel is not None:
        owner = getattr(kernel, "owner_id", None)
    if owner is None:
        _emit(ctx, "poller_no_owner")
        return

    async def update_handler(callback: Any, payload: Any) -> Any:
        await callback.respond(ctx.t('kernel.updater.updating'))
        _pending_from_callback(ctx, callback)
        await _run_update(ctx)

    async def ignore_handler(callback: Any, payload: Any) -> Any:
        ctx.state.set("notified_commit", latest)
        await callback.respond(ctx.t('kernel.updater.ignored_toast'))
        try:
            await callback.edit(f"<b>{ctx.t('kernel.updater.ignored')}</b>")
        except Exception:
            pass
        _drop_surface(ctx, callback)

    buttons = [
        [
            ctx.ui.button(ctx.t('kernel.updater.button_update'), update_handler, style="primary"),
            ctx.ui.button(ctx.t('kernel.updater.button_ignore'), ignore_handler, style="danger"),
        ]
    ]
    text = _notify_text(ctx, current, latest, changelog)
    try:
        message = await ctx.bot.send_message(owner, text, buttons=buttons)
    except Exception as exc:
        _emit(ctx, "poller_send_error", error=type(exc).__name__, detail=str(exc)[:200])
        return
    sent: dict[str, Any] | None = None
    message_body: Any
    if isinstance(message, dict):
        message_dict = cast('dict[str, Any]', message)
        message_body = message_dict.get("result", message_dict)
    else:
        message_body = message
    if isinstance(message_body, dict):
        message_body = cast('dict[str, Any]', message_body)
        updates = message_body.get("updates")
        for upd in cast('list[Any]', updates) if isinstance(updates, list) else []:
            msg = cast('dict[str, Any]', upd).get("message") if isinstance(upd, dict) else None
            if isinstance(msg, dict) and isinstance(cast('dict[str, Any]', msg).get("id"), int):
                sent = cast('dict[str, Any]', msg)
                break
        if sent is None and message_body.get("_") == "updateShortSentMessage" and isinstance(message_body.get("id"), int):
            sent = message_body
    if sent is not None:
        _remember_surface(ctx, {"chat_id": int(owner), "message_id": int(sent["id"]), "own": False})
    ctx.state.set("notified_commit", latest)
    _emit(ctx, "poller_notified", latest=latest[:12], sent=bool(sent))
