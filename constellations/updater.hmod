HOTARU = {
    "id": "updater",
    "version": "1.0.0",
    "description": "Hotaru self-updater: changelog, update confirmation, git pull, deps, restart",
    "commands": ["upd", "updlog", "updoff", "updon"],
    "capabilities": ["net"],
    "tasks": {
        "poller": {"interval": 300, "autostart": True},
    },
}


import asyncio
import html as _html
import json
import os
import subprocess
import time


FETCH_INTERVAL = 300
REPO_URL = "https://github.com/HotaruProject/Hotaru"
BRANCH = "main"


def _escape(value):
    return _html.escape(str(value), quote=False)


def _repo_dir(runtime):
    root = getattr(runtime, "constellations_dir", None)
    if root is None:
        return None
    return str(root.parent)


def _git(runtime, *args, timeout=60):
    repo = _repo_dir(runtime)
    if repo is None:
        raise RuntimeError("repo directory is unavailable")
    return subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def _fetch_origin(runtime):
    result = _git(runtime, "fetch", "--quiet", "origin", timeout=120)
    if result.returncode != 0:
        raise RuntimeError(f"git fetch failed: {result.stderr.strip()[:200]}")


def _current_commit(runtime):
    result = _git(runtime, "rev-parse", "HEAD")
    if result.returncode != 0:
        raise RuntimeError("git rev-parse failed")
    return result.stdout.strip()


def _latest_commit(runtime):
    result = _git(runtime, "rev-parse", f"origin/{BRANCH}")
    if result.returncode != 0:
        raise RuntimeError("git rev-parse origin failed")
    return result.stdout.strip()


def _changelog(runtime):
    result = _git(runtime, "log", "--pretty=format:%h %s", f"HEAD..origin/{BRANCH}", "--max-count=10")
    if result.returncode != 0:
        raise RuntimeError("git log failed")
    lines = [line for line in result.stdout.splitlines() if line.strip()]
    if not lines:
        return ""
    entries = []
    for line in lines:
        sha, _, title = line.partition(" ")
        entries.append(f"<b>{_escape(sha)}</b> <i>{_escape(title)}</i>")
    return "<br>".join(entries)


def _requirements_changed(runtime, before, after):
    result = _git(runtime, "diff", "--name-only", before, after, "--", "pyproject.toml", "uv.lock")
    if result.returncode != 0:
        return False
    return bool(result.stdout.strip())


def _pull(runtime):
    _fetch_origin(runtime)
    before = _current_commit(runtime)
    result = _git(runtime, "reset", "--hard", f"origin/{BRANCH}")
    if result.returncode != 0:
        raise RuntimeError(f"git reset failed: {result.stderr.strip()[:200]}")
    after = _current_commit(runtime)
    return before, after, _requirements_changed(runtime, before, after)


def _sync_deps(runtime):
    repo = _repo_dir(runtime)
    venv = os.path.join(repo, ".venv")
    if not os.path.isdir(venv):
        return
    candidates = [
        os.path.join(venv, "bin", "uv"),
        os.path.expanduser("~/.local/bin/uv"),
        "/usr/local/bin/uv",
    ]
    uv = next((path for path in candidates if os.path.isfile(path)), None)
    if uv is None:
        return
    subprocess.run(
        [uv, "pip", "install", "-e", ".", "--quiet"],
        cwd=repo,
        capture_output=True,
        text=True,
        timeout=600,
        check=False,
    )


async def _restart_service():
    subprocess.Popen(
        ["systemctl", "restart", "hotaru.service"],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


async def _bot_edit(ctx, chat_id, message_id, text):
    await ctx.bot.call(
        "editMessageText",
        chat_id=chat_id,
        message_id=message_id,
        text=text,
        parse_mode="HTML",
    )


def _save_update_msg(ctx, chat_id, message_id):
    ctx.state.set("update_msg", {"chat_id": chat_id, "message_id": message_id, "restart_ts": time.time()})


async def _update_complete(ctx):
    record = ctx.state.get("update_msg")
    if not isinstance(record, dict):
        return
    chat_id = record.get("chat_id")
    message_id = record.get("message_id")
    started = record.get("restart_ts")
    if not isinstance(chat_id, int) or not isinstance(message_id, int):
        return
    took = round(time.time() - started) if isinstance(started, (int, float)) else "n/a"
    ctx.state.delete("update_msg")
    try:
        await _bot_edit(ctx, chat_id, message_id, f"<b>Hotaru updated</b> in {took}s ✓")
    except Exception:
        pass


def _notify_text(current, latest, changelog):
    link = f'<a href="{REPO_URL}/compare/{current[:12]}...{latest[:12]}">{latest[:6]}</a>'
    return (
        f"<b>Hotaru update available</b><br>"
        f"current: <code>{_escape(current[:7])}</code> → {link}<br><br>"
        f"{changelog}"
    )


async def command_updlog(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("<b>Runtime unavailable</b>", parse_mode="HTML")
        return
    try:
        _fetch_origin(runtime)
        changelog = _changelog(runtime)
    except Exception as exc:
        await ctx.respond(f"<b>Changelog failed:</b> <i>{_escape(exc)}</i>", parse_mode="HTML")
        return
    if not changelog:
        await ctx.respond("<b>Hotaru is up to date</b>", parse_mode="HTML")
        return
    current = _current_commit(runtime)
    latest = _latest_commit(runtime)
    await ctx.respond(_notify_text(current, latest, changelog), parse_mode="HTML")


async def command_updoff(ctx, invocation):
    ctx.state.set("notify", False)
    await ctx.respond("Update notifications disabled. Use .updon to re-enable.", parse_mode="HTML")


async def command_updon(ctx, invocation):
    ctx.state.set("notify", True)
    await ctx.respond("Update notifications enabled.", parse_mode="HTML")
    await _update_complete(ctx)


async def _run_update(ctx, notify=None):
    runtime = ctx.runtime
    async def say(text):
        if notify is not None:
            await notify(text)
        else:
            await ctx.respond(text, parse_mode="HTML")
    await say("<b>Downloading update…</b>")
    try:
        before, after, deps_changed = _pull(runtime)
    except Exception as exc:
        await say(f"<b>Update failed:</b> <i>{_escape(exc)}</i>")
        return
    if before == after:
        await say("<b>Already up to date</b>")
        return
    if deps_changed:
        await say("<b>Syncing dependencies…</b>")
        _sync_deps(runtime)
    await say(f"<b>Updated to</b> <code>{_escape(after[:7])}</code>. Restarting…")
    ctx.state.set("restart_ts", time.time())
    if notify is not None and isinstance(notify, _NotifyEditor):
        notify.mark_restart()
    await asyncio.sleep(1)
    await _restart_service()


async def command_upd(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("<b>Runtime unavailable</b>", parse_mode="HTML")
        return
    force = "force" in invocation.args or "-f" in invocation.args
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception as exc:
        if force:
            raise
        await ctx.respond(f"<b>Update check failed:</b> <i>{_escape(exc)}</i>", parse_mode="HTML")
        return

    if current == latest:
        await ctx.respond(f"<b>Already up to date</b> <code>{_escape(current[:7])}</code>", parse_mode="HTML")
        return

    if force:
        await _run_update(ctx)
        return

    editor = _NotifyEditor(ctx)

    async def update_handler(callback, payload):
        await callback.answer("Updating…")
        await editor.attach(callback)
        await _run_update(ctx, notify=editor)

    async def cancel_handler(callback, payload):
        await callback.answer()
        await callback.delete()

    buttons = [
        [
            ctx.ui.button("Update", update_handler, style="primary"),
            ctx.ui.button("Cancel", cancel_handler, style="danger"),
        ]
    ]
    message = await ctx.bot.rich_send(
        invocation.chat_id,
        _notify_text(current, latest, changelog) + "<br><br>Update now?",
        buttons=buttons,
    )
    editor.adopt(message)


class _NotifyEditor:
    def __init__(self, ctx):
        self.ctx = ctx
        self.chat_id = None
        self.message_id = None

    def adopt(self, message):
        body = message.get("result", message) if isinstance(message, dict) else message
        if isinstance(body, dict):
            self.chat_id = body.get("chat", {}).get("id") or body.get("chat_id")
            self.message_id = body.get("message_id")

    async def attach(self, callback):
        self.chat_id = getattr(callback, "chat_id", None) or self.chat_id
        self.message_id = getattr(callback, "msg_id", None) or getattr(callback, "message_id", None) or self.message_id

    def mark_restart(self):
        if isinstance(self.chat_id, int) and isinstance(self.message_id, int):
            _save_update_msg(self.ctx, self.chat_id, self.message_id)

    async def __call__(self, text):
        if isinstance(self.chat_id, int) and isinstance(self.message_id, int):
            try:
                await _bot_edit(self.ctx, self.chat_id, self.message_id, text)
                return
            except Exception:
                pass
        await self.ctx.respond(text, parse_mode="HTML")


async def task_poller(ctx):
    runtime = ctx.runtime
    if runtime is None:
        return
    if ctx.state.get("notify", True) is False:
        return
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception:
        return
    if not changelog or current == latest:
        return
    notified = ctx.state.get("notified_commit")
    if notified == latest:
        return
    owner = None
    kernel = getattr(runtime, "kernel", None)
    if kernel is not None:
        owner = getattr(kernel, "owner_id", None)
    if owner is None:
        return

    async def update_handler(callback, payload):
        await callback.answer("Updating…")
        await editor.attach(callback)
        await _run_update(ctx, notify=editor)

    async def ignore_handler(callback, payload):
        await callback.answer("Updates ignored until next commit")
        await callback.delete()
        ctx.state.set("notified_commit", latest)

    async def cancel_handler(callback, payload):
        await callback.answer()
        await callback.delete()

    buttons = [
        [
            ctx.ui.button("Update", update_handler, style="primary"),
            ctx.ui.button("Ignore", ignore_handler, style="danger"),
            ctx.ui.button("×", cancel_handler, style="danger"),
        ]
    ]
    text = _notify_text(current, latest, changelog)
    editor = _NotifyEditor(ctx)
    try:
        message = await ctx.bot.rich_send(owner, text, buttons=buttons)
    except Exception:
        return
    editor.adopt(message)
    ctx.state.set("notified_commit", latest)
