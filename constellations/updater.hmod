    "version": "1.2.0",
    "description": "Hotaru self-updater: changelog, update confirmation, git pull, deps, restart",
    "commands": ["upd", "updlog", "updoff", "updon"],
    "capabilities": ["net"],
    "tasks": {
        "poller": {"interval": 300, "autostart": True},
    },
    "translations": {
        "ru": {
            "description": "Самообновление Hotaru: ченджлог, подтверждение, git pull, зависимости, рестарт",
            "commands": {
                "upd": {"description": "Проверить обновление и обновиться"},
                "updlog": {"description": "Показать changelog"},
                "updoff": {"description": "Выключить уведомления об обновлениях"},
                "updon": {"description": "Включить уведомления об обновлениях"},
            },
        },
        "en": {
            "description": "Hotaru self-updater: changelog, confirmation, git pull, deps, restart",
            "commands": {
                "upd": {"description": "Check for update and apply"},
                "updlog": {"description": "Show changelog"},
                "updoff": {"description": "Disable update notifications"},
                "updon": {"description": "Enable update notifications"},
            },
        },
    },
}


import asyncio
import html as _html
import json
import os
import subprocess
import time


FETCH_INTERVAL = 300
REPO_URL = "https://github.com/HotaruProject/Hotaru"
BRANCH = "main"
SLOT = "updater:status"


def _escape(value):
    return _html.escape(str(value), quote=False)


def _repo_dir(runtime):
    root = getattr(runtime, "constellations_dir", None)
    if root is None:
        return None
    return str(root.parent)


def _git(runtime, *args, timeout=60):
    repo = _repo_dir(runtime)
    if repo is None:
        raise RuntimeError("repo directory is unavailable")
    return subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def _fetch_origin(runtime):
    result = _git(runtime, "fetch", "--quiet", "origin", timeout=120)
    if result.returncode != 0:
        raise RuntimeError(f"git fetch failed: {result.stderr.strip()[:200]}")


def _current_commit(runtime):
    result = _git(runtime, "rev-parse", "HEAD")
    if result.returncode != 0:
        raise RuntimeError("git rev-parse failed")
    return result.stdout.strip()


def _latest_commit(runtime):
    result = _git(runtime, "rev-parse", f"origin/{BRANCH}")
    if result.returncode != 0:
        raise RuntimeError("git rev-parse origin failed")
    return result.stdout.strip()


def _changelog(runtime):
    result = _git(runtime, "log", "--pretty=format:%h %s", f"HEAD..origin/{BRANCH}", "--max-count=10")
    if result.returncode != 0:
        raise RuntimeError("git log failed")
    lines = [line for line in result.stdout.splitlines() if line.strip()]
    if not lines:
        return ""
    entries = []
    for line in lines:
        sha, _, title = line.partition(" ")
        entries.append(f"<b>{_escape(sha)}</b> <i>{_escape(title)}</i>")
    return "<br>".join(entries)


def _pull(runtime):
    before = _current_commit(runtime)
    result = _git(runtime, "pull", "--ff-only", "origin", BRANCH, timeout=300)
    if result.returncode != 0:
        raise RuntimeError(f"git pull failed: {result.stderr.strip()[:300]}")
    after = _current_commit(runtime)
    diff = _git(runtime, "diff", "--name-only", before, after)
    deps_changed = any(
        name in ("pyproject.toml", "uv.lock", "requirements.txt")
        for name in diff.stdout.splitlines()
    )
    return before, after, deps_changed


def _sync_deps(runtime):
    venv = runtime.config.state_path.parent / ".venv" if hasattr(runtime.config, "state_path") else None
    root = _repo_dir(runtime)
    try:
        import sys
        subprocess.run(
            [sys.executable, "-m", "hotaru_deps_sync"],
            cwd=root,
            timeout=600,
            capture_output=True,
        )
    except Exception:
        pass


async def _bot_edit(ctx, chat_id, message_id, text, inline_message_id=None):
    params = {"text": text, "parse_mode": "HTML"}
    if isinstance(inline_message_id, str) and inline_message_id:
        params["inline_message_id"] = inline_message_id
    else:
        params.update({"chat_id": chat_id, "message_id": message_id})
    await ctx.bot.call("editMessageText", **params)


async def _status(ctx, text):
    record = ctx.kernel_messages.get(SLOT)
    if record is None:
        return None
    ctx.kernel_messages.put(SLOT, "updater", record.chat_id, record.message_id, text, record.meta)
    try:
        await _bot_edit(ctx, record.chat_id, record.message_id, text)
    except Exception:
        pass
    return record


async def _recover(ctx):
    from hotaru.kmsg import KernelMessageService
    record = ctx.kernel_messages.get(SLOT)
    if record is None:
        return
    meta = record.meta or {}
    restarting = meta.get("restarting") or meta.get("update_ts")
    if not restarting:
        return
    took = round(time.time() - float(restarting)) if isinstance(restarting, (int, float)) else "n/a"
    meta = dict(meta)
    meta.pop("restarting", None)
    meta.pop("update_ts", None)
    ctx.kernel_messages.put(SLOT, "updater", record.chat_id, record.message_id, f"<b>Hotaru updated</b> in {took}s ✓", meta)
    try:
        await _bot_edit(ctx, record.chat_id, record.message_id, f"<b>Hotaru updated</b> in {took}s ✓")
    except Exception:
        pass


def _notify_text(current, latest, changelog):
    link = f'<a href="{REPO_URL}/compare/{current[:12]}...{latest[:12]}">{latest[:6]}</a>'
    return (
        f"<b>Hotaru update available</b><br>"
        f"current: <code>{_escape(current[:7])}</code> → {link}<br><br>"
        f"{changelog}"
    )


async def command_updlog(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("<b>Runtime unavailable</b>", parse_mode="HTML")
        return
    try:
        _fetch_origin(runtime)
        changelog = _changelog(runtime)
    except Exception as exc:
        await ctx.respond(f"<b>Changelog failed:</b> <i>{_escape(exc)}</i>", parse_mode="HTML")
        return
    if not changelog:
        await ctx.respond("<b>Hotaru is up to date</b>", parse_mode="HTML")
        return
    current = _current_commit(runtime)
    latest = _latest_commit(runtime)
    await ctx.respond(_notify_text(current, latest, changelog), parse_mode="HTML")


async def command_updoff(ctx, invocation):
    ctx.state.set("notify", False)
    await ctx.respond("Update notifications disabled. Use .updon to re-enable.", parse_mode="HTML")


async def command_updon(ctx, invocation):
    ctx.state.set("notify", True)
    await ctx.respond("Update notifications enabled.", parse_mode="HTML")
    await _recover(ctx)


async def _run_update(ctx, notify=None):
    runtime = ctx.runtime
    async def say(text):
        if notify is not None:
            await notify(text)
        else:
            await _status(ctx, text)
    await say("<b>Downloading update…</b>")
    try:
        before, after, deps_changed = _pull(runtime)
    except Exception as exc:
        await say(f"<b>Update failed:</b> <i>{_escape(exc)}</i>")
        return
    if before == after:
        await say("<b>Already up to date</b>")
        return
    if deps_changed:
        await say("<b>Syncing dependencies…</b>")
        _sync_deps(runtime)
    await say(f"<b>Updated to</b> <code>{_escape(after[:7])}</code>. Restarting…")
    record = ctx.kernel_messages.get(SLOT)
    if record is not None:
        meta = dict(record.meta or {})
        meta["restarting"] = time.time()
        ctx.kernel_messages.put(SLOT, "updater", record.chat_id, record.message_id, f"<b>Updated to</b> <code>{_escape(after[:7])}</code>. Restarting…", meta)
    await asyncio.sleep(1)
    await _restart_service(ctx)


async def _restart_service(ctx):
    import sys
    runtime = ctx.runtime
    try:
        if runtime.app:
            await asyncio.wait_for(runtime.app.close(), timeout=1.0)
    except Exception:
        pass
    if "INVOCATION_ID" in os.environ:
        service_name = None
        is_user_service = False
        try:
            with open("/proc/self/cgroup", "r") as f:
                for line in f:
                    if ".service" in line:
                        service_name = line.strip().split("/")[-1]
                        if "user.slice" in line or "user@" in line:
                            is_user_service = True
                        break
        except Exception:
            pass
        if service_name:
            cmd = ["systemctl", "--user" if is_user_service else "", "restart", service_name]
            cmd = [c for c in cmd if c]
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
    os.execv(sys.executable, [sys.executable, "-m", "hotaru"])


async def command_upd(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("<b>Runtime unavailable</b>", parse_mode="HTML")
        return
    force = "force" in invocation.args or "-f" in invocation.args
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception as exc:
        if force:
            raise
        await ctx.respond(f"<b>Update check failed:</b> <i>{_escape(exc)}</i>", parse_mode="HTML")
        return

    if current == latest:
        await ctx.respond(f"<b>Already up to date</b> <code>{_escape(current[:7])}</code>", parse_mode="HTML")
        return

    if force:
        await _run_update(ctx)
        return

    async def update_handler(callback, payload):
        await callback.answer("Updating…")
        await _run_update(ctx)

    buttons = [
        [
            ctx.ui.button("Update", update_handler, style="primary"),
        ]
    ]
    message = await ctx.respond(
        _notify_text(current, latest, changelog) + "<br><br>Update now?",
        buttons=buttons,
        inline=True,
        parse_mode="HTML",
    )
    body = message.get("result", message) if isinstance(message, dict) else message
    if isinstance(body, dict):
        chat_id = body.get("chat", {}).get("id") or body.get("chat_id")
        message_id = body.get("message_id")
        if isinstance(chat_id, int) and isinstance(message_id, int):
            ctx.kernel_messages.put(SLOT, "updater", chat_id, message_id, _notify_text(current, latest, changelog), {})


async def task_poller(ctx):
    runtime = ctx.runtime
    if runtime is None:
        return
    await _recover(ctx)
    if ctx.state.get("notify", True) is False:
        return
    try:
        _fetch_origin(runtime)
        current = _current_commit(runtime)
        latest = _latest_commit(runtime)
        changelog = _changelog(runtime)
    except Exception:
        return
    if not changelog or current == latest:
        return
    notified = ctx.state.get("notified_commit")
    if notified == latest:
        return
    owner = None
    kernel = getattr(runtime, "kernel", None)
    if kernel is not None:
        owner = getattr(kernel, "owner_id", None)
    if owner is None:
        return

    async def update_handler(callback, payload):
        await callback.answer("Updating…")
        await _run_update(ctx)

    buttons = [
        [
            ctx.ui.button("Update", update_handler, style="primary"),
        ]
    ]
    text = _notify_text(current, latest, changelog)
    try:
        message = await ctx.bot.send_message(owner, text, buttons=buttons)
    except Exception:
        return
    body = message.get("result", message) if isinstance(message, dict) else message
    if isinstance(body, dict):
        chat_id = body.get("chat", {}).get("id") or body.get("chat_id")
        message_id = body.get("message_id")
        if isinstance(chat_id, int) and isinstance(message_id, int):
            ctx.kernel_messages.put(SLOT, "updater", chat_id, message_id, text, {})
    ctx.state.set("notified_commit", latest)
