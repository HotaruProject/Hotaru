HOTARU = {
    "id": "logger",
    "version": "1.0.0",
    "commands": ["logs"],
    "capabilities": ["mt", "state"],
    "tasks": {
        "pump": {"interval": 2, "autostart": True},
    },
    "rise": "hookup",
    "fade": "unhook",
}

from typing import Any


import asyncio
import html
import time

TOPIC_TITLE = "Logs"

# Standard production log levels — numeric value matches Python logging convention.
# Higher = more severe; filter passes events with level >= floor.
# ALL (0) captures everything including custom trace-level events.
LEVELS = {
    "all":      0,
    "debug":    10,
    "info":     20,
    "warn":     30,
    "warning":  30,
    "error":    40,
    "critical": 50,
    "fatal":    50,
}
# Canonical names shown in help / status (excludes aliases)
LEVEL_NAMES = ["all", "debug", "info", "warn", "error", "fatal"]
_DEFAULT_FLOOR = LEVELS["info"]

_state: dict[str, Any] = {"sub": None, "queue": None, "topic_id": None, "last_sync": 0.0, "failed": 0, "last_error": ""}


def _obs(ctx: Any) -> Any:
    return getattr(ctx.runtime, "observatory", None)


def _emit(ctx: Any, event: Any, **fields: Any) -> Any:
    obs = _obs(ctx)
    if obs is not None:
        try:
            obs.emit("logger", event, **fields)
        except Exception:
            pass


def _level_floor(state: Any) -> Any:
    raw = state.get("level") if state is not None else None
    if isinstance(raw, str) and raw.lower() in LEVELS:
        return LEVELS[raw.lower()]
    return _DEFAULT_FLOOR


def _fmt(payload: Any) -> Any:
    level = str(payload.get("level") or "info").upper()
    comp = str(payload.get("component") or "-")
    event = str(payload.get("event") or "-")
    stamp = time.strftime("%H:%M:%S", time.localtime(payload.get("ts") or 0))
    parts = [f"[{stamp}]", level, comp, event]
    for key in ("module", "error", "detail", "msg", "name", "path", "username", "target"):
        value = payload.get(key)
        if value is None:
            continue
        parts.append(f"{key}={value}")
    return html.escape(" ".join(str(p) for p in parts if p), quote=False)


def _sink(payload: Any) -> Any:
    if not isinstance(payload, dict):
        return
    if payload.get("component") == "logger":
        return
    if payload.get("component") == "forum":
        return
    level = str(payload.get("level") or "info").lower()
    # Pass events whose numeric severity >= current floor (more severe = higher number).
    if LEVELS.get(level, LEVELS["info"]) < _state.get("floor", _DEFAULT_FLOOR):
        return
    queue = _state["queue"]
    if queue is None:
        return
    try:
        queue.put_nowait((time.monotonic(), payload))
    except Exception:
        pass


async def hookup(ctx: Any) -> Any:
    _state["queue"] = asyncio.Queue(maxsize=500)
    _state["floor"] = _level_floor(ctx.state)
    obs = _obs(ctx)
    if obs is not None:
        _state["sub"] = obs.subscribe(_sink)
    _emit(ctx, "hooked")


async def unhook(ctx: Any) -> Any:
    obs = _obs(ctx)
    sub = _state.get("sub")
    if obs is not None and sub is not None:
        try:
            obs.unsubscribe(sub)
        except Exception:
            pass
    _state["sub"] = None
    _emit(ctx, "unhooked")


async def task_pump(ctx: Any) -> Any:
    if ctx.state.get("enabled", True) is False:
        return
    now = time.monotonic()
    topic_id = _state.get("topic_id")
    if topic_id is None or now - _state.get("last_sync", 0.0) > 30:
        try:
            topic_id = await ctx.forum.ensure_topic(TOPIC_TITLE)
            _state["topic_id"] = topic_id
            _state["last_sync"] = now if topic_id is not None else 0.0
            if topic_id is None:
                return
        except Exception as exc:
            _state["topic_id"] = None
            _state["last_sync"] = 0.0
            _state["failed"] += 1
            _state["last_error"] = f"{type(exc).__name__}: {exc}"[:200]
            _emit(ctx, "topic_error", error=type(exc).__name__, detail=str(exc)[:160])
            return
    queue = _state.get("queue")
    if queue is None:
        return
    batch = []
    while not queue.empty() and len(batch) < 40:
        try:
            stamped, payload = queue.get_nowait()
        except Exception:
            break
        if now - stamped > 60.0:
            continue
        batch.append(payload)
    if not batch:
        return
    if topic_id is None:
        return
    try:
        await ctx.forum.send(topic_id, "\n".join(_fmt(p) for p in batch))
        _state["failed"] = 0
    except Exception as exc:
        _state["topic_id"] = None
        _state["last_sync"] = 0.0
        _state["failed"] += 1
        _state["last_error"] = f"{type(exc).__name__}: {exc}"[:200]
        _emit(ctx, "send_error", error=type(exc).__name__, detail=str(exc)[:160])


async def command_logs(ctx: Any, invocation: Any) -> Any:
    raw = " ".join(invocation.args)
    args = raw.split()
    if args and args[0] in ("on", "off"):
        enabled = args[0] == "on"
        ctx.state.set("enabled", enabled)
        key = "kernel.logger.mirror_on" if enabled else "kernel.logger.mirror_off"
        await ctx.respond(f"<b>{ctx.t(key, 'Log mirror ' + args[0])}</b>", parse_mode="HTML")
        return
    if args and args[0].lower() in LEVELS and len(args) == 1:
        name = args[0].lower()
        ctx.state.set("level", name)
        _state["floor"] = LEVELS[name]
        await ctx.respond(f"<code>{ctx.t('kernel.logger.level_set', 'Mirror level: ' + name, level=name)}</code>", parse_mode="HTML")
        return
    if args and args[0] in ("status", "st"):
        failed = _state.get("failed", 0)
        err = _state.get("last_error", "")
        text = ctx.t("kernel.logger.status", "Топик: {topic} • ошибок: {failed}", topic=_state.get("topic_id") or "pending", failed=failed)
        if err:
            text += ctx.t("kernel.logger.status_error", " • последняя: {error}", error=html.escape(err, quote=False))
        await ctx.respond(f"<code>{html.escape(text, quote=False)}</code>", parse_mode="HTML")
        return
    obs = _obs(ctx)
    if obs is None:
        await ctx.respond(ctx.t("kernel.logger.no_observatory", "Обсерватория недоступна"), parse_mode="HTML")
        return
    level = args[0].lower() if args and args[0].lower() in LEVELS else "debug"
    entries = obs.tail(lines=60, level=level)
    if not entries:
        await ctx.respond(ctx.t("kernel.logger.no_entries", "Нет записей этого уровня"), parse_mode="HTML")
        return
    import os
    import tempfile
    fd, raw_path = tempfile.mkstemp(prefix="hotaru-logs-", suffix=".txt")
    os.close(fd)
    try:
        with open(raw_path, "w", encoding="utf-8") as stream:
            stream.write("\n".join(_fmt(entry) for entry in entries))
        caption = ctx.t("kernel.logger.logs_caption", "Логи Hotaru: {count} записей (уровень {level})", count=len(entries), level=level)
        await ctx.respond_file(raw_path, caption, file_name="hotaru-logs.txt", mime_type="text/plain")
        _emit(ctx, "logs_delivered", count=len(entries))
    finally:
        try:
            os.unlink(raw_path)
        except OSError:
            pass
