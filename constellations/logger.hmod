HOTARU = {
    "id": "logger",
    "version": "1.2.0",
    "commands": ["logs", "loglevel"],
    "capabilities": ["mt", "state"],
    "banner": "https://raw.githubusercontent.com/HotaruProject/Hotaru/develop/hotaru/assets/logger.mp4",
    "tasks": {
        "pump": {"interval": 2, "autostart": True},
    },
    "config_schema": {
        "level": {
            "type": "choice",
            "options": ["all", "debug", "info", "warn", "error", "fatal"],
            "default": "info",
            "category": "General",
        },
        "batch_size": {
            "type": "int",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "category": "Performance",
        },
        "auto_topic": {
            "type": "bool",
            "default": True,
            "category": "General",
        },
    },
    "rise": "hookup",
    "fade": "unhook",
}

from typing import Any, Dict, List, Mapping, Optional, cast


import asyncio
import html
import time

TOPIC_TITLE = "Logs"
TOPIC_EMOJI_ID = 5257965174979042426

LEVELS = {
    "all":      0,
    "debug":    10,
    "info":     20,
    "warn":     30,
    "warning":  30,
    "error":    40,
    "critical": 50,
    "fatal":    50,
}
LEVEL_NAMES = ["all", "debug", "info", "warn", "error", "fatal"]
_DEFAULT_FLOOR = LEVELS["info"]

_state: Dict[str, Any] = {"sub": None, "queue": None, "topic_id": None, "last_sync": 0.0, "failed": 0, "last_error": ""}


def _obs(ctx: Any) -> Any:
    return getattr(ctx.runtime, "observatory", None)


def _emit(ctx: Any, event: Any, **fields: Any) -> Any:
    obs = _obs(ctx)
    if obs is not None:
        try:
            obs.emit("logger", event, **fields)
        except Exception:
            pass


def _level_floor(state: Any) -> Any:
    raw = state.get("level") if state is not None else None
    if isinstance(raw, str) and raw.lower() in LEVELS:
        return LEVELS[raw.lower()]
    return _DEFAULT_FLOOR


def _fmt(ctx: Any, payload: Mapping[str, Any]) -> str:
    level = str(payload.get("level") or "info").upper()
    comp = str(payload.get("component") or "-")
    event = str(payload.get("event") or "-")
    stamp = ctx.tools.timestamp(payload.get("ts") or 0, ctx.i18n.language)
    parts = [f"[{stamp}]", level, comp, event]
    for key in sorted(set(payload) - {"ts", "time", "level", "component", "event"}):
        value = payload.get(key)
        if value is None:
            continue
        parts.append(f"{key}={value}")
    return html.escape(" ".join(str(p) for p in parts if p), quote=False)


def _level_icon(level: str) -> str:
    lvl = str(level or "").lower()
    if lvl in ("error", "critical", "fatal"):
        return '<tg-emoji emoji-id="5260342697075416641">❌</tg-emoji>'
    if lvl in ("warn", "warning"):
        return '<tg-emoji emoji-id="5355133243773435190">⚠️</tg-emoji>'
    if lvl == "debug":
        return '<tg-emoji emoji-id="5258152182150077732">⚡️</tg-emoji>'
    return '<tg-emoji emoji-id="5258503720928288433">ℹ️</tg-emoji>'


def _rich(ctx: Any, batch: List[Mapping[str, Any]]) -> dict[str, Any]:
    from relay.emoji import to_rich
    from relay.toolkit import wordmark
    wm = wordmark()
    sources = sorted({str(p.get("module") or p.get("component") or "-") for p in batch})
    sources_text = ", ".join(sources[:3]) + (f" +{len(sources)-3}" if len(sources) > 3 else "")
    lines: List[str] = [
        f'{wm} · <tg-emoji emoji-id="5310285203858535580">📔</tg-emoji> <b>{html.escape(ctx.t("kernel.logger.log", "Log Mirror"))}</b>',
        f'<blockquote><tg-emoji emoji-id="5258514780469075716">📂</tg-emoji> <b>{html.escape(ctx.t("kernel.logger.events", "Events"))}:</b> <code>{len(batch)}</code> · <b>{html.escape(ctx.t("kernel.logger.sources", "Sources"))}:</b> <code>{html.escape(sources_text)}</code></blockquote>',
        '',
        '<blockquote expandable>',
    ]
    for payload in batch:
        stamp_val = float(payload.get("ts") or 0)
        time_str = ctx.tools.timestamp(stamp_val, ctx.i18n.language) if hasattr(ctx, "tools") else time.strftime("%H:%M:%S", time.gmtime(stamp_val))
        source = str(payload.get("component") or "-")
        if payload.get("module") and payload["module"] != source:
            source += f"/{payload['module']}"
        lvl = str(payload.get("level") or "info").lower()
        icon = _level_icon(lvl)
        event = str(payload.get("event") or "-")
        lines.append(f'{icon} <b>[{html.escape(time_str)}] {lvl.upper()}</b> · <code>{html.escape(source)}</code> · <b>{html.escape(event)}</b>')
        extras = []
        if payload.get("msg") is not None:
            extras.append(str(payload["msg"]))
        for key in sorted(set(payload) - {"ts", "time", "level", "component", "module", "event", "msg"}):
            val = payload.get(key)
            if val is not None:
                extras.append(f"{key}={val}")
        if extras:
            lines.append(f'<code>{html.escape(" ".join(extras)[:800])}</code>')
        lines.append('')
    lines.append('</blockquote>')
    return {"_": "inputRichMessageHTML", **to_rich("\n".join(lines).strip())}


def _sink(payload: Any) -> Any:
    if not isinstance(payload, dict):
        return
    payload = cast(Mapping[str, Any], payload)
    if payload.get("component") == "logger":
        return
    if payload.get("component") == "forum":
        return
    if payload.get("component") == "updater" and payload.get("event") in ("poller_uptodate", "poller_notified"):
        return
    if payload.get("component") == "connection" and payload.get("event") in ("recovering", "recovered"):
        return
    if payload.get("component") == "mtproto" and payload.get("event") == "log" and payload.get("routine_transport") is True:
        return
    level = str(payload.get("level") or "info").lower()
    if LEVELS.get(level, LEVELS["info"]) < _level_floor(_state.get("config")):
        return
    queue = _state["queue"]
    if queue is None:
        return
    try:
        queue.put_nowait((time.monotonic(), payload))
    except asyncio.QueueFull:
        _state["lost"] = _state.get("lost", 0) + 1


async def hookup(ctx: Any) -> Any:
    _state["queue"] = asyncio.Queue(maxsize=500)
    _state["config"] = ctx.config
    _state["lost"] = 0
    _state["reported_lost"] = 0
    _state["pending"] = []
    obs = _obs(ctx)
    if obs is not None:
        _state["sub"] = obs.subscribe(_sink)
    _emit(ctx, "hooked")


async def unhook(ctx: Any) -> Any:
    obs = _obs(ctx)
    sub = _state.get("sub")
    if obs is not None and sub is not None:
        try:
            obs.unsubscribe(sub)
        except Exception:
            pass
    _state["sub"] = None
    _emit(ctx, "unhooked")


async def task_pump(ctx: Any) -> Any:
    if ctx.state.get("enabled", True) is False or not ctx.config.get("auto_topic", True):
        return
    now = time.monotonic()
    topic_id = _state.get("topic_id")
    if topic_id is None or now - _state.get("last_sync", 0.0) > 30:
        try:
            topic_id = await ctx.forum.ensure_topic(TOPIC_TITLE, icon_emoji_id=TOPIC_EMOJI_ID)
            _state["topic_id"] = topic_id
            _state["last_sync"] = now if topic_id is not None else 0.0
            if topic_id is None:
                return
        except Exception as exc:
            _state["topic_id"] = None
            _state["last_sync"] = 0.0
            _state["failed"] += 1
            _state["last_error"] = f"{type(exc).__name__}: {exc}"[:200]
            _emit(ctx, "topic_error", error=type(exc).__name__, detail=str(exc)[:160])
            return
    queue = _state.get("queue")
    if queue is None:
        return
    batch: List[Mapping[str, Any]] = _state["pending"]
    limit = max(1, min(100, int(ctx.config.get("batch_size", 20))))
    lost = _state.get("lost", 0)
    if lost > _state.get("reported_lost", 0) and len(batch) < limit:
        batch.append({"ts": time.time(), "level": "warn", "component": "logger", "event": "mirror_overflow", "lost": lost - _state.get("reported_lost", 0), "lost_total": lost})
        _state["reported_lost"] = lost
    while not queue.empty() and len(batch) < limit:
        try:
            _, payload = queue.get_nowait()
        except asyncio.QueueEmpty:
            break
        batch.append(payload)
    if not batch:
        return
    try:
        await ctx.forum.send(topic_id, "", rich=_rich(ctx, batch[:limit]))
        del batch[:limit]
        _state["failed"] = 0
    except Exception as exc:
        _state["topic_id"] = None
        _state["last_sync"] = 0.0
        _state["failed"] += 1
        _state["last_error"] = f"{type(exc).__name__}: {exc}"[:200]
        _emit(ctx, "send_error", error=type(exc).__name__, detail=str(exc)[:160])


def level_menu(ctx: Any, nav: Any = None) -> Any:
    k = ctx.screens
    current = str(ctx.config.get("level", "info")).lower()
    options = [
        k.button(k.radio(opt.upper(), opt == current), set_level_screen, style="success" if opt == current else None, level=opt)
        for opt in LEVEL_NAMES
    ]
    rows = k.grid(options, 2)
    rows.append(k.footer())
    text = f"{k.wordmark()}  <b>// Log Level</b>"
    return k.screen(text, rows, banner=k.banner("logger"), rich=True)


async def set_level_screen(ctx: Any, nav: Any) -> Any:
    level = str(nav.arg("level") or "info").lower()
    if level in LEVELS:
        canonical = "warn" if level == "warning" else "fatal" if level == "critical" else level
        ctx.config.set("level", canonical)
    screen = level_menu(ctx, nav)
    screen.toast = f"✅ {level.upper()}"
    return screen


async def command_loglevel(ctx: Any, invocation: Any) -> Any:
    raw = " ".join(invocation.args).strip()
    if not raw:
        await ctx.screens.show(level_menu(ctx))
        return
    level = raw.lower()
    if level not in LEVELS:
        valid = ", ".join(f"<code>{l.upper()}</code>" for l in LEVEL_NAMES)
        await ctx.respond(
            f'<tg-emoji emoji-id="5260342697075416641">❌</tg-emoji> {ctx.t("kernel.logger.invalid_level", levels=valid)}',
            parse_mode="HTML",
            output="edit",
        )
        return
    canonical = "warn" if level == "warning" else "fatal" if level == "critical" else level
    ctx.config.set("level", canonical)
    await ctx.respond(
        f'<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji> <b>{ctx.t("kernel.logger.level_set", level=canonical.upper())}</b>',
        parse_mode="HTML",
        output="edit",
    )


def logs_menu(ctx: Any, nav: Any = None) -> Any:
    k = ctx.screens
    options = [
        k.button(opt.upper(), send_logs_screen, level=opt)
        for opt in LEVEL_NAMES
    ]
    rows = k.grid(options, 2)
    rows.append(k.footer())
    text = f"{k.wordmark()}  <b>// Export Logs</b>"
    return k.screen(text, rows, banner=k.banner("logger"), rich=True)


async def send_logs_screen(ctx: Any, nav: Any) -> Any:
    level = str(nav.arg("level") or "debug").lower()
    await _export_logs(ctx, level=level, count=100, component=None)
    screen = logs_menu(ctx, nav)
    screen.toast = f"✅ {level.upper()}"
    return screen


async def _export_logs(ctx: Any, level: str = "debug", count: int = 60, component: Optional[str] = None) -> None:
    obs = _obs(ctx)
    if obs is None:
        await ctx.respond(f'<tg-emoji emoji-id="5260342697075416641">❌</tg-emoji> <b>{ctx.t("kernel.logger.no_observatory")}</b>', parse_mode="HTML", output="edit")
        return
    entries = obs.tail(lines=count, level=level, component=component)
    if not entries:
        await ctx.respond(f'<tg-emoji emoji-id="5260342697075416641">❌</tg-emoji> <b>{ctx.t("kernel.logger.no_entries")}</b>', parse_mode="HTML", output="edit")
        return
    import os
    import tempfile
    fd, raw_path = tempfile.mkstemp(prefix="hotaru-logs-", suffix=".txt")
    os.close(fd)
    try:
        with open(raw_path, "w", encoding="utf-8") as stream:
            stream.write("\n".join(_fmt(ctx, entry) for entry in entries))
        caption = f'<tg-emoji emoji-id="5257965174979042426">📝</tg-emoji> <b>{html.escape(ctx.t("kernel.logger.logs_caption", count=len(entries), level=level.upper()), quote=False)}</b>'
        await ctx.respond_file(raw_path, caption, file_name="hotaru-logs.txt", mime_type="text/plain")
        _emit(ctx, "logs_delivered", count=len(entries))
    finally:
        try:
            os.unlink(raw_path)
        except OSError:
            pass


async def command_logs(ctx: Any, invocation: Any) -> Any:
    raw = " ".join(invocation.args).strip()
    args = raw.split()
    if not args:
        await ctx.screens.show(logs_menu(ctx))
        return
    if args[0] in ("on", "off"):
        enabled = args[0] == "on"
        ctx.state.set("enabled", enabled)
        icon = '<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji>' if enabled else '<tg-emoji emoji-id="5260342697075416641">❌</tg-emoji>'
        key = "kernel.logger.mirror_on" if enabled else "kernel.logger.mirror_off"
        await ctx.respond(f"{icon} <b>{ctx.t(key)}</b>", parse_mode="HTML", output="edit")
        return
    if args[0] in ("status", "st"):
        failed = _state.get("failed", 0)
        err = _state.get("last_error", "")
        text = ctx.t('kernel.logger.status', topic=_state.get('topic_id') or ctx.t('kernel.logger.pending'), failed=failed)
        text += f" · lost={_state.get('lost', 0)} · queued={(_state['queue'].qsize() if _state.get('queue') is not None else 0) + len(_state.get('pending', []))}"
        if err:
            text += ctx.t('kernel.logger.status_error', error=html.escape(err, quote=False))
        await ctx.respond(f'<tg-emoji emoji-id="5289589186683222806">📶</tg-emoji> <code>{html.escape(text, quote=False)}</code>', parse_mode="HTML", output="edit")
        return
    level = args[0].lower() if args[0].lower() in LEVELS else "debug"
    rest = args[1:] if args[0].lower() in LEVELS else args
    count = int(rest[0]) if rest and rest[0].isdigit() else 60
    count = max(1, min(count, 1000))
    if rest and rest[0].isdigit():
        rest = rest[1:]
    component = rest[0].lower() if rest else None
    await _export_logs(ctx, level=level, count=count, component=component)
