HOTARU = {
    "id": "acl",
    "version": "3.0.0",
    "commands": ["perms", "perm", "whois", "owadd", "owrm", "owls", "sgls", "sg", "sgnew", "sgdel", "sgadd", "sgrm", "rule", "rulerm", "ruleclr"],
    "capabilities": ["mt"],
}

from typing import Any, Mapping, cast
from types import SimpleNamespace
from hotaru.access import AccessError, Permission, TsecRule, permission_from_label
from hotaru.response import reply_message_id
import html as _html
import math
import re
import time

ROLES = {"owner": Permission.OWNER, "admin": Permission.ADMIN, "trusted": Permission.TRUSTED, "everyone": Permission.EVERYONE}
PAGE = 8

def _escape(value: Any) -> Any:
    return _html.escape(str(value), quote=False)

def _usage(ctx: Any, name: str) -> str:
    return ctx.t("acl.syntax." + name, prefix=_escape(ctx.runtime.config.prefix))

def _id(value: Any, signed: bool = False) -> int | None:
    raw = str(value)
    if re.fullmatch(r"-?[0-9]{1,19}" if signed else r"[0-9]{1,19}", raw):
        uid = int(raw)
        if uid and abs(uid) < 2 ** 63:
            return uid
    return None

def _roles(ctx: Any, bits: Permission) -> str:
    return " · ".join(ctx.t("acl.roles." + name) for name, value in ROLES.items() if bits & value) or ctx.t("acl.roles.none")

def _role(ctx: Any, uid: int) -> str:
    return ctx.t("acl.full_owner") if ctx.access_admin.is_owner(uid) else _roles(ctx, ctx.access_admin.permissions_of(uid))

def _active(expires: Any) -> bool:
    return isinstance(expires, (int, float)) and math.isfinite(expires) and (expires == 0 or expires > time.time())

def _rules(ctx: Any, kind: str | None = None, target: Any = None) -> list[dict[str, Any]]:
    rows = [{"kind": r.target_type, "target": r.target, "type": r.rule_type, "rule": r.rule, "expires": r.expires} for r in ctx.access_admin.tsec_rules()]
    rows += [{"kind": "sgroup", "target": name, "type": p.get("rule_type"), "rule": p.get("rule"), "expires": p.get("expires", 0)} for name, group in ctx.access_admin.sgroups().items() for p in group.permissions]
    return [r for r in rows if _active(r["expires"]) and (kind is None or r["kind"] == kind) and (target is None or str(r["target"]) == str(target))]

def _rule_text(ctx: Any, rule: dict[str, Any], scope: bool = True) -> str:
    text = f'<code>{_escape(rule["type"])}/{_escape(rule["rule"])}</code>'
    if scope:
        text = f'{ctx.t("acl.scopes." + rule["kind"])} <code>{_escape(rule["target"])}</code> · ' + text
    if rule["expires"]:
        text += " · " + ctx.tools.timestamp(rule["expires"], ctx.i18n.language)
    return text

def _command(ctx: Any, name: str) -> Any:
    prefix = ctx.runtime.config.prefix
    registry = ctx.runtime.kernel.registry
    return registry.resolve_name(name) or registry.resolve_name(name.removeprefix(prefix) if prefix else name)

def _target(kind: str, raw: Any) -> Any:
    if kind in {"user", "chat"}:
        return _id(raw, signed=kind == "chat")
    if kind == "sgroup" and isinstance(raw, str) and raw.isalnum() and len(raw) <= 32:
        return raw
    return None

async def _reply(ctx: Any) -> Any:
    fetch = getattr(ctx, "reply", None)
    if callable(fetch):
        try:
            return await cast(Any, fetch())
        except Exception:
            pass
    return None

def _sender(reply: Any) -> int | None:
    from_peer = reply.get("from_id") if hasattr(reply, "get") else getattr(reply, "from_id", None)
    if isinstance(from_peer, dict):
        uid = cast(Mapping[str, object], from_peer).get("user_id")
        return _id(uid)
    return _id(from_peer)

async def _resolve_target_user(ctx: Any, invocation: Any, start: int = 0) -> Any:
    args = invocation.args[start:]
    if args:
        token = args[0]
        uid = _id(token)
        if uid is not None:
            return uid, args[1:]
        if token.startswith("@"):
            try:
                user: Any = await ctx.resolve(token)
                fallback = getattr(user, "id", None)
                entry = cast(Mapping[str, object], user) if isinstance(user, dict) else None
                if entry is not None and any(kind in str(entry.get("_", "")).lower() for kind in ("chat", "channel")):
                    return None, args
                uid = entry.get("user_id", entry.get("id")) if entry is not None else fallback
                if _id(uid) is not None:
                    return _id(uid), args[1:]
            except Exception:
                pass
            return None, args
        if re.match(r"[-+0-9]", token):
            return None, args
    sender = _sender(await _reply(ctx))
    return (sender if isinstance(sender, int) and sender > 0 else None), args

def _parse_duration(raw: Any) -> Any:
    raw = (raw or "").strip().lower()
    if not raw or raw in {"forever", "навсегда"}:
        return 0
    match = re.fullmatch(r"([0-9]{1,10})([smhdwсмхчдн]?)", raw)
    if not match:
        return None
    units = {"": 60, "s": 1, "с": 1, "м": 60, "m": 60, "х": 60, "h": 3600, "ч": 3600, "d": 86400, "д": 86400, "w": 604800, "н": 604800}
    value = int(match[1]) * units[match[2]]
    return value if 0 < value <= 3153600000 else None

def _grant_rule(ctx: Any, kind: str, target: Any, rule_type: str, rule: str, duration: int) -> str:
    target = _target(kind, target)
    if target is None:
        raise ValueError(ctx.t("acl.invalid_target"))
    if rule_type == "command":
        spec = _command(ctx, rule)
        if spec is None:
            raise ValueError(ctx.t("acl.unknown_command", command=_escape(rule)))
        if spec.kernel:
            raise ValueError(ctx.t("acl.kernel_rule"))
        rule = spec.name
    elif rule_type == "module":
        specs = ctx.runtime.kernel.registry.spec_of(rule)
        if not specs or any(s.kernel for s in specs):
            raise ValueError(ctx.t("acl.kernel_rule"))
    else:
        raise ValueError(ctx.t("acl.bad_rule"))
    expires = time.time() + duration if duration else 0
    item = TsecRule(kind, target, rule_type, rule, expires)
    item.validate()
    if kind == "sgroup":
        group = ctx.access_admin.sgroup(str(target))
        if group is None:
            raise ValueError(ctx.t("acl.group_missing", name=_escape(target)))
        group.permissions[:] = [p for p in group.permissions if (p.get("rule_type"), p.get("rule")) != (rule_type, rule)]
        group.permissions.append({"rule_type": rule_type, "rule": rule, "expires": expires})
        ctx.access_admin.save_sgroups(ctx.access_admin.sgroups())
    else:
        ctx.access_admin.add_tsec(item)
    return rule

async def command_owls(ctx: Any, invocation: Any) -> Any:
    owners = ctx.access_admin.owners
    rows = [f"<code>{uid}</code>" + (ctx.t('acl.account') if uid == getattr(getattr(ctx.runtime.app, 'session', None), 'self_id', None) else ctx.t('acl.protected') if uid in ctx.access_admin.protected else '') for uid in owners]
    await ctx.respond(ctx.t('acl.owners') + "<br>".join(rows), parse_mode="HTML")

async def command_owadd(ctx: Any, invocation: Any) -> Any:
    user_id, rest = await _resolve_target_user(ctx, invocation)
    if user_id is None or rest:
        await ctx.respond(_usage(ctx, "owadd"), parse_mode="HTML")
        return
    if user_id == ctx.access_admin.owner_id:
        await ctx.respond(ctx.t('acl.self_owner'), parse_mode="HTML")
        return
    k = ctx.screens
    await ctx.screens.show(k.screen(ctx.t("acl.owner_confirm", user_id=user_id), [[k.danger(ctx.t("acl.confirm"), confirm_owner, user_id=user_id), k.close(ctx.t("common.cancel"))]]))

async def confirm_owner(ctx: Any, nav: Any) -> Any:
    if not ctx.access_admin.is_owner(nav.actor):
        return ctx.t("acl.no_permission")
    user_id = nav.int("user_id")
    added = ctx.access_admin.add_owner(user_id)
    k = ctx.screens
    return k.screen(ctx.t('acl.owner_added' if added else 'acl.owner_exists', user_id=user_id), [[k.button(ctx.t("acl.manage"), action, view="user", uid=user_id), k.close()]])

async def command_owrm(ctx: Any, invocation: Any) -> Any:
    user_id, rest = await _resolve_target_user(ctx, invocation)
    if user_id is None or rest:
        await ctx.respond(_usage(ctx, "owrm"), parse_mode="HTML")
        return
    try:
        removed = ctx.access_admin.remove_owner(user_id)
    except Exception as exc:
        await ctx.respond(ctx.t("acl.no_permission") if str(exc) == "No permission." else ctx.t("acl.account_owner") if str(exc) == "account owner cannot be removed" else _escape(exc), parse_mode="HTML")
        return
    await ctx.respond(
        ctx.t('acl.owner_removed', user_id=user_id) if removed else ctx.t('acl.owner_missing', user_id=user_id),
        parse_mode="HTML",
    )

async def command_sgnew(ctx: Any, invocation: Any) -> Any:
    if len(invocation.args) != 1 or _target("sgroup", invocation.args[0]) is None:
        await ctx.respond(ctx.t('acl.bad_group'), parse_mode="HTML")
        return
    name = invocation.args[0]
    if ctx.access_admin.sgroup(name) is not None:
        await ctx.respond(ctx.t('acl.group_exists', name=_escape(name)), parse_mode="HTML")
        return
    try:
        ctx.access_admin.create_sgroup(name)
    except Exception as exc:
        await ctx.respond(ctx.t('acl.failed', error=_escape(exc)), parse_mode="HTML")
        return
    await ctx.respond(ctx.t('acl.group_created', name=_escape(name)), parse_mode="HTML")

async def command_sgdel(ctx: Any, invocation: Any) -> Any:
    if len(invocation.args) != 1:
        await ctx.respond(_usage(ctx, "sgdel"), parse_mode="HTML")
        return
    removed = ctx.access_admin.delete_sgroup(invocation.args[0])
    await ctx.respond(
        ctx.t('acl.group_deleted', name=_escape(invocation.args[0])) if removed else ctx.t('acl.group_missing', name=_escape(invocation.args[0])),
        parse_mode="HTML",
    )

async def command_sgls(ctx: Any, invocation: Any) -> Any:
    groups = ctx.access_admin.sgroups()
    if not groups:
        await ctx.respond(ctx.t("acl.no_groups", prefix=_escape(ctx.runtime.config.prefix)), parse_mode="HTML")
        return
    rows = [ctx.t('acl.group_item', name=_escape(g.name), users=len(g.users), rules=len(_rules(ctx, "sgroup", g.name))) for g in groups.values()]
    await ctx.respond(ctx.t('acl.groups') + "<br>".join(rows), parse_mode="HTML")

async def command_sg(ctx: Any, invocation: Any) -> Any:
    if len(invocation.args) != 1:
        await ctx.respond(_usage(ctx, "sg"), parse_mode="HTML")
        return
    group = ctx.access_admin.sgroup(invocation.args[0])
    if group is None:
        await ctx.respond(ctx.t('acl.group_missing', name=_escape(invocation.args[0])), parse_mode="HTML")
        return
    users = "<br>".join(f"▫️ <code>{uid}</code>" for uid in group.users) or ctx.t("common.none")
    rules = "<br>".join(_rule_text(ctx, rule, False) for rule in _rules(ctx, "sgroup", group.name)) or ctx.t("common.none")
    await ctx.respond(
        ctx.t('acl.group_detail', name=_escape(group.name), users=users, rules=rules),
        parse_mode="HTML",
    )

async def command_sgadd(ctx: Any, invocation: Any) -> Any:
    if not invocation.args:
        await ctx.respond(_usage(ctx, "sgadd"), parse_mode="HTML")
        return
    name = invocation.args[0]
    group = ctx.access_admin.sgroup(name)
    if group is None:
        await ctx.respond(ctx.t('acl.group_missing', name=_escape(name)), parse_mode="HTML")
        return
    user_id, rest = await _resolve_target_user(ctx, invocation, 1)
    if user_id is None or rest:
        await ctx.respond(_usage(ctx, "sgadd"), parse_mode="HTML")
        return
    if user_id in group.users:
        await ctx.respond(ctx.t('acl.member_exists', user_id=user_id, name=_escape(name)), parse_mode="HTML")
        return
    group.users.append(user_id)
    groups = ctx.access_admin.sgroups()
    ctx.access_admin.save_sgroups(groups)
    await ctx.respond(ctx.t('acl.member_added', user_id=user_id, name=_escape(name)), parse_mode="HTML")

async def command_sgrm(ctx: Any, invocation: Any) -> Any:
    if not invocation.args:
        await ctx.respond(_usage(ctx, "sgrm"), parse_mode="HTML")
        return
    name = invocation.args[0]
    group = ctx.access_admin.sgroup(name)
    if group is None:
        await ctx.respond(ctx.t('acl.group_missing', name=_escape(name)), parse_mode="HTML")
        return
    user_id, rest = await _resolve_target_user(ctx, invocation, 1)
    if user_id is None or rest:
        await ctx.respond(_usage(ctx, "sgrm"), parse_mode="HTML")
        return
    if user_id not in group.users:
        await ctx.respond(ctx.t('acl.member_missing', user_id=user_id, name=_escape(name)), parse_mode="HTML")
        return
    group.users.remove(user_id)
    groups = ctx.access_admin.sgroups()
    ctx.access_admin.save_sgroups(groups)
    await ctx.respond(ctx.t('acl.member_removed', user_id=user_id, name=_escape(name)), parse_mode="HTML")

async def command_rule(ctx: Any, invocation: Any) -> Any:
    if not 3 <= len(invocation.args) <= 4:
        await ctx.respond(_usage(ctx, "rule"), parse_mode="HTML")
        return
    kind = invocation.args[0].casefold()
    if kind not in {"user", "chat", "sgroup"}:
        await ctx.respond(_usage(ctx, "rule"), parse_mode="HTML")
        return
    target = invocation.args[1]
    rule_raw = invocation.args[2]
    duration = _parse_duration(invocation.args[3] if len(invocation.args) > 3 else None)
    if duration is None:
        await ctx.respond(ctx.t('acl.bad_duration'), parse_mode="HTML")
        return
    if "/" not in rule_raw:
        await ctx.respond(ctx.t('acl.bad_rule'), parse_mode="HTML")
        return
    rule_type, _, rule = rule_raw.partition("/")
    if rule_type not in {"command", "module"} or not rule:
        await ctx.respond(ctx.t('acl.bad_rule'), parse_mode="HTML")
        return
    try:
        rule = _grant_rule(ctx, kind, target, rule_type, rule, duration)
    except ValueError as exc:
        await ctx.respond(str(exc), parse_mode="HTML")
        return
    until = ctx.t('acl.duration', duration=_escape(invocation.args[3])) if duration else ""
    await ctx.respond(ctx.t('acl.rule_added', kind=_escape(kind), target=_escape(target), type=_escape(rule_type), rule=_escape(rule), until=until), parse_mode="HTML")

async def command_rulerm(ctx: Any, invocation: Any) -> Any:
    if len(invocation.args) != 3:
        await ctx.respond(_usage(ctx, "rulerm"), parse_mode="HTML")
        return
    kind = invocation.args[0].casefold()
    if kind not in {"user", "chat", "sgroup"}:
        await ctx.respond(_usage(ctx, "rulerm"), parse_mode="HTML")
        return
    target = invocation.args[1]
    rule_raw = invocation.args[2]
    if "/" in rule_raw:
        _prefix, _, rule_name = rule_raw.partition("/")
        if _prefix not in {"command", "module"} or not rule_name:
            await ctx.respond(ctx.t('acl.bad_rule'), parse_mode="HTML")
            return
    else:
        _prefix = None
        rule_name = rule_raw
    target_value = _target(kind, target)
    if target_value is None:
        await ctx.respond(ctx.t("acl.invalid_target"))
        return
    if _prefix in {None, "command"} and rule_name != "*":
        spec = _command(ctx, rule_name)
        rule_name = spec.name if spec is not None else rule_name
    removed = ctx.access_admin.remove_tsec(kind, target_value, rule_name, _prefix)
    await ctx.respond(
        ctx.t('acl.rule_removed') if removed else ctx.t('acl.nothing_remove'),
        parse_mode="HTML",
    )

async def command_ruleclr(ctx: Any, invocation: Any) -> Any:
    if not 1 <= len(invocation.args) <= 2:
        await ctx.respond(_usage(ctx, "ruleclr"), parse_mode="HTML")
        return
    kind = invocation.args[0].casefold()
    if kind not in {"user", "chat", "sgroup"}:
        await ctx.respond(_usage(ctx, "ruleclr"), parse_mode="HTML")
        return
    target = invocation.args[1] if len(invocation.args) > 1 else None
    target_value = _target(kind, target) if target not in {None, "*"} else None
    if target not in {None, "*"} and target_value is None:
        await ctx.respond(ctx.t("acl.invalid_target"))
        return
    k = ctx.screens
    prompt = ctx.t("acl.clear_confirm", scope=_escape(f"{kind}: {target if target is not None else '*'}"))
    await ctx.screens.show(k.screen(prompt, [[k.danger(ctx.t("acl.confirm"), confirm_clear, kind=kind, target=target_value), k.close(ctx.t("common.cancel"))]]))

async def confirm_clear(ctx: Any, nav: Any) -> Any:
    if not ctx.access_admin.is_owner(nav.actor):
        return ctx.t("acl.no_permission")
    removed = ctx.access_admin.remove_tsec_all(nav.arg("kind"), nav.arg("target"))
    k = ctx.screens
    return k.screen(ctx.t('acl.rules_cleared') if removed else ctx.t('acl.nothing_clear'), [k.footer()])


def _overview(ctx: Any) -> str:
    access = ctx.access_admin
    parts = [ctx.t("acl.owners") + ", ".join(f"<code>{uid}</code>" for uid in access.owners)]
    entries = [entry for entry in access.store.items() if not access.is_owner(entry.user_id)]
    if entries:
        parts.append(ctx.t("acl.permissions") + "<br>".join(f"<code>{entry.user_id}</code> · {_roles(ctx, entry.permissions)}" for entry in entries[:PAGE]))
        if len(entries) > PAGE:
            parts.append(ctx.t("acl.more", count=len(entries) - PAGE))
    parts.append(ctx.t("acl.counts", rules=len(_rules(ctx)), groups=len(access.sgroups())))
    return "<br><br>".join(parts)

def _user_text(ctx: Any, uid: int, chat: Any = None) -> str:
    text = ctx.t("acl.user_detail", user_id=uid, permissions=_role(ctx, uid))
    mt = getattr(ctx.runtime.app, "mt", None)
    entities: dict[Any, dict[str, Any]] = getattr(mt, "entities", None) or {}
    user = entities.get(("user", uid)) or {}
    name = " ".join(str(user.get(key) or "").strip() for key in ("first_name", "last_name")).strip()
    if not name and user.get("username"):
        name = "@" + str(user["username"])
    if name:
        text = f"<b>{_escape(name)}</b><br>" + text
    if ctx.access_admin.is_owner(uid):
        return text
    groups = [g.name for g in ctx.access_admin.sgroups().values() if uid in g.users]
    if groups:
        text += ctx.t("acl.user_groups", groups=_escape(", ".join(groups)))
    rules = [r for r in _rules(ctx) if (r["kind"] == "user" and r["target"] == uid) or (r["kind"] == "chat" and r["target"] == chat) or (r["kind"] == "sgroup" and r["target"] in groups)]
    if rules:
        text += "<br><br>" + ctx.t("acl.rules") + "<br>".join(_rule_text(ctx, rule) for rule in rules[:PAGE])
        if len(rules) > PAGE:
            text += "<br>" + ctx.t("acl.more", count=len(rules) - PAGE)
    return text

def _default(ctx: Any, name: str, bits: Permission) -> Any:
    spec = _command(ctx, name)
    if spec is None:
        raise ValueError(ctx.t("acl.unknown_command", command=_escape(name)))
    if spec.kernel:
        raise ValueError(ctx.t("acl.kernel_rule"))
    if bits == Permission.OWNER:
        ctx.access_admin.clear_default(spec.module_id, spec.name)
    else:
        ctx.access_admin.set_default_permission(spec.module_id, spec.name, bits)
    return spec

async def command_perms(ctx: Any, invocation: Any) -> Any:
    if invocation.args:
        return await command_whois(ctx, invocation)
    data: dict[str, Any] = {"view": "home", "chat": getattr(invocation.message, "chat_id", None)}
    reply = await _reply(ctx)
    if reply is not None or reply_message_id(invocation.message) is not None:
        uid = _sender(reply)
        if uid is None:
            await ctx.respond(ctx.t("acl.invalid_target"), parse_mode="HTML")
            return
        data.update(view="user", uid=uid)
    await ctx.screens.show(_screen(ctx, data))

async def command_whois(ctx: Any, invocation: Any) -> Any:
    uid, args = await _resolve_target_user(ctx, invocation)
    if uid is None or len(args) > 1:
        await ctx.respond(_usage(ctx, "whois"), parse_mode="HTML")
        return
    chat = getattr(invocation.message, "chat_id", None)
    text = _user_text(ctx, uid, chat)
    if args:
        spec = _command(ctx, args[0])
        if spec is None:
            text += "<br>" + ctx.t("acl.unknown_command", command=_escape(args[0]))
        else:
            allowed = ctx.runtime.kernel.is_authorized(SimpleNamespace(from_id=uid, chat_id=chat), spec)
            text += "<br>" + ctx.t("acl.allowed" if allowed else "acl.denied", command=_escape(spec.name))
    k = ctx.screens
    await ctx.screens.show(k.screen(text, [[k.primary(ctx.t("acl.manage"), action, view="user", uid=uid, chat=chat), k.close()]]))

async def command_perm(ctx: Any, invocation: Any) -> Any:
    cmd = invocation.args[0][8:] if invocation.args and invocation.args[0].startswith("command/") else None
    uid, args = (None, invocation.args[1:]) if cmd is not None else await _resolve_target_user(ctx, invocation)
    if (cmd is None and uid is None) or not 1 <= len(args) <= 2 or len(args) == 2 and args[1].casefold() != "remove":
        await ctx.respond(_usage(ctx, "perm"), parse_mode="HTML")
        return
    remove = len(args) == 2
    label = args[0].casefold()
    permission = permission_from_label(label)
    if permission is None:
        await ctx.respond(ctx.t("acl.bad_label", label=_escape(label)), parse_mode="HTML")
        return
    if cmd is not None:
        try:
            spec = _command(ctx, cmd)
            bits = permission
            if remove and spec:
                bits = ctx.access_admin.default_permission(spec.module_id, spec.name) & ~permission or Permission.OWNER
            spec = _default(ctx, cmd, bits)
        except ValueError as exc:
            await ctx.respond(str(exc), parse_mode="HTML")
            return
        await ctx.respond(ctx.t("acl.command_role", command=_escape(spec.name), role=_roles(ctx, bits)), parse_mode="HTML")
        return
    if remove and uid in ctx.access_admin.protected:
        await ctx.respond(ctx.t("acl.no_permission"))
        return
    if permission == Permission.OWNER:
        await ctx.respond(ctx.t("acl.no_owner_grant", prefix=_escape(ctx.runtime.config.prefix)), parse_mode="HTML")
        return
    if ctx.access_admin.is_owner(uid):
        await ctx.respond(ctx.t("acl.full_owner"), parse_mode="HTML")
        return
    try:
        if remove:
            changed = ctx.access_admin.store.revoke(uid, permission)
        else:
            ctx.access_admin.store.grant(uid, permission)
            changed = True
    except AccessError:
        await ctx.respond(ctx.t("acl.no_permission"))
        return
    text = ctx.t("acl.revoked" if remove else "acl.granted", label=_roles(ctx, permission), user_id=uid) if changed else ctx.t("acl.nothing_revoke")
    await ctx.respond(text, parse_mode="HTML")

def _screen(ctx: Any, data: dict[str, Any]) -> Any:
    k = ctx.screens
    access = ctx.access_admin
    view = data.get("view", "home")
    chat = data.get("chat")
    rows: list[list[Any]] = []
    page = max(0, int(data.get("page", 0)))

    def button(text: str, view: str, style: Any = None, **args: Any) -> Any:
        return k.button(text, action, style=style, view=view, chat=chat, **args)

    def field(text: str, op: str, placeholder: str, **args: Any) -> Any:
        return k.input(text, on_input, placeholder, input=op, chat=chat, **args)

    def listing(items: list[Any]) -> None:
        shown, current, pages = k.page(items, page, PAGE)
        rows.extend(k.grid(shown, 2))
        rows.append(k.pager(action, current, pages, **{key: value for key, value in data.items() if key != "page"}))

    text = ctx.t("acl.panel")
    back: dict[str, Any] = {"view": "home"}
    if view == "home":
        text = _overview(ctx)
        rows = [[button(ctx.t("acl.users"), "users"), button(ctx.t("acl.commands"), "commands")],
                [button(ctx.t("acl.groups_title"), "groups"), button(ctx.t("acl.rules_title"), "rules")]]
    elif view == "users":
        users = set(access.owners) | {e.user_id for e in access.store.items()}
        users |= {uid for g in access.sgroups().values() for uid in g.users}
        users |= {int(r["target"]) for r in _rules(ctx, "user")}
        text = "<b>" + ctx.t("acl.users") + "</b>"
        listing([button(str(uid), "user", uid=uid) for uid in sorted(users)])
        rows.append([field(ctx.t("acl.find_user"), "user", ctx.t("acl.user_hint"))])
    elif view in {"user", "memberships"}:
        uid = int(data["uid"])
        text = _user_text(ctx, uid, chat)
        back = {"view": "users"}
        if view == "memberships":
            back = {"view": "user", "uid": uid}
            listing([button(k.check(name, uid in group.users), "memberships", op="member", uid=uid, name=name, enabled=uid not in group.users) for name, group in sorted(access.sgroups().items())])
        else:
            if not access.is_owner(uid):
                bits = access.permissions_of(uid)
                rows.append([button(k.check(ctx.t("acl.roles." + name), bool(bits & ROLES[name])), "user", "success" if bits & ROLES[name] else None, op="role", uid=uid, role=name, enabled=not bool(bits & ROLES[name])) for name in ("admin", "trusted")])
            if uid != access.owner_id and uid not in access.protected:
                owner = access.is_owner(uid)
                rows.append([button(ctx.t("acl.remove_owner" if owner else "acl.add_owner"), "confirm", "danger" if owner else None, op="owner", uid=uid, enabled=not owner)])
            rows.append([button(ctx.t("acl.groups_title"), "memberships", uid=uid), button(ctx.t("acl.rules_title"), "rules", kind="user", target=uid)])
    elif view in {"groups", "members"}:
        if view == "groups":
            text = ctx.t("acl.groups")
            listing([button(name, "group", name=name) for name in sorted(access.sgroups())])
            rows.append([field(ctx.t("acl.add"), "group", ctx.t("acl.group_hint"))])
        else:
            name = data["name"]
            group = access.sgroup(name)
            if group is None:
                return _screen(ctx, {"view": "groups", "chat": chat})
            text = ctx.t("acl.group_title", name=_escape(name))
            listing([button("× " + str(uid), "members", op="member", uid=uid, name=name, enabled=False) for uid in sorted(group.users)])
            rows.append([field(ctx.t("acl.add"), "member", ctx.t("acl.user_hint"), name=name)])
            back = {"view": "group", "name": name}
    elif view == "group":
        name = data["name"]
        group = access.sgroup(name)
        if group is None:
            return _screen(ctx, {"view": "groups", "chat": chat})
        text = ctx.t("acl.group_item", name=_escape(name), users=len(group.users), rules=len(_rules(ctx, "sgroup", name)))
        rows = [[button(ctx.t("acl.users"), "members", name=name), button(ctx.t("acl.rules_title"), "rules", kind="sgroup", target=name)],
                [button(ctx.t("acl.delete"), "confirm", "danger", op="delete_group", name=name)]]
        back = {"view": "groups"}
    elif view == "rules":
        kind, target = data.get("kind"), data.get("target")
        rules = _rules(ctx, kind, target)
        text = ctx.t("acl.rules") + (f"<code>{_escape(target)}</code>" if target is not None else "")
        items: list[Any] = []
        for rule in rules:
            label = f'{rule["type"]}/{rule["rule"]}' if kind else f'{rule["target"]} · {rule["rule"]}'
            items.append(button(label, "rule", **rule))
        listing(items)
        if kind:
            rows.append([button(ctx.t("acl.add"), "types", "primary", kind=kind, target=target), button(ctx.t("acl.clear"), "confirm", "danger", op="clear_rules", kind=kind, target=target)])
            back = {"view": "user", "uid": target} if kind == "user" else {"view": "group", "name": target} if kind == "sgroup" else {"view": "rules"}
        else:
            rows.append([field(ctx.t("acl.add"), "scope", ctx.t("acl.scope_hint"))])
    elif view == "rule":
        text = _rule_text(ctx, data) + ("" if data.get("expires") else "<br>" + ctx.t("acl.forever"))
        rows = [[button(ctx.t("acl.delete"), "rules", "danger", op="delete_rule", kind=data["kind"], target=data["target"], type=data["type"], rule=data["rule"])]]
        back = {"view": "rules", "kind": data["kind"], "target": data["target"]}
    elif view == "types":
        text = ctx.t("acl.choose_rule")
        rows = [[button(ctx.t("acl.commands"), "catalog", kind=data["kind"], target=data["target"], type="command"), button(ctx.t("acl.modules"), "catalog", kind=data["kind"], target=data["target"], type="module")]]
        back = {"view": "rules", "kind": data["kind"], "target": data["target"]}
    elif view in {"commands", "catalog"}:
        registry = ctx.runtime.kernel.registry
        specs = [spec for name in registry.names() if (spec := registry.resolve_name(name)) is not None and not spec.kernel]
        names = sorted({spec.module_id if data.get("type") == "module" else spec.name for spec in specs})
        text = "<b>" + ctx.t("acl.modules" if data.get("type") == "module" else "acl.commands") + "</b>"
        listing([button(name, "command", name=name) if view == "commands" else button(name, "duration", kind=data["kind"], target=data["target"], type=data["type"], rule=name) for name in names])
        if view == "catalog":
            back = {"view": "types", "kind": data["kind"], "target": data["target"]}
    elif view == "command":
        spec = _command(ctx, data["name"])
        if spec is None or spec.kernel:
            return _screen(ctx, {"view": "commands", "chat": chat})
        bits = access.default_permission(spec.module_id, spec.name)
        text = ctx.t("acl.command_role", command=_escape(spec.name), role=_roles(ctx, bits))
        if bits == Permission.EVERYONE:
            text += "<br>" + ctx.t("acl.all_chats")
        keys = [button(k.radio(ctx.t("acl.roles." + name), bits == value), "command", "success" if bits == value else None, op="default", name=spec.name, role=name) for name, value in ROLES.items()]
        rows = [keys[:2], keys[2:]]
        back = {"view": "commands"}
    elif view == "duration":
        text = ctx.t("acl.choose_duration") + "<br>" + _rule_text(ctx, {**data, "expires": 0}, False)
        base = {key: data[key] for key in ("kind", "target", "type", "rule")}
        keys = [button(ctx.t("acl.periods." + name), "rules", op="grant_rule", duration=value, **base) for name, value in (("hour", 3600), ("day", 86400), ("week", 604800), ("forever", 0))]
        rows = [keys[:2], keys[2:], [field(ctx.t("acl.custom"), "duration", "30m", **base)]]
        back = {"view": "catalog", "kind": data["kind"], "target": data["target"], "type": data["type"]}
    elif view == "confirm":
        op = data["op"]
        if op == "owner":
            text = ctx.t("acl.owner_confirm" if data["enabled"] else "acl.owner_remove_confirm", user_id=data["uid"])
            back = {"view": "user", "uid": data["uid"]}
        elif op == "delete_group":
            text = ctx.t("acl.group_delete_confirm", name=_escape(data["name"]))
            back = {"view": "group", "name": data["name"]}
        else:
            text = ctx.t("acl.clear_confirm", scope=_escape(data["target"]))
            back = {"view": "rules", "kind": data["kind"], "target": data["target"]}
        rows = [[k.danger(ctx.t("acl.confirm"), action, **{**data, "view": back["view"], "confirmed": True})]]
    rows.append(k.footer(action, **{**back, "chat": chat}) if view != "home" else k.footer())
    return k.screen(text, rows)

def _allowed(ctx: Any, nav: Any) -> bool:
    return bool(ctx.access_admin.is_owner(nav.actor))

def _error(ctx: Any, data: dict[str, Any], message: str) -> Any:
    view = {key: value for key, value in data.items() if key not in {"op", "confirmed", "input"}}
    if view.get("view") in {None, "confirm"}:
        view["view"] = "home"
    return _screen(ctx, view).with_notice(ctx.t("ui.error", error=message))

async def action(ctx: Any, nav: Any) -> Any:
    if not _allowed(ctx, nav):
        return ctx.t("acl.no_permission")
    data = dict(nav.args)
    op = data.pop("op", "")
    access = ctx.access_admin
    try:
        if data.get("view") == "confirm":
            data["op"] = op
        elif op == "role":
            uid, role = int(data["uid"]), ROLES[data["role"]]
            if role not in {Permission.ADMIN, Permission.TRUSTED} or access.is_owner(uid):
                raise AccessError("No permission.")
            if data["enabled"]:
                access.store.grant(uid, role)
            else:
                access.store.revoke(uid, role)
        elif op == "owner" and data.pop("confirmed", False):
            if data["enabled"]:
                access.add_owner(int(data["uid"]))
            else:
                access.remove_owner(int(data["uid"]))
        elif op == "member":
            group = access.sgroup(data["name"])
            if group is None:
                raise ValueError(ctx.t("acl.group_missing", name=_escape(data["name"])))
            uid = int(data["uid"])
            if data["enabled"] and uid not in group.users:
                group.users.append(uid)
            elif not data["enabled"] and uid in group.users:
                group.users.remove(uid)
            access.save_sgroups(access.sgroups())
        elif op == "delete_group" and data.pop("confirmed", False):
            access.delete_sgroup(data["name"])
            data = {"view": "groups", "chat": data.get("chat")}
        elif op == "clear_rules" and data.pop("confirmed", False):
            access.remove_tsec_all(data["kind"], data["target"])
        elif op == "delete_rule":
            access.remove_tsec(data["kind"], data["target"], data["rule"], data["type"])
        elif op == "grant_rule":
            _grant_rule(ctx, data["kind"], data["target"], data["type"], data["rule"], int(data["duration"]))
        elif op == "default":
            _default(ctx, data["name"], ROLES[data["role"]])
    except AccessError:
        return _error(ctx, data, ctx.t("acl.no_permission"))
    except ValueError as exc:
        return _error(ctx, data, str(exc))
    return _screen(ctx, data)

async def on_input(ctx: Any, nav: Any) -> Any:
    if not _allowed(ctx, nav):
        return None
    data = dict(nav.args)
    raw = str(nav.value or "").strip()
    op = data.pop("input", None)
    try:
        if op in {"user", "member"}:
            uid, rest = await _resolve_target_user(ctx, SimpleNamespace(args=tuple(raw.split())))
            if uid is None or rest:
                raise ValueError(ctx.t("acl.invalid_target"))
            if op == "member":
                group = ctx.access_admin.sgroup(data["name"])
                if group is None:
                    raise ValueError(ctx.t("acl.group_missing", name=_escape(data["name"])))
                if uid not in group.users:
                    group.users.append(uid)
                    ctx.access_admin.save_sgroups(ctx.access_admin.sgroups())
                data["view"] = "members"
            else:
                data.update(view="user", uid=uid)
        elif op == "group":
            if _target("sgroup", raw) is None:
                raise ValueError(ctx.t("acl.bad_group"))
            if ctx.access_admin.sgroup(raw) is not None:
                raise ValueError(ctx.t("acl.group_exists", name=_escape(raw)))
            ctx.access_admin.create_sgroup(raw)
            data.update(view="group", name=raw)
        elif op == "scope":
            args = raw.split()
            if len(args) != 2 or _target(args[0], args[1]) is None:
                raise ValueError(ctx.t("acl.scope_hint"))
            if args[0] == "sgroup" and ctx.access_admin.sgroup(args[1]) is None:
                raise ValueError(ctx.t("acl.group_missing", name=_escape(args[1])))
            data.update(view="types", kind=args[0], target=_target(args[0], args[1]))
        elif op == "duration":
            duration = _parse_duration(raw)
            if duration is None:
                raise ValueError(ctx.t("acl.bad_duration"))
            _grant_rule(ctx, data["kind"], data["target"], data["type"], data["rule"], duration)
            data["view"] = "rules"
        else:
            return None
    except ValueError as exc:
        return _error(ctx, {**data, "view": {"user": "users", "member": "members", "group": "groups", "scope": "rules", "duration": "duration"}.get(str(op), "home")}, str(exc))
    return _screen(ctx, data)
