HOTARU = {
    "id": "hotaru-kernel",
    "version": "0.1.5",
    "description": "Hotaru kernel module — system commands",
    "commands": [
        "ver", "st", "ls", "mi",
        "ld", "ul", "rl", "rm", "bk",
        "bot", "trust", "untrust", "conf",
        "alias", "unalias"
    ],
    "capabilities": [],
}


async def command_ver(ctx, invocation):
    from hotaru import __version__
    await ctx.respond(f"Hotaru {__version__}")


async def command_st(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("runtime unavailable")
        return
    status = runtime.status()
    flags = ", ".join(f"{key}={value}" for key, value in status.items())
    lines = [f"health: {runtime.health()}", flags]
    if runtime.supervisor is not None:
        state = runtime.supervisor.state
        lines.append(f"connection: {state.health.value} reconnects={state.reconnects} mt={state.mt_ready} bot={state.bot_ready}")
        if state.last_error:
            lines.append(f"last_error: {state.last_error}")
    if runtime.kernel is not None:
        lines.append(f"running_commands: {runtime.kernel.running()}")
    if runtime.inline is not None and runtime.inline.info is not None:
        running = runtime.inline._task is not None and not runtime.inline._task.done()
        lines.append(f"inline: @{runtime.inline.info.username} ({'running' if running else 'stopped'})")
    await ctx.respond("\n".join(lines))


async def command_ls(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None or runtime.modules is None:
        await ctx.respond("modules: unavailable")
        return
    items = runtime.modules.items()
    if not items:
        await ctx.respond("modules: none")
        return
    await ctx.respond("modules:\n" + "\n".join(sorted(item.loaded.manifest.module_id for item in items)))


async def command_mi(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("runtime unavailable")
        return
    if len(invocation.args) != 1:
        await ctx.respond("usage: !mi <module-id>")
        return
    await ctx.respond(runtime._module_detail_text(invocation.args[0].casefold()))





async def command_ld(ctx, invocation):
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("runtime unavailable")
        return
    result = await runtime._command_ld(invocation)
    if isinstance(result, tuple):
        text, buttons = result
        await ctx.respond(text, buttons=buttons)
    else:
        await ctx.respond(result)


