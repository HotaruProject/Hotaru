HOTARU = {
    "id": "backups",
    "version": "1.2.0",
    "commands": ["backup", "restore"],
    "capabilities": ["mt", "state", "files", "modules"],
    "banner": "https://raw.githubusercontent.com/HotaruProject/Hotaru/develop/hotaru/assets/backups.mp4",
    "tasks": {"send": {"interval": 60, "autostart": True}},
    "config_schema": {
        "enabled": {"type": "bool", "default": True},
        "interval_hours": {"type": "int", "default": 24, "minimum": 1, "maximum": 720},
    },
}

import asyncio
import html
import tempfile
import time
from pathlib import Path
from typing import Any, cast

_lock = asyncio.Lock()
TOPIC_EMOJI_ID = 5258514780469075716


def home(ctx: Any, nav: Any = None) -> Any:
    k = ctx.screens
    enabled = ctx.config.get("enabled", True)
    hours = ctx.config.get("interval_hours", 24)
    last = ctx.state.get("last_sent", 0)
    scope = ctx.state.get("scope", "all")
    custom_key = ctx.state.get("custom_key", "")
    status = ctx.t("kernel.backups.enabled" if enabled else "kernel.backups.disabled")
    text = ctx.t("kernel.backups.heading", icon='<tg-emoji emoji-id="5257969839313526622">📁</tg-emoji>', status=status, hours=hours)
    if last:
        text += "\n" + ctx.t("kernel.backups.last_sent", date=time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(last)))
    text += "\n" + ctx.t("kernel.backups.destination", topic=html.escape(ctx.t("kernel.backups.topic")))
    scope_name = ctx.t(f"kernel.backups.scope_{scope}")
    text += "\n" + ctx.t("kernel.backups.current_scope", scope=scope_name)
    key_desc = ctx.t("kernel.backups.key_custom") if custom_key else ctx.t("kernel.backups.key_default")
    text += "\n" + ctx.t("kernel.backups.key_info", status=key_desc)
    text += "\n" + ctx.t("kernel.backups.encrypted")
    buttons = [
        [k.button(ctx.t("kernel.backups.send_now"), send_now)],
        [k.button(ctx.t("kernel.backups.scope_btn", scope=scope_name), cycle_scope)],
        [k.input(ctx.t("kernel.backups.custom_key_btn"), set_custom_key, placeholder=ctx.t("kernel.backups.custom_key_hint"))],
    ]
    if custom_key:
        buttons.append([k.button(ctx.t("kernel.backups.reset_key_btn"), reset_custom_key)])
    buttons.append([k.button(ctx.t("kernel.backups.disable" if enabled else "kernel.backups.enable"), toggle)])
    buttons.append(k.footer())
    return k.screen(text, buttons, banner=k.banner("backups"))


def toggle(ctx: Any, nav: Any) -> Any:
    ctx.config.set("enabled", not ctx.config.get("enabled", True))
    return home(ctx)


def cycle_scope(ctx: Any, nav: Any) -> Any:
    curr = ctx.state.get("scope", "all")
    nxt = {"all": "modules", "modules": "state", "state": "all"}.get(curr, "all")
    ctx.state.set("scope", nxt)
    return home(ctx)


def set_custom_key(ctx: Any, nav: Any) -> Any:
    val = str(getattr(nav, "text", "") or "").strip()
    if val:
        ctx.state.set("custom_key", val)
    return home(ctx)


def reset_custom_key(ctx: Any, nav: Any) -> Any:
    ctx.state.delete("custom_key")
    return home(ctx)


async def _send(ctx: Any, *, automatic: bool = False) -> bool:
    async with _lock:
        now = time.time()
        if automatic:
            if not ctx.config.get("enabled", True):
                return False
            if now - ctx.state.get("last_sent", 0) < ctx.config.get("interval_hours", 24) * 3600:
                return False
            scope = "all"
            custom_key = None
        else:
            scope = ctx.state.get("scope", "all")
            custom_key = ctx.state.get("custom_key", "") or None
        topic = await ctx.forum.ensure_topic(ctx.t("kernel.backups.topic"), icon_emoji_id=TOPIC_EMOJI_ID)
        if topic is None:
            raise RuntimeError(ctx.t("kernel.backups.not_ready"))
        archive = ctx.runtime.create_backup(scope=scope, custom_key=custom_key)
        if custom_key:
            caption = ctx.t("kernel.backups.caption_custom_key", name=archive.name)
            ctx.state.delete("custom_key")
        else:
            caption = ctx.t("kernel.backups.caption", name=archive.name)
        await ctx.forum.send_file(topic, str(archive), caption, file_name=archive.name)
        ctx.state.set("last_sent", time.time())
        return True


async def send_now(ctx: Any, nav: Any) -> Any:
    try:
        await _send(ctx)
    except Exception as exc:
        return home(ctx).with_notice(ctx.t("kernel.backups.failed", error=html.escape(str(exc))))
    return home(ctx).with_notice(ctx.t("kernel.backups.sent"))


async def task_send(ctx: Any) -> None:
    ready = getattr(ctx.runtime, "_forum_ready", None)
    if ready is None or not ready.is_set():
        return
    await _send(ctx, automatic=True)


async def _perform_restore(ctx: Any, target: str | None, reply_id: int | None, inv_obj: Any = None, *, only: str = "all", key: str | bytes | None = None) -> None:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.kernel.runtime_unavailable'))
        return
    temporary = None
    log_lines = ["-----> Locating backup archive..."]
    await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML", output="edit")
    try:
        archive_path = None
        if target:
            target_str = str(target).strip()
            if target_str.startswith("https://") or target_str.startswith("http://"):
                from hotaru.modules import fetch_url_content, ModuleStager
                url = ModuleStager.normalize_url(target_str)
                with tempfile.NamedTemporaryFile(suffix=".hbk", delete=False) as handle:
                    temporary = Path(handle.name)
                temporary.write_bytes(fetch_url_content(url, timeout=30.0))
                archive_path = temporary
            else:
                p = Path(target_str)
                if not p.is_file():
                    await ctx.respond(f"<pre> !     Error: backup archive not found: {html.escape(target_str)}</pre>", parse_mode="HTML", output="edit")
                    return
                archive_path = p
        else:
            msg_raw: Any = getattr(inv_obj, "message", None) if inv_obj is not None else None
            d_msg: dict[str, Any] | None = cast('dict[str, Any]', msg_raw) if isinstance(msg_raw, dict) else None
            raw_obj: Any = cast(Any, msg_raw)
            doc_msg: Any = getattr(inv_obj, "reply_message", None) if inv_obj is not None else None
            if doc_msg is None and raw_obj is not None:
                if d_msg is not None:
                    doc_msg = d_msg.get("reply_to_message")
                else:
                    doc_msg = getattr(raw_obj, "reply_to_message", None)
            if callable(cast(object, doc_msg)):
                doc_msg = None
            if doc_msg is None:
                from hotaru.response import reply_message_id
                target_reply_id = reply_id or (reply_message_id(raw_obj) if raw_obj is not None else None)
                if target_reply_id:
                    chat_id: Any = getattr(ctx, "chat_id", None) or (d_msg.get("chat_id") if d_msg is not None else (getattr(inv_obj, "chat_id", None) if inv_obj is not None else None))
                    app: Any = getattr(runtime, "app", None)
                    if app is not None and hasattr(app, "get_msg") and chat_id is not None:
                        from relay.firewall import trusted_scope
                        with trusted_scope():
                            try:
                                doc_msg = await app.get_msg(chat_id, target_reply_id)
                            except Exception:
                                doc_msg = None
                    if doc_msg is None:
                        cap_host: Any = getattr(runtime, "cap_host", None)
                        if cap_host is not None:
                            from relay.firewall import trusted_scope
                            with trusted_scope():
                                try:
                                    doc_msg = await cap_host.call("loader", "fetch", {"op": "message", "peer": chat_id, "id": target_reply_id})
                                except Exception:
                                    doc_msg = None
            if doc_msg is None and raw_obj is not None:
                if d_msg is not None:
                    if d_msg.get("media") or d_msg.get("document"):
                        doc_msg = cast(Any, d_msg)
                elif getattr(raw_obj, "media", None) or getattr(raw_obj, "document", None):
                    doc_msg = raw_obj
            if doc_msg is not None:
                with tempfile.NamedTemporaryFile(suffix=".hbk", delete=False) as handle:
                    temporary = Path(handle.name)
                try:
                    await runtime._download_module_message(doc_msg, temporary)
                    archive_path = temporary
                except Exception:
                    temporary.unlink(missing_ok=True)
                    temporary = None
            if archive_path is None:
                directory = runtime.config.state_path.parent / "backups"
                if directory.is_dir():
                    candidates = sorted([p for p in directory.glob("*.hbk") if p.is_file()], key=lambda p: p.stat().st_mtime, reverse=True)
                    if candidates:
                        archive_path = candidates[0]
            if archive_path is None:
                await ctx.respond(f"<pre> !     Error: reply to an .hbk file or provide an archive path/url</pre>", parse_mode="HTML", output="edit")
                return

        log_lines[-1] += " done"
        scope_str = only.upper()
        log_lines.append(f"-----> Restore scope: {scope_str}")
        if key:
            log_lines.append("-----> Decrypting HBK container with custom encryption key...")
        else:
            log_lines.append("-----> Decrypting HBK container with sanctuary vault key...")
        await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML", output="edit")

        plan = runtime.backups.plan(archive_path, key=key)

        log_lines[-1] += " done"
        log_lines.append(f"-----> Verifying manifest integrity ({len(plan.files)} entries)...")
        await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML", output="edit")

        log_lines[-1] += " done"
        log_lines.append(f"-----> Restoring {scope_str.lower()}...")
        await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML", output="edit")

        modules_dir = runtime.relay_dir
        await runtime.restore_filesystem(plan, modules_dir, only=only, key=key)

        log_lines[-1] += " done"
        log_lines.append("-----> Unpacking and activating modules...")
        log_lines.append("-----> Done! System restored successfully.")
        await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML", output="edit")

        notice = f'<tg-emoji emoji-id="5260726538302660868">✅</tg-emoji> <b>{ctx.t("runtime.restore_done")}</b><blockquote><tg-emoji emoji-id="5258514780469075716">📂</tg-emoji> <b>{ctx.t("kernel.backups.restored_files", count=len(plan.files))}</b></blockquote>'
        await ctx.respond(notice, parse_mode="HTML", output="edit")
    except Exception as exc:
        from hotaru.plainfmt import to_plain_text
        log_lines.append(f" !     {type(exc).__name__}: {html.escape(to_plain_text(str(exc)), quote=False)}")
        await ctx.respond(f"<pre>{chr(10).join(log_lines)}</pre>", parse_mode="HTML", output="edit")
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def _render_restore_screen(ctx: Any, target: str | None, reply_id: int | None, scope: str = "all", key: str | None = None) -> Any:
    k = ctx.screens
    btn_args: dict[str, Any] = {"scope": scope}
    if target:
        btn_args["target"] = target
    if reply_id:
        btn_args["reply_id"] = reply_id
    if key:
        btn_args["key"] = key
    scope_name = ctx.t(f"kernel.backups.scope_{scope}")
    text = ctx.t('kernel.backups.restore_confirm')
    text += "\n" + ctx.t('kernel.backups.restore_scope', scope=scope_name)
    key_status = key if key else ctx.t('kernel.backups.key_default')
    text += "\n" + ctx.t('kernel.backups.restore_custom_key', key=key_status)
    key_btn_text = ctx.t('kernel.backups.restore_key_btn', key=key if key else ctx.t('kernel.backups.key_default'))
    return k.screen(
        text,
        [
            [k.primary(ctx.t('kernel.backups.restore_action'), confirm_restore, **btn_args)],
            [k.button(ctx.t('kernel.backups.scope_btn', scope=scope_name), cycle_restore_scope, **btn_args)],
            [k.input(key_btn_text, set_restore_key, placeholder=ctx.t('kernel.backups.custom_key_hint'), **btn_args)],
            [k.close()],
        ],
        rich=True,
    )


async def cycle_restore_scope(ctx: Any, nav: Any) -> Any:
    curr = nav.arg("scope") or "all"
    nxt = {"all": "modules", "modules": "state", "state": "all"}.get(curr, "all")
    target = nav.arg("target")
    reply_id = nav.arg("reply_id")
    key = nav.arg("key")
    return _render_restore_screen(ctx, target, reply_id, scope=nxt, key=key)


async def set_restore_key(ctx: Any, nav: Any) -> Any:
    val = str(getattr(nav, "text", "") or "").strip()
    target = nav.arg("target")
    reply_id = nav.arg("reply_id")
    scope = nav.arg("scope") or "all"
    return _render_restore_screen(ctx, target, reply_id, scope=scope, key=val or None)


async def confirm_restore(ctx: Any, nav: Any) -> Any:
    target = nav.arg("target")
    reply_id = nav.arg("reply_id")
    scope = nav.arg("scope") or "all"
    key = nav.arg("key")
    await nav.answer()
    await _perform_restore(ctx, target, reply_id, None, only=scope, key=key)
    return None


async def command_restore(ctx: Any, invocation: Any) -> None:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.kernel.runtime_unavailable'))
        return
    raw_args = [str(a) for a in getattr(invocation, "args", []) if str(a) != "restore"]
    flags = {"-f", "--force", "force", "f"}
    is_forced = any(a.casefold() in flags for a in raw_args)
    clean_args = [a for a in raw_args if a.casefold() not in flags]
    scope = "all"
    custom_key: str | None = None
    target: str | None = None
    scope_keywords = {"all": "all", "full": "all", "modules": "modules", "module": "modules", "mods": "modules", "mod": "modules", "state": "state", "db": "state", "database": "state"}
    idx = 0
    while idx < len(clean_args):
        item = clean_args[idx]
        item_cf = item.casefold()
        if item_cf.startswith("--key="):
            custom_key = item.split("=", 1)[1]
        elif item_cf.startswith("-k="):
            custom_key = item.split("=", 1)[1]
        elif item_cf in ("--key", "-k") and idx + 1 < len(clean_args):
            idx += 1
            custom_key = clean_args[idx]
        elif item_cf in scope_keywords and target is not None:
            scope = scope_keywords[item_cf]
        elif item_cf in scope_keywords and idx == 0 and len(clean_args) > 1 and not clean_args[1].casefold().startswith("-"):
            scope = scope_keywords[item_cf]
        elif item_cf in scope_keywords and len(clean_args) == 1:
            scope = scope_keywords[item_cf]
        elif not item.startswith("-"):
            target = item.strip()
        idx += 1
    from hotaru.response import reply_message_id
    raw_msg = getattr(invocation, "message", None)
    reply_id = reply_message_id(raw_msg) if raw_msg is not None else None
    if is_forced:
        await _perform_restore(ctx, target, reply_id, invocation, only=scope, key=custom_key)
        return
    screen = _render_restore_screen(ctx, target, reply_id, scope=scope, key=custom_key)
    await ctx.screens.show(screen)


async def command_backup(ctx: Any, invocation: Any) -> None:
    args = list(invocation.args)
    if args and args[0] == "restore":
        await command_restore(ctx, invocation)
        return
    if args and args[0] == "now":
        if len(args) > 1 and args[1].casefold() in ("modules", "module", "mods", "mod", "state", "db", "database", "all", "full"):
            scope_map = {"modules": "modules", "module": "modules", "mods": "modules", "mod": "modules", "state": "state", "db": "state", "database": "state"}
            ctx.state.set("scope", scope_map.get(args[1].casefold(), "all"))
        screen = await send_now(ctx, None)
    elif args in (["on"], ["off"]):
        ctx.config.set("enabled", args[0] == "on")
        screen = home(ctx)
    elif args and args[0].casefold() in ("modules", "module", "mods", "mod", "state", "db", "database", "all", "full"):
        scope_map = {"modules": "modules", "module": "modules", "mods": "modules", "mod": "modules", "state": "state", "db": "state", "database": "state"}
        ctx.state.set("scope", scope_map.get(args[0].casefold(), "all"))
        screen = home(ctx)
    elif not args:
        screen = home(ctx)
    else:
        await ctx.respond(ctx.t("kernel.backups.usage", prefix=html.escape(ctx.runtime.config.prefix)), parse_mode="HTML")
        return
    await ctx.screens.show(screen)
