HOTARU = {
    "id": "accounts",
    "version": "2.1.0",
    "commands": ["acc", "acca", "accs"],
    "capabilities": ["mt"],
}

from typing import Any, List


import html as _html

def _escape(value: Any) -> Any:
    return _html.escape(str(value), quote=False)

def _usage(ctx: Any) -> Any:
    return ctx.t(
        "accounts.usage",
        "usage: !acc <#> <start|stop|on|off|del>\n!acca [user_id] — зарегистрировать аккаунт (номер выдаётся автоматически, можно реплаем)\n!accs — список",
    )

async def _reply_sender_id(ctx: Any) -> Any:
    reply = None
    fetch = getattr(ctx, "reply", None)
    if callable(fetch):
        try:
            reply = await fetch()
        except Exception:
            reply = None
    if reply is None or not hasattr(reply, "get"):
        return None
    from_peer = reply.get("from_id")
    if isinstance(from_peer, dict):
        uid = from_peer.get("user_id")
        if isinstance(uid, int):
            return uid
    if isinstance(from_peer, int):
        return from_peer
    return None

async def _resolve_acca_target(ctx: Any, invocation: Any) -> Any:
    for token in invocation.args:
        if token.lstrip("-").isdigit():
            return int(token)
    sender = await _reply_sender_id(ctx)
    if sender is not None:
        return sender
    return None

async def command_accs(ctx: Any, invocation: Any) -> Any:
    items = ctx.accounts.items()
    self_name = None
    session = getattr(ctx.runtime.app, "session", None) if ctx.runtime is not None else None
    if session is not None:
        self_name = getattr(session, "name", None)
        if self_name is not None:
            self_name = str(self_name).rsplit("/", 1)[-1]
    primary_id = getattr(ctx.runtime.kernel, "owner_id", None) if ctx.runtime is not None else None
    if not items:
        await ctx.respond(ctx.t("accounts.empty", "Аккаунты не зарегистрированы."), parse_mode="HTML")
        return
    rows: List[str] = []
    for profile in items:
        vault_ok = ctx.accounts.vault_ready(profile.account_number)
        vault_state = "✓" if vault_ok else "✗"
        state = "on" if profile.enabled else "off"
        marker = " · this session" if self_name is not None and profile.session_name == self_name else ""
        primary = " · primary" if profile.user_id == primary_id else ""
        rows.append(
            f"<b>#{profile.account_number}</b> <code>{_escape(profile.session_name)}</code> "
            f"user <code>{profile.user_id}</code> vault {vault_state} {state}{marker}{primary}"
        )
    await ctx.respond("<b>Accounts</b><br>" + "<br>".join(rows), parse_mode="HTML")

async def command_acca(ctx: Any, invocation: Any) -> Any:
    if len(invocation.args) > 1 or (invocation.args and not invocation.args[0].lstrip("-").isdigit()):
        await ctx.respond(_usage(ctx), parse_mode="HTML")
        return
    target_id = await _resolve_acca_target(ctx, invocation)
    if target_id is None:
        target_id = getattr(ctx.runtime, "session_self_id", None)
        if target_id is None:
            session = getattr(ctx.runtime.app, "session", None) if ctx.runtime is not None else None
            target_id = getattr(session, "self_id", None) if session is not None else None
    user_id = target_id
    if user_id is None or user_id <= 0:
        await ctx.respond(ctx.t("accounts.no_self", "Не удалось определить user id сессии."), parse_mode="HTML")
        return
    for profile in ctx.accounts.items():
        if profile.user_id == user_id or profile.session_name in (f"user-{user_id}", f"hotaru-{user_id}"):
            await ctx.respond(
                f"<b>Account #{profile.account_number} already registered</b><br>"
                f"session: <code>{_escape(profile.session_name)}</code> user <code>{profile.user_id}</code>",
                parse_mode="HTML",
            )
            return
    number = ctx.accounts.next_free_number()
    try:
        profile = ctx.accounts.register(user_id, number)
    except Exception as exc:
        await ctx.respond(f"<b>Register failed:</b> <i>{_escape(exc)}</i>", parse_mode="HTML")
        return
    await ctx.respond(
        f"<b>Account #{number} registered</b><br>"
        f"session: <code>{_escape(profile.session_name)}</code><br>"
        f"vault: <code>{_escape(profile.vault_name)}</code><br>"
        f"{'Запуск: <code>!acc ' + str(number) + ' start</code>' if ctx.accounts.vault_ready(number) else 'Vault missing — authorize this session first, then <code>!acc ' + str(number) + ' start</code>'}",
        parse_mode="HTML",
    )

async def command_acc(ctx: Any, invocation: Any) -> Any:
    if len(invocation.args) < 2 or not invocation.args[0].isdigit():
        await ctx.respond(_usage(ctx), parse_mode="HTML")
        return
    number = int(invocation.args[0])
    action = invocation.args[1].casefold()

    if ctx.accounts.profile(number) is None:
        await ctx.respond(ctx.t("accounts.not_registered", f"Аккаунт #{number} не зарегистрирован."), parse_mode="HTML")
        return

    if action == "start":
        try:
            pid = ctx.accounts.spawn(number)
        except Exception as exc:
            await ctx.respond(f"<b>Start failed:</b> <i>{_escape(exc)}</i>", parse_mode="HTML")
            return
        await ctx.respond(f"<b>Account #{number} started</b> (pid {pid})", parse_mode="HTML")
        return

    if action == "stop":
        ok = ctx.accounts.stop(number)
        await ctx.respond(
            f"<b>Account #{number} stopped</b>" if ok else f"Account #{number} not running",
            parse_mode="HTML",
        )
        return

    if action in ("on", "off"):
        enabled = action == "on"
        ok = ctx.accounts.set_enabled(number, enabled)
        await ctx.respond(
            f"<b>Account #{number} {'enabled' if enabled else 'disabled'}</b>" if ok else "failed",
            parse_mode="HTML",
        )
        return

    if action == "del":
        try:
            ctx.accounts.stop(number)
        except Exception:
            pass
        ok = ctx.accounts.unregister(number)
        await ctx.respond(
            f"<b>Account #{number} removed</b>" if ok else f"Account #{number} not registered",
            parse_mode="HTML",
        )
        return

    await ctx.respond(_usage(ctx), parse_mode="HTML")
