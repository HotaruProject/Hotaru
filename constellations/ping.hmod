HOTARU = {
    "id": "ping",
    "version": "1.3.0",
    "commands": ["ping"],
    "capabilities": [],
}

import time


async def command_ping(ctx, invocation):
    start = time.perf_counter_ns()
    await ctx.respond("...")
    ping_ms = (time.perf_counter_ns() - start) / 10**6
    uptime_s = time.monotonic()
    h, rem = divmod(int(uptime_s), 3600)
    m, s = divmod(rem, 60)
    text = (
        f"<b>Пинг</b> <code>{ping_ms:.3f} ms</code>\n"
        f"<b>Аптайм</b> <code>{h}h {m:02d}m {s:02d}s</code>"
    )
    await ctx.respond(text, parse_mode="HTML", output="edit")
