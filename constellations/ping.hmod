HOTARU = {
    "id": "ping",
    "version": "1.3.0",
    "commands": ["ping"],
    "capabilities": [],
    "config_schema": {
        "template": {
            "type": "str",
            "default": "",
            "max_len": 3000,
            "description": "HTML ping template: {latency} in ms, {uptime}. Empty = localized default; other braces are literal.",
            "category": "General",
        },
    },
}

import time
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from hotaru.commands import CommandInvocation
    from hotaru.response import ModuleContext


async def command_ping(ctx: "ModuleContext", invocation: "CommandInvocation") -> None:
    start = time.perf_counter_ns()
    await ctx.respond("...")
    ping_ms = (time.perf_counter_ns() - start) / 10**6
    uptime_s = max(0, int(time.monotonic() - ctx.runtime.started_at))
    uptime = ctx.tools.duration(uptime_s, ctx.i18n.language)
    template = ctx.config.get("template").strip() or ctx.t(
        "kernel.ping.template", "<b>Ping</b> <code>{latency} ms</code>\n<b>Uptime</b> <code>{uptime}</code>",
        latency="{latency}", uptime="{uptime}",
    )
    text = ctx.tools.render(template, latency=f"{ping_ms:.3f}", uptime=ctx.escape(uptime))
    await ctx.respond(text, parse_mode="HTML", output="edit")
