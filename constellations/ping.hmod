HOTARU = {
    "id": "ping",
    "version": "1.3.0",
    "commands": ["ping"],
    "capabilities": [],
}

import time
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from hotaru.commands import CommandInvocation
    from hotaru.response import ModuleContext


async def command_ping(ctx: "ModuleContext", invocation: "CommandInvocation") -> None:
    start = time.perf_counter_ns()
    await ctx.respond("...")
    ping_ms = (time.perf_counter_ns() - start) / 10**6
    uptime_s = max(0, int(time.monotonic() - ctx.runtime.started_at))
    days, rem = divmod(uptime_s, 86400)
    h, rem = divmod(rem, 3600)
    m, s = divmod(rem, 60)
    uptime = " ".join(f"{value} {unit}" for value, unit in ((days, "д"), (h, "ч"), (m, "мин"), (s, "с")) if value) or "0 с"
    text = (
        f"<b>Пинг</b> <code>{ping_ms:.3f} мс</code>\n"
        f"<b>Аптайм</b> <code>{uptime}</code>"
    )
    await ctx.respond(text, parse_mode="HTML", output="edit")
