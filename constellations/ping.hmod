HOTARU = {
    "id": "ping",
    "version": "1.0.0",
    "description": "Ping/pong with latency measurement",
    "commands": ["ping"],
    "capabilities": [],
}

import time


async def command_ping(ctx, invocation):
    start = time.perf_counter()
    await ctx.respond("ping")
    elapsed = (time.perf_counter() - start) * 1000
    await ctx.respond(f"pong: {elapsed:.1f} ms")
