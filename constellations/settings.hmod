HOTARU = {
    "id": "settings",
    "version": "1.0.0",
    "commands": ["alias", "rmalias", "prefix"],
    "capabilities": ["mt"],
}

from typing import Any
from dataclasses import replace


async def command_alias(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('settings.runtime_unavailable'))
        return
    if len(invocation.args) != 2:
        await ctx.respond(ctx.t('settings.usage_alias', prefix=runtime.config.prefix))
        return
    alias, command = invocation.args
    alias = alias.casefold()
    command = command.casefold().lstrip("/")
    if not 1 <= len(alias) <= 32 or not alias.isidentifier():
        await ctx.respond(ctx.t('settings.alias_invalid'))
        return
    if runtime.kernel.registry.resolve_name(alias) is None and command not in runtime.kernel.registry.names():
        pass
    if runtime.kernel.registry.resolve_name(alias) is not None:
        await ctx.respond(ctx.t('settings.alias_exists', alias=alias))
        return
    target = runtime.kernel.registry.resolve_name(command)
    if target is None:
        known = ", ".join(sorted(runtime.kernel.registry.names()))[:800]
        await ctx.respond(ctx.t('settings.command_not_found', command=command, known=known))
        return
    aliases = runtime.state.get_setting("user_aliases", {})
    if alias in aliases:
        await ctx.respond(ctx.t('settings.alias_taken', alias=alias, command=aliases[alias], prefix=runtime.config.prefix))
        return
    aliases[alias] = command
    runtime.state.set_setting("user_aliases", aliases)
    runtime.kernel.registry.register_alias(alias, command)
    await ctx.respond(ctx.t('settings.alias_set', alias=alias, command=command))


async def command_rmalias(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('settings.runtime_unavailable'))
        return
    if len(invocation.args) != 1:
        await ctx.respond(ctx.t('settings.usage_rmalias', prefix=runtime.config.prefix))
        return
    alias = invocation.args[0].casefold()
    aliases = runtime.state.get_setting("user_aliases", {})
    if alias in aliases:
        del aliases[alias]
        runtime.state.set_setting("user_aliases", aliases)
        runtime.kernel.registry.unregister_alias(alias)
        await ctx.respond(ctx.t('settings.alias_removed', alias=alias))
    else:
        await ctx.respond(ctx.t('settings.alias_not_found', alias=alias))


async def command_prefix(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('settings.runtime_unavailable'))
        return
    if len(invocation.args) != 1:
        current = runtime.kernel.parser.prefix
        await ctx.respond(ctx.t('settings.prefix_current', prefix=current))
        return
    new_prefix = invocation.args[0]
    from hotaru.commands import valid_prefix
    if len(invocation.args) != 1 or not valid_prefix(new_prefix):
        await ctx.respond(ctx.t('settings.prefix_invalid'))
        return
    runtime.state.set_setting("prefix", new_prefix)
    runtime.kernel.parser.prefix = new_prefix
    runtime.config = replace(runtime.config, prefix=new_prefix)
    await ctx.respond(ctx.t('settings.prefix_set', prefix=new_prefix))
