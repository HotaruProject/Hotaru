HOTARU = {
    "id": "help",
    "version": "2.0.0",
    "commands": ["help"],
    "capabilities": ["mt"],
}

import re
from typing import Any, Callable, List, Tuple

_page_size = 70
_open_limit = 8


def _escape(value: Any) -> str:
    import html
    return html.escape(str(value), quote=False)


def _banner(manifest: Any) -> str:
    import html
    value = str(getattr(manifest, "banner", "") or "").strip()
    if not value:
        return ""
    if re.fullmatch(r"https?://[^\s<>\"]+", value):
        tag = "video" if value.lower().endswith(".mp4") else "img"
        return f'<{tag} src="{html.escape(value, quote=True)}"/>'
    return value


def _description(runtime: Any, manifest: Any) -> str:
    return str(manifest.localized(runtime.language(), manifest.description).get("description", "") or "")


def _is_kernel(runtime: Any, module_id: str) -> bool:
    bindings = getattr(runtime.modules, "_bindings", {})
    return module_id in bindings and bool(bindings[module_id][2])


def _aliases(runtime: Any, command: str) -> List[str]:
    prefix = runtime.config.prefix
    registry = getattr(getattr(runtime, "kernel", None), "registry", None)
    found: List[str] = []
    for alias, target in sorted(registry.alias_map().items() if registry is not None else ()):
        words = str(target).split()
        if not words or words[0].casefold() != command.casefold() or alias.casefold() == command.casefold():
            continue
        shown = prefix + alias + (" " + " ".join(words[1:]) if len(words) > 1 else "")
        found.append(_escape(shown))
    return found


def _catalog(runtime: Any) -> List[Tuple[str, Any, bool]]:
    items = [(item.loaded.manifest.module_id, item.loaded.manifest) for item in runtime.modules.items()]
    rows = [(module_id, manifest, _is_kernel(runtime, module_id)) for module_id, manifest in items]
    return sorted(rows, key=lambda row: (not row[2], row[0].casefold()))


def _entry(ctx: Any, module_id: str, manifest: Any, fn: Any, **args: Any) -> str:
    k = ctx.screens
    description = _description(ctx.runtime, manifest)
    line = k.tap(module_id, fn, id=module_id, **args)
    return line + (f"  <i>{_escape(ctx.tools.truncate(description, 48))}</i>" if description else "")


def home(ctx: Any, nav: Any = None) -> Any:
    k = ctx.screens
    runtime = ctx.runtime
    catalog = _catalog(runtime)
    items, page, pages = k.page(catalog, nav.int("page") if nav is not None else 0, _page_size)
    kernel_count = sum(1 for row in catalog if row[2])
    lines = [k.banner("help"),
        k.wordmark() + "  " + k.badge(ctx.t("kernel.help_ui.count", count=len(catalog)), "primary")
        + " " + k.badge(ctx.t("kernel.help_ui.prefix", prefix=runtime.config.prefix)),
    ]
    user_count = len(catalog) - kernel_count
    for kernel in (True, False):
        entries = [_entry(ctx, module_id, manifest, module, page=page) for module_id, manifest, is_kernel in items if is_kernel == kernel]
        if not entries:
            continue
        title = ctx.t("kernel.help_ui.kernel_modules" if kernel else "kernel.help_ui.user_modules")
        summary = f"<b>{_escape(title)}</b> · {kernel_count if kernel else user_count}"
        lines.append(k.details(summary, "\n".join(entries), open=not kernel or user_count == 0))
    rows = [k.pager(home, page, pages)]
    rows.append([k.input(ctx.t("ui.search"), search, ctx.t("kernel.help_ui.search_prompt")), k.close()])
    return k.screen("".join(lines), rows)


def _card(ctx: Any, module_id: str, actor: Any, back: Any, **back_args: Any) -> Any:
    k = ctx.screens
    runtime = ctx.runtime
    active = runtime.modules.get(module_id)
    if active is None:
        return home(ctx).with_notice(ctx.t("ui.error", error=ctx.t("kernel.help_ui.missing", module=_escape(module_id))))
    manifest = active.loaded.manifest
    prefix = runtime.config.prefix
    kernel = _is_kernel(runtime, module_id)
    badge = ctx.t("kernel.help_ui.kernel_badge" if kernel else "kernel.help_ui.user_badge")
    lines = [
        f"<b>{_escape(module_id)}</b>  "
        + k.badge(f"v{manifest.version}") + " " + k.badge(badge, "primary" if kernel else "success"),
    ]
    description = _description(runtime, manifest)
    if description:
        lines.append(f"<i>{_escape(description)}</i>")
    commands: List[str] = []
    for command in manifest.commands:
        details = manifest.command_details(command, runtime.language())
        usage = str(details.get("usage", "") or "").strip()
        if usage:
            if usage.startswith(prefix):
                shown = usage
            elif usage.startswith(command):
                shown = f"{prefix}{usage}"
            else:
                shown = f"{prefix}{command} {usage}"
        else:
            shown = f"{prefix}{command}"
        line = f"<code>{_escape(shown)}</code> " + k.tap_copy("", f"{prefix}{command}")
        desc = details.get("description", "")
        if desc:
            line += f" — <i>{_escape(desc)}</i>"
        aliases = _aliases(runtime, command)
        if aliases:
            line += "\n   " + _escape(ctx.t("kernel.help_ui.aliases")) + ": " + " · ".join(f"<code>{alias}</code>" for alias in aliases)
        commands.append(line)
    title = f"{k.icon('text')} <b>{_escape(ctx.t('kernel.help_ui.commands'))}</b> · {len(commands)}"
    body = "\n".join(commands) or f"<i>{_escape(ctx.t('kernel.help_ui.no_commands'))}</i>"
    if len(commands) > _open_limit:
        lines[-1] += k.details(title, body)
    else:
        lines.append(f"{title}\n{body}")
    if manifest.capabilities:
        capabilities = "\n".join(f"• {_escape(ctx.t(f'kernel.capabilities.{item}', item))}" for item in manifest.capabilities)
        lines[-1] += k.details(f"{k.icon('lock')} <b>{_escape(ctx.t('kernel.help_ui.capabilities'))}</b> · {len(manifest.capabilities)}", capabilities)
    rows: List[List[Any]] = []
    if getattr(manifest, "config_schema", None) and runtime.modules.get("settings") is not None and runtime.access.is_owner(actor):
        rows.append([k.link(ctx.t("kernel.help_ui.settings"), "settings", "module", style="primary", id=module_id, origin="help")])
    rows.append(k.footer(back, **back_args))
    return k.screen("\n".join(lines), rows, banner=_banner(manifest))


def module(ctx: Any, nav: Any) -> Any:
    return _card(ctx, str(nav.arg("id")), nav.actor, home, page=nav.int("page"))


def _matches(ctx: Any, query: str) -> Any:
    key: Callable[[Tuple[str, Any, bool]], List[object]] = lambda row: [row[0], _description(ctx.runtime, row[1]), *row[1].commands]
    return ctx.tools.search(_catalog(ctx.runtime), query, key=key, limit=12)


async def search(ctx: Any, nav: Any) -> Any:
    query = str(nav.value or nav.arg("q") or "").strip()
    k = ctx.screens
    hits: List[Any] = await _matches(ctx, query) if query else []
    if len(hits) == 1:
        return _card(ctx, hits[0]["value"][0], nav.actor, search, q=query)
    if not hits:
        return home(ctx).with_notice(f"{k.icon('search')} " + ctx.t("ui.nothing_found", query=_escape(query)))
    lines = [f"{k.icon('search')} <b>{_escape(ctx.t('kernel.help_ui.results', query=query))}</b>  " + k.badge(str(len(hits)))]
    lines += [_entry(ctx, hit["value"][0], hit["value"][1], found, q=query) for hit in hits]
    rows = [[k.input(ctx.t("ui.search"), search, ctx.t("kernel.help_ui.search_prompt"))], k.footer(home)]
    return k.screen("\n".join(lines), rows)


def found(ctx: Any, nav: Any) -> Any:
    return _card(ctx, str(nav.arg("id")), nav.actor, search, q=nav.arg("q"))


async def _show_help(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.help_ui.unavailable'), parse_mode="HTML")
        return
    if runtime.modules is None:
        await ctx.respond(ctx.t('kernel.help_ui.manager_unavailable'), parse_mode="HTML")
        return
    if not invocation.args:
        await ctx.screens.show(home(ctx))
        return
    query = " ".join(invocation.args).casefold()
    actor = getattr(invocation.message, "from_id", None)
    if runtime.modules.get(query) is not None:
        await ctx.screens.show(_card(ctx, query, actor, home))
        return
    hits = await _matches(ctx, query)
    if hits:
        await ctx.screens.show(_card(ctx, hits[0]["value"][0], actor, home))
        return
    if runtime.state is not None and query in runtime.state.module_ids():
        last_error = runtime.state.namespace(query).get("lasterror", ctx.t("common.none"))
        await ctx.respond(ctx.t('kernel.help_ui.disabled', module=_escape(query), error=_escape(last_error)), parse_mode="HTML")
        return
    await ctx.respond(ctx.t('kernel.help_ui.missing', module=_escape(query)), parse_mode="HTML")


async def command_help(ctx: Any, invocation: Any) -> Any:
    await _show_help(ctx, invocation)
