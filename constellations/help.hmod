HOTARU = {
    "id": "help",
    "version": "1.1.0",
    "commands": ["hlp", "help"],
    "capabilities": ["mt"],
}

from typing import Any, List, Set

__all__ = ["_plain_module_line", "_plain_section"]



def _escape(value: Any) -> Any:
    import html
    return html.escape(str(value), quote=False)


def _command_line(prefix: Any, commands: Any) -> Any:
    if not commands:
        return ""
    return " ( " + " | ".join(
        f"<code>{_escape(prefix)}{_escape(command)}</code>"
        for command in commands
    ) + " )"


def _module_line(runtime: Any, module_id: Any, manifest: Any, kernel: Any) -> Any:
    prefix = runtime.config.prefix
    marker = "4974681956907221809" if kernel else "4974508259839836856"
    name = f'<tg-emoji emoji-id="{marker}">▪️</tg-emoji> <code>{_escape(module_id)}</code>'
    commands = _command_line(prefix, manifest.commands)
    description = manifest.localized(runtime.language(), manifest.description).get("description", "")
    suffix = f"<br><i>{_escape(description)}</i>" if description else ""
    return f"<p>{suffix[4:] + '<br>' if suffix else ''}{name}{commands}</p>"


def _plain_module_line(runtime: Any, module_id: Any, manifest: Any) -> Any:
    commands = _command_line(runtime.config.prefix, manifest.commands)
    description = manifest.localized(runtime.language(), manifest.description).get("description", "")
    suffix = f"<br><i>{_escape(description)}</i>" if description else ""
    return f"{suffix[4:] + '<br>' if suffix else ''}<code>{_escape(module_id)}</code>{commands}"


def _plain_section(lines: Any) -> Any:
    if not lines:
        return ""
    return f"<blockquote>{'<br>'.join(lines)}</blockquote>"


async def command_hlp(ctx: Any, invocation: Any) -> Any:
    await _show_help(ctx, invocation)


async def command_help(ctx: Any, invocation: Any) -> Any:
    await _show_help(ctx, invocation)


async def _show_help(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond("<b>Runtime unavailable</b>", parse_mode="HTML")
        return

    if invocation.args:
        if len(invocation.args) != 1:
            await ctx.respond(
                "<b>Usage:</b> <code>.hlp</code> or <code>.hlp &lt;module-id&gt;</code>",
                parse_mode="HTML",
            )
            return
        if runtime.modules is None:
            await ctx.respond("<b>Module manager unavailable</b>", parse_mode="HTML")
            return

        module_id = invocation.args[0].casefold()
        active = runtime.modules.get(module_id)
        if active is None:
            if runtime.state is not None and module_id in runtime.state.module_ids():
                last_error = runtime.state.namespace(module_id).get("lasterror", "none")
                await ctx.respond(
                    f'<b>Module disabled:</b> <code>{_escape(module_id)}</code><br>'
                    f"<i>Error: {_escape(last_error)}</i>",
                    parse_mode="HTML",
                )
            else:
                await ctx.respond(
                    f'<b>Module not active:</b> <code>{_escape(module_id)}</code>',
                    parse_mode="HTML",
                )
            return

        manifest = active.loaded.manifest
        localized = manifest.localized(runtime.language(), manifest.description)
        description = localized.get("description", manifest.description)
        _commands = _command_line(runtime.config.prefix, manifest.commands)
        capabilities = ", ".join(_escape(ctx.t(f"kernel.capabilities.{item}", item)) for item in manifest.capabilities) or "none"
        text = (
            f'<b>{_escape(manifest.module_id)}</b> <i>v{_escape(manifest.version)}</i>'
        )
        if description:
            text += f"<br><i>{_escape(description)}</i>"
        command_lines: List[str] = []
        for command in manifest.commands:
            details = manifest.command_details(command, runtime.language())
            command_description = details.get("description", "")
            line = f"<code>{_escape(runtime.config.prefix)}{_escape(command)}</code>"
            if command_description:
                line += f" — {_escape(command_description)}"
            command_lines.append(line)
        cmd_title = _escape(ctx.t("kernel.help_ui.commands", "Commands"))
        cap_title = _escape(ctx.t("kernel.help_ui.capabilities", "Capabilities"))
        text += f"<details><summary>{cmd_title}</summary><p>{'<br>'.join(command_lines) or 'none'}</p></details>"
        text += f"<details><summary>{cap_title}</summary><p>{capabilities}</p></details>"
        await ctx.respond(text, parse_mode="HTML", rich=True, rich_fallback="bot")
        return

    kernel_modules: List[str] = []
    user_modules: List[str] = []

    if runtime.modules is not None:
        active = {item.loaded.manifest.module_id: item for item in runtime.modules.items()}
        known: Set[str] = set(runtime.state.module_ids()) if runtime.state is not None else set()

        for module_id in sorted(set(active.keys()) | known, key=str.casefold):
            if module_id in active:
                item = active[module_id]
                manifest = item.loaded.manifest
                is_kernel = (
                    module_id in runtime.modules._bindings
                    and runtime.modules._bindings[module_id][2]
                )
                line = _module_line(runtime, module_id, manifest, is_kernel)
                if is_kernel:
                    kernel_modules.append(line)
                else:
                    user_modules.append(line)
            else:
                user_modules.append(
                    f'<p><tg-emoji emoji-id="5404553572727660202">❌</tg-emoji> '
                    f'<code>{_escape(module_id)}</code> <i>({_escape(ctx.t("kernel.help_ui.untrusted", "not loaded"))})</i></p>'
                )
    else:
        for name in sorted(runtime.kernel.registry.names(), key=str.casefold):
            user_modules.append(
                f'<p><tg-emoji emoji-id="4974508259839836856">▪️</tg-emoji> '
                f'<code>{_escape(runtime.config.prefix)}{_escape(name)}</code></p>'
            )

    total = len(kernel_modules) + len(user_modules)
    title = _escape(ctx.t("kernel.help_ui.module_count", "Hotaru Help · {count} modules", count=total))
    kernel_title = _escape(ctx.t("kernel.help_ui.kernel_modules", "Kernel Modules"))
    user_title = _escape(ctx.t("kernel.help_ui.user_modules", "User Modules"))
    text = f"<b>{title}</b>"

    if kernel_modules:
        text += (
            f"<details><summary>{kernel_title} ({len(kernel_modules)})</summary>"
            + "".join(kernel_modules)
            + "</details>"
        )
    if user_modules:
        text += (
            f"<details><summary>{user_title} ({len(user_modules)})</summary>"
            + "".join(user_modules)
            + "</details>"
        )

    await ctx.respond(text=text, parse_mode="HTML", rich=True, rich_fallback="bot")
