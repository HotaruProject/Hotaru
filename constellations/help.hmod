HOTARU = {
    "id": "help",
    "version": "2.0.0",
    "commands": ["hlp", "help"],
    "capabilities": ["mt"],
}

from typing import Any, Callable, List, Tuple

PAGE = 15
COPY_LIMIT = 4


def _escape(value: Any) -> str:
    import html
    return html.escape(str(value), quote=False)


def _description(runtime: Any, manifest: Any) -> str:
    return str(manifest.localized(runtime.language(), manifest.description).get("description", "") or "")


def _is_kernel(runtime: Any, module_id: str) -> bool:
    bindings = getattr(runtime.modules, "_bindings", {})
    return module_id in bindings and bool(bindings[module_id][2])


def _catalog(runtime: Any) -> List[Tuple[str, Any, bool]]:
    """Kernel modules first, then installed ones, each sorted by id."""
    items = [(item.loaded.manifest.module_id, item.loaded.manifest) for item in runtime.modules.items()]
    rows = [(module_id, manifest, _is_kernel(runtime, module_id)) for module_id, manifest in items]
    return sorted(rows, key=lambda row: (not row[2], row[0].casefold()))


def _line(ctx: Any, module_id: str, manifest: Any) -> str:
    prefix = ctx.runtime.config.prefix
    commands = " ".join(f"<code>{_escape(prefix)}{_escape(name)}</code>" for name in manifest.commands[:3])
    if len(manifest.commands) > 3:
        commands += f" +{len(manifest.commands) - 3}"
    description = _description(ctx.runtime, manifest)
    line = f"<b>{_escape(module_id)}</b>"
    if description:
        line += f" — {_escape(description)}"
    return line + (f"\n{commands}" if commands else "")


def home(ctx: Any, nav: Any = None) -> Any:
    k = ctx.screens
    runtime = ctx.runtime
    catalog = _catalog(runtime)
    items, page, pages = k.page(catalog, nav.int("page") if nav is not None else 0, PAGE)
    lines = [
        f"<b>{_escape(ctx.t('kernel.help_ui.title'))}</b>",
        ctx.t("kernel.help_ui.summary", count=len(catalog), prefix=_escape(runtime.config.prefix)),
    ]
    section = None
    for module_id, manifest, kernel in items:
        if kernel != section:
            section = kernel
            title = ctx.t("kernel.help_ui.kernel_modules" if kernel else "kernel.help_ui.user_modules")
            lines.append(f"\n<b>{_escape(title)}</b>")
        lines.append(_line(ctx, module_id, manifest))
    lines.append(f"\n<i>{_escape(ctx.t('kernel.help_ui.pick'))}</i>")
    buttons = [k.button(module_id, module, id=module_id, page=page) for module_id, _, _ in items]
    rows = k.grid(buttons, 3)
    rows.append(k.pager(home, page, pages))
    rows.append([k.input(ctx.t("ui.search"), search, ctx.t("kernel.help_ui.search_prompt")), k.close()])
    return k.screen("\n".join(lines), rows)


def _card(ctx: Any, module_id: str, actor: Any, back: Any, **back_args: Any) -> Any:
    k = ctx.screens
    runtime = ctx.runtime
    active = runtime.modules.get(module_id)
    if active is None:
        return home(ctx).with_notice(ctx.t("ui.error", error=ctx.t("kernel.help_ui.missing", module=_escape(module_id))))
    manifest = active.loaded.manifest
    prefix = runtime.config.prefix
    badge = ctx.t("kernel.help_ui.kernel_badge" if _is_kernel(runtime, module_id) else "kernel.help_ui.user_badge")
    lines = [f"<b>{_escape(module_id)}</b> <i>v{_escape(manifest.version)} · {_escape(badge)}</i>"]
    description = _description(runtime, manifest)
    if description:
        lines.append(f"<i>{_escape(description)}</i>")
    commands: List[str] = []
    for command in manifest.commands:
        details = manifest.command_details(command, runtime.language())
        line = f"<code>{_escape(prefix)}{_escape(command)}</code>"
        usage = details.get("usage", "")
        if usage and usage != f"{prefix}{command}":
            line = f"<code>{_escape(usage)}</code>"
        if details.get("description"):
            line += f" — {_escape(details['description'])}"
        commands.append(line)
    title = _escape(ctx.t("kernel.help_ui.commands"))
    body = "\n".join(commands) or _escape(ctx.t("kernel.help_ui.no_commands"))
    lines.append(f"\n<b>{title}</b>\n" + (f"<blockquote expandable>{body}</blockquote>" if len(commands) > 6 else body))
    if manifest.capabilities:
        capabilities = ", ".join(_escape(ctx.t(f"kernel.capabilities.{item}", item)) for item in manifest.capabilities)
        lines.append(f"<blockquote expandable><b>{_escape(ctx.t('kernel.help_ui.capabilities'))}</b>\n{capabilities}</blockquote>")
    rows: List[List[Any]] = []
    if 0 < len(manifest.commands) <= COPY_LIMIT:
        rows.append([k.copy(f"⧉ {prefix}{command}", f"{prefix}{command}") for command in manifest.commands])
    if getattr(manifest, "config_schema", None) and runtime.modules.get("config") is not None and runtime.access.is_owner(actor):
        rows.append([k.link(ctx.t("kernel.help_ui.settings"), "config", "module", style="primary", id=module_id, origin="help")])
    rows.append(k.footer(back, **back_args))
    return k.screen("\n".join(lines), rows)


def module(ctx: Any, nav: Any) -> Any:
    return _card(ctx, str(nav.arg("id")), nav.actor, home, page=nav.int("page"))


def _matches(ctx: Any, query: str) -> Any:
    key: Callable[[Tuple[str, Any, bool]], List[object]] = lambda row: [row[0], _description(ctx.runtime, row[1]), *row[1].commands]
    return ctx.tools.search(_catalog(ctx.runtime), query, key=key, limit=12)


async def search(ctx: Any, nav: Any) -> Any:
    query = str(nav.value or nav.arg("q") or "").strip()
    k = ctx.screens
    hits: List[Any] = await _matches(ctx, query) if query else []
    if len(hits) == 1:
        return _card(ctx, hits[0]["value"][0], nav.actor, search, q=query)
    if not hits:
        return home(ctx).with_notice(ctx.t("ui.nothing_found", query=_escape(query)))
    lines = [f"<b>{_escape(ctx.t('kernel.help_ui.results', query=query))}</b>", ""]
    lines += [_line(ctx, hit["value"][0], hit["value"][1]) for hit in hits]
    rows = k.grid([k.button(hit["value"][0], found, id=hit["value"][0], q=query) for hit in hits], 3)
    rows.append([k.input(ctx.t("ui.search"), search, ctx.t("kernel.help_ui.search_prompt"))])
    rows.append(k.footer(home))
    return k.screen("\n".join(lines), rows)


def found(ctx: Any, nav: Any) -> Any:
    return _card(ctx, str(nav.arg("id")), nav.actor, search, q=nav.arg("q"))


async def _show_help(ctx: Any, invocation: Any) -> Any:
    runtime = ctx.runtime
    if runtime is None:
        await ctx.respond(ctx.t('kernel.help_ui.unavailable'), parse_mode="HTML")
        return
    if runtime.modules is None:
        await ctx.respond(ctx.t('kernel.help_ui.manager_unavailable'), parse_mode="HTML")
        return
    if not invocation.args:
        await ctx.screens.show(home(ctx))
        return
    query = " ".join(invocation.args).casefold()
    actor = getattr(invocation.message, "from_id", None)
    if runtime.modules.get(query) is not None:
        await ctx.screens.show(_card(ctx, query, actor, home))
        return
    hits = await _matches(ctx, query)
    if hits:
        await ctx.screens.show(_card(ctx, hits[0]["value"][0], actor, home))
        return
    if runtime.state is not None and query in runtime.state.module_ids():
        last_error = runtime.state.namespace(query).get("lasterror", ctx.t("common.none"))
        await ctx.respond(ctx.t('kernel.help_ui.disabled', module=_escape(query), error=_escape(last_error)), parse_mode="HTML")
        return
    await ctx.respond(ctx.t('kernel.help_ui.missing', module=_escape(query)), parse_mode="HTML")


async def command_hlp(ctx: Any, invocation: Any) -> Any:
    await _show_help(ctx, invocation)


async def command_help(ctx: Any, invocation: Any) -> Any:
    await _show_help(ctx, invocation)
